<Layout title="Privacy Policy & Terms and Conditions | Kylie Kelly" description="Privacy policy and terms and conditions for kyliekelly.com">
  <section class="px-6 py-16 sm:py-24">
    <div class="max-w-2xl mx-auto">
      <p class="text-pink text-xs uppercase tracking-widest font-semibold mb-3">The fine print</p>
      <h1 class="text-3xl sm:text-4xl font-bold mb-4">Privacy Policy &amp; Terms and Conditions</h1>
      <p class="text-sm text-black/70 mb-8">Last updated: 26 October 2026</p>
      <p class="text-black mb-8">
        By using this website, you agree to the following Terms and Conditions and Privacy Policy. Please read them carefully before using this website.
      </p>

      <nav class="flex flex-wrap gap-3 mb-14 text-sm font-semibold" aria-label="On this page">
        <a href="#terms" class="rounded-full bg-offwhite px-5 py-2.5 hover:text-pink transition-colors">Terms and Conditions</a>
        <a href="#disclaimer" class="rounded-full bg-offwhite px-5 py-2.5 hover:text-pink transition-colors">Disclaimers</a>
        <a href="#privacy" class="rounded-full bg-offwhite px-5 py-2.5 hover:text-pink transition-colors">Privacy Policy</a>
      </nav>

      <h2 id="terms" class="font-serif text-3xl font-bold mb-2 scroll-mt-24">Terms and Conditions</h2>
      {terms.map((s) => (
        <section id={s.id} class="scroll-mt-24">
          <h3 class="font-serif text-xl font-bold mt-10 mb-3">{s.title}</h3>
          {s.blocks.map((b) =>
            typeof b === 'string' ? (
              <p class="text-black leading-relaxed mb-4">{b}</p>
            ) : 'lead' in b ? (
              <p class="text-black leading-relaxed mb-4"><strong>{b.lead}:</strong> {b.text}</p>
            ) : (
              <ul class="list-disc pl-6 space-y-2 mb-4 text-black leading-relaxed">{b.list.map((li) => <li>{li}</li>)}</ul>
            )
          )}
        </section>
      ))}

      <h2 id="privacy" class="font-serif text-3xl font-bold mt-20 mb-4 scroll-mt-24">Privacy Policy</h2>
      {privacyIntro.map((p) => <p class="text-black leading-relaxed mb-4">{p}</p>)}
      {privacy.map((s) => (
        <section id={s.id} class="scroll-mt-24">
          <h3 class="font-serif text-xl font-bold mt-10 mb-3">{s.title}</h3>
          {s.blocks.map((b) =>
            typeof b === 'string' ? (
              <p class="text-black leading-relaxed mb-4">{b}</p>
            ) : 'lead' in b ? (
              <p class="text-black leading-relaxed mb-4"><strong>{b.lead}:</strong> {b.text}</p>
            ) : (
              <ul class="list-disc pl-6 space-y-2 mb-4 text-black leading-relaxed">{b.list.map((li) => <li>{li}</li>)}</ul>
            )
          )}
        </section>
      ))}
    </div>
  </section>
</Layout>
