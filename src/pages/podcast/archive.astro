---
import Layout from '../../layouts/Layout.astro';
import allPosts from '../../data/blog-posts.json';

const featuredSlugs = new Set([
  'low-lift-email-list-growth',
  'claude-claude-code-chrome-extension-delegate',
  'plan-rest-of-year-without-burning-out',
]);

function extractEpisodeNumber(post) {
  const match = post.content.match(/EPISODE\s+(\d+)/i) || post.title.match(/\[?Ep\.?\s*#?(\d+)\]?/i) || post.content.match(/\[?Ep\.?\s*#?(\d+)\]?/i);
  return match ? match[1] : null;
}

const archivePosts = allPosts
  .filter((p) => !featuredSlugs.has(p.slug))
  .map((p) => ({
    num: extractEpisodeNumber(p),
    title: p.title,
    date: new Date(p.date).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' }),
    href: `/${p.slug}/`,
  }));

const episodes = [
  {
    num: '265',
    meta: 'Solo Episode · 26 Min Listen · 4 Min Read',
    title: "The Low-Lift Way I'm Growing My List Right Now",
    desc: "Back in 2022, tiny audio pop-up events grew my list by 100–150 people at a time. I brought them back this year, small and low-lift, one a month. Here's what actually happened with the first one, including the $97 offer that sold exactly once.",
    href: '/podcast/episodes/low-lift-email-list-growth/',
  },
  {
    num: '264',
    meta: 'With Anita Mack · 28 Min Listen · 5 Min Read',
    title: 'Claude, Claude Code, and the Chrome Extension: How to Actually Delegate to Claude',
    desc: 'My biz bestie Anita Mack breaks down Claude.ai vs Claude Code vs the Chrome extension, the "human-AI sandwich," and how she built a full sales page with Claude in under two hours.',
    href: '/podcast/episodes/claude-claude-code-chrome-extension-delegate/',
  },
  {
    num: '260',
    meta: 'With Katherine Mackenzie-Smith',
    title: 'How to Plan the Rest of Your Year Without Burning Out',
    desc: "Katherine Mackenzie-Smith on why copying someone else's business system rarely works, how to review the first half of your year before planning the second, and why a 90-day plan beats a 12-month one.",
    href: '/podcast/episodes/plan-rest-of-year-without-burning-out/',
  },
];
---
<Layout title="Episode Library | The Email Growth Show | Kylie Kelly" description="Every episode of The Email Growth Show, newest first, with full show notes one click away.">

  <section class="bg-pink-light px-6 py-4">
    <p class="max-w-4xl mx-auto flex items-center justify-center gap-4 text-xs sm:text-sm font-normal uppercase tracking-widest text-black text-center">
      <span class="hidden sm:block h-px flex-1 bg-black/30"></span>
      Wife. Mom of two boys. Founder of Kylie Kelly. Host of The Email Growth Show.
      <span class="hidden sm:block h-px flex-1 bg-black/30"></span>
    </p>
  </section>

  <section class="bg-offwhite px-6 py-16 text-center">
    <p class="text-pink text-xs uppercase tracking-widest font-semibold mb-4">Episode Library</p>
    <h1 class="text-3xl sm:text-4xl font-bold mb-4">Every episode. Every show note. One place.</h1>
    <p class="text-muted max-w-md mx-auto mb-6">Looking for a past episode? Newest first, full show notes one click away.</p>
    <a href="/podcast" class="text-sm font-semibold underline underline-offset-2 hover:text-pink">← Back to the podcast home</a>
  </section>

  <section class="px-6 py-16">
    <div class="max-w-3xl mx-auto">
      {episodes.map((ep) => (
        <div class="grid sm:grid-cols-[90px_1fr] gap-6 py-8 border-b border-warmgray/40 first:pt-0">
          <p class="font-serif italic text-3xl text-pink">{ep.num}</p>
          <div>
            <p class="text-xs uppercase tracking-widest font-semibold text-muted mb-2">{ep.meta}</p>
            <h3 class="text-xl font-bold mb-3">{ep.title}</h3>
            <p class="text-black text-sm mb-4 max-w-xl">{ep.desc}</p>
            <a href={ep.href} class="text-sm font-semibold underline underline-offset-2 hover:text-pink">Read the show notes →</a>
          </div>
        </div>
      ))}

      <div class="bg-offwhite rounded-lg p-8 text-center mt-10 mb-16">
        <p class="text-muted">New episodes every Friday. This library grows every week, come back for more.</p>
      </div>

      <h2 class="text-2xl font-bold text-center mb-10">The Full Archive</h2>
    </div>
  </section>

  <section class="bg-black text-white px-6 py-16">
    <div class="max-w-5xl mx-auto">
      <div id="archive-grid" class="grid sm:grid-cols-2">
        {archivePosts.map((p, i) => (
          <a href={p.href} class="archive-item flex gap-5 py-7 sm:px-6 border-b border-white/15 hover:opacity-70 transition-opacity" data-index={i}>
            <span class="font-serif italic text-pink text-3xl shrink-0 w-10">{p.num ?? '—'}</span>
            <span>
              <span class="block font-semibold leading-snug mb-2">{p.title}</span>
              <span class="block text-xs uppercase tracking-widest text-warmgray">{p.date}</span>
            </span>
          </a>
        ))}
      </div>
      <div class="text-center mt-12">
        <button id="load-more-btn" class="btn-pink">See More Episodes →</button>
      </div>
    </div>
  </section>

  <style>
    .archive-item.hidden { display: none; }
  </style>

  <script>
    const PAGE_SIZE = 20;
    const items = Array.from(document.querySelectorAll('.archive-item'));
    const btn = document.getElementById('load-more-btn');
    let shown = 0;

    function showNext() {
      items.slice(shown, shown + PAGE_SIZE).forEach((el) => el.classList.remove('hidden'));
      shown += PAGE_SIZE;
      if (shown >= items.length && btn) btn.style.display = 'none';
    }

    items.forEach((el) => el.classList.add('hidden'));
    showNext();
    btn?.addEventListener('click', showNext);
  </script>

</Layout>
