---
// Episode library: every episode as a cover card, newest first.
// Episodes come from the Buzzsprout feed at build time (see src/lib/episodes.ts), so a new episode
// appears here by itself. Each card's photo is a guest headshot when one has been added
// (src/assets/guest-photos), otherwise one of Kylie's photos.
import Layout from '../../layouts/Layout.astro';
import EpisodeArt from '../../components/EpisodeArt.astro';
import { getEpisodes } from '../../lib/episodes';

const episodes = await getEpisodes();
// Same figure the podcast page shows: the newest episode's number.
const episodeCount = episodes.length ? Number(episodes[0].num) : 0;
const playTint = ['bg-pink text-white', 'bg-black text-white', 'bg-pink-light text-black'];
const playIcon = 'M5 3.5v9l7.5-4.5z';
const minsLabel = (ep: { mins: string | null }) => (ep.mins ? `${ep.mins} min listen` : '');
---
<Layout title="Episode Library | The Email Growth Show | Kylie Kelly" description="Every episode of The Email Growth Show, newest first, with full show notes one click away.">

  <section class="bg-black text-white px-6 py-4">
    <p class="max-w-4xl mx-auto flex items-center justify-center gap-4 text-xs sm:text-sm font-normal uppercase tracking-widest text-center">
      <span class="hidden sm:block h-px flex-1 bg-white/30"></span>
      The Email Growth Show &middot; Episode library
      <span class="hidden sm:block h-px flex-1 bg-white/30"></span>
    </p>
  </section>

  <section class="bg-offwhite px-6 pt-14 pb-12 sm:pt-20 sm:pb-16 text-center">
    <div class="max-w-2xl mx-auto">
      <p class="text-pink text-xs uppercase tracking-widest font-semibold mb-4">Episode Library</p>
      <h1 class="font-serif font-bold text-4xl sm:text-6xl leading-[1.08] text-balance mb-5">
        Every episode. Every show note. <span class="script-accent italic text-pink">One place.</span>
      </h1>
      <p class="text-black max-w-md mx-auto mb-8">
        {episodeCount} episodes, newest first, with the show notes one click away. A new one lands every Friday.
      </p>
      <label class="sr-only" for="archive-search">Search episodes</label>
      <input id="archive-search" type="search" placeholder="Search episodes by title or number" autocomplete="off" class="w-full max-w-md rounded-full bg-white px-6 py-4 text-[15px] text-black placeholder:text-black/55 shadow-[0_6px_24px_rgba(0,0,0,0.04)] border border-transparent focus:outline-none focus:border-pink focus:ring-1 focus:ring-pink" />
      <p class="mt-6"><a href="/podcast" class="text-sm font-semibold underline underline-offset-4 hover:text-pink">&larr; Back to the podcast home</a></p>
    </div>
  </section>

  <section class="bg-white px-6 py-14 sm:py-20">
    <div class="max-w-5xl mx-auto">
      <div id="archive-grid" class="grid grid-cols-1 gap-x-6 gap-y-12 sm:grid-cols-2 lg:grid-cols-3">
        {episodes.map((ep, i) => (
          <a href={ep.href} class="archive-card group block" data-title={`${ep.num} ${ep.title}`.toLowerCase()} {...(ep.href.startsWith('http') ? { target: '_blank', rel: 'noopener' } : {})}>
            <EpisodeArt num={ep.num} title={ep.title} class="transition-transform duration-300 group-hover:-translate-y-1.5" />
            <div class="mt-5 flex items-center justify-between gap-3 px-1">
              <span class="text-[11px] uppercase tracking-widest font-semibold text-black/70">{ep.date}{ep.mins ? ` · ${minsLabel(ep)}` : ''}</span>
              <span class={`grid place-items-center h-10 w-10 flex-none rounded-full transition-transform duration-300 group-hover:scale-110 ${playTint[i % playTint.length]}`} aria-hidden="true"><svg viewBox="0 0 16 16" class="h-4 w-4" fill="currentColor"><path d={playIcon} /></svg></span>
            </div>
          </a>
        ))}
      </div>

      <p id="archive-empty" class="hidden text-center text-black py-10">No episodes match that search. Try a different word or an episode number.</p>

      <div class="text-center mt-14">
        <button id="load-more-btn" type="button" class="btn-pink">See more episodes &rarr;</button>
      </div>
    </div>
  </section>

  <style>
    .archive-card.is-hidden { display: none; }
  </style>

  <script>
    const PAGE_SIZE = 12;
    const cards = Array.from(document.querySelectorAll<HTMLElement>('.archive-card'));
    const btn = document.getElementById('load-more-btn');
    const search = document.getElementById('archive-search') as HTMLInputElement | null;
    const empty = document.getElementById('archive-empty');
    let shown = 0;

    function render() {
      const q = (search?.value ?? '').trim().toLowerCase();
      if (q) {
        // Searching looks through every episode, not just the ones already shown.
        let matches = 0;
        cards.forEach((c) => {
          const hit = (c.dataset.title ?? '').includes(q);
          c.classList.toggle('is-hidden', !hit);
          if (hit) matches++;
        });
        empty?.classList.toggle('hidden', matches > 0);
        if (btn) btn.style.display = 'none';
        return;
      }
      empty?.classList.add('hidden');
      cards.forEach((c, i) => c.classList.toggle('is-hidden', i >= shown));
      if (btn) btn.style.display = shown >= cards.length ? 'none' : '';
    }

    function showMore() {
      shown = Math.min(shown + PAGE_SIZE, cards.length);
      render();
    }

    showMore();
    btn?.addEventListener('click', showMore);
    search?.addEventListener('input', render);
  </script>

</Layout>
