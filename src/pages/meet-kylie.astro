---
import Layout from '../layouts/Layout.astro';
import Highlight from '../components/Highlight.astro';
import EpisodeArt from '../components/EpisodeArt.astro';
import { getEpisodes } from '../lib/episodes';

const timeline = [
  { label: '10+ years', photo: '/images/about/t1-wedding.jpg', alt: 'Kylie with a groom and a bride in a lace gown holding a bouquet, at one of her wedding shoots', text: "I was an international wedding photographer. I loved the work. I did not love the feast and famine that came with it, through the highs and lows of the wedding seasons." },
  { label: '2020', photo: '/images/about/t2-family-2020.jpg', alt: 'Kylie, her husband Nick and their two little boys squeezed into a family selfie', text: "Two kids under two and a global pause I did not see coming. After refunding two years' worth of wedding bookings and almost going bankrupt because of it, I hung up my straps. I knew I didn't want to build a business that depended on being online every single day, but I had no idea what that looked like. So I did what everyone does. Started a new Instagram account. Build it and they will come... right?!" },
  { label: 'The moment', photo: '/images/about/t3-moment.jpg', alt: 'Kylie at her desk with her hand on her cheek, looking quietly unimpressed', text: "Wrong. After months of daily Instagram posts and a beautifully curated grid (A+ for effort), I sat down and looked at how many people were actually clicking through to my new website. Almost none. All that effort, and nothing to show for it. Not sales. Not clients. Not even clicks. <strong>That was the moment I stopped chasing the algorithm</strong> and knew I had to find a better way." },
  { label: '18 months later', photo: '/images/about/t4-poolside.jpg', alt: 'Kylie in sunglasses and a floral top, relaxed and smiling', text: "0 to 7,000+ email subscribers, without social media. Just email, collaborations, and relationships that actually work, and six figures in revenue coming in." },
  { label: 'Since then', photo: '/images/about/t5-podcast-era.jpg', alt: 'Kylie in glasses in the recording studio', text: "I started The Email Growth Show (now a top 1.5% podcast globally), built Email Marketing Skool (1,400+ women and counting), and helped hundreds of women grow their own lists the same simple way." },
  { label: 'Right now', photo: '/images/about/t6-boys.jpg', alt: 'Kylie laughing with her two boys on her lap', text: "I'm building toward a business that can help thousands of women whether I'm online that day or not. Fewer hours on calls. More simple tools that keep working after I've done the school run, available in my digital shop that's open 24/7. My driving forces: <strong>FREEDOM + IMPACT.</strong>" },
];
const tilt = [-3, 2.5, -2, 3, -2.5, 2];

// "A few of the things I answer to": photo lives in public/images/about/<file>. No file yet = a placeholder tile.
const answerTo = [
  { label: 'Mummy', photo: '/images/about/mama.jpg', text: 'Mum to Spencer and Sammy, and the reason school pickup never moves.' },
  { label: 'Podcast Host', photo: '/images/about/podcast-mic.jpg', text: 'Host of The Email Growth Show, a top 1.5% podcast globally, with a new episode every Friday.' },
  { label: 'Email Nerd', photo: null, text: 'I check my email stats the way other people check the weather.' },
  { label: 'Babe', photo: '/images/about/babe-wedding.jpg', text: 'Wife to Nick.' },
];

// The quiz. `pick` = the options (by position) that get circled; `answer` = a handwritten answer instead.
const quiz = [
  { q: 'The best title I have:', opts: ['Female Founder', 'Clean Freak', 'Podcast Host', 'Email Nerd', 'Other: Mummy'], pick: [4] },
  { q: 'My drink of choice is:', opts: ['Black coffee', 'Matcha', 'English Breakfast tea', 'Oat milk latte'], pick: [2, 3], note: 'Tea within five minutes of waking, latte before lunch. Non negotiable.' },
  { q: 'Most likely to binge watch:', opts: ['The Bachelor', 'The Office', 'Love Is Blind', 'True Crime Documentary'], pick: [2], note: "Don't judge me." },
  { q: 'Deathly afraid of:', opts: ['Spiders', 'Public Speaking', 'Heights', 'Clowns'], pick: [2], note: 'A mountaintop is fine. A cable car? Absolutely not.' },
  { q: 'My favourite flowers:', answer: 'Pink dahlias.' },
  { q: 'My favourite food:', answer: 'Thai green curry. Spicy, please.' },
  { q: 'My current obsession:', answer: 'Cold plunging and breathwork.' },
  { q: 'The first thing I check each morning:', opts: ['Instagram', 'The weather', 'Overnight sales', 'My email inbox'], pick: [2] },
  { q: "At school pickup I'm usually:", opts: ['Early', 'On time', 'Slightly late', 'Unsure what day it is'], pick: [3] },
  { q: 'Someday I want to:', answer: "Ride in a hot air balloon. (Yes, even though I'm scared of heights!)" },
];

const paths = [
  {
    num: '01',
    photo: '/images/hero-8.jpg',
    title: 'Start for free.',
    text: 'Join Email Marketing Skool for a simple 90-day growth plan, the Email Marketing Starter Kit, and a free community of 1,400+ women doing the same work.',
    cta: 'Start My Free Growth Plan →',
    href: 'https://www.skool.com/email-marketing-skool/about',
  },
  {
    num: '02',
    photo: '/images/shop-mockup.jpg',
    title: 'Grab what you need.',
    text: 'Browse the KK Digital Product Shop for grab-and-go courses, templates and trainings for growing your list without social media.',
    cta: 'Help Me Grow My Email List →',
    href: 'https://shop.kyliekelly.com/',
  },
  {
    num: '03',
    photo: '/images/kylie-podcast.jpg',
    title: 'Get my brain in your corner.',
    text: 'Join the Coaching Group for weekly voice-note coaching on the real questions: offer clarity, launch strategy, what to prioritise when everything feels urgent.',
    cta: 'Get Weekly Support & Answers →',
    href: '/services',
  },
];
const latest = (await getEpisodes()).slice(0, 3);
const playIcon = 'M5 3.5v9l7.5-4.5z';
const arrowIcon = 'M4 12L12 4M5.5 4H12v6.5';
---
<Layout title="Meet Kylie Kelly | Email Marketing Educator & Podcast Host" description="From burnt-out wedding photographer to a multi six-figure business built entirely on email. Meet Kylie Kelly, host of The Email Growth Show.">

  <link slot="head" rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Nothing+You+Could+Do&display=swap" />

  <!-- HERO: the big word, the arch, and the page slides over it as you scroll (large screens) -->
  <section id="about-hero" class="relative isolate overflow-hidden bg-black text-white lg:sticky lg:top-0 lg:h-[880px]">
    <div id="hero-inner" class="relative flex h-full flex-col px-6 pb-20 pt-24 lg:block lg:p-0">
      <div class="pointer-events-none absolute inset-x-0 top-[3.5%] z-0 select-none whitespace-nowrap text-center font-serif text-[14.5vw] leading-none text-pink sm:text-[15vw] lg:hidden" aria-hidden="true">MEET KYLIE</div>
      <div class="pointer-events-none absolute inset-x-0 top-[14%] z-0 hidden select-none items-start font-serif leading-none text-pink lg:grid" style="grid-template-columns:1fr var(--arch) 1fr;--arch:min(38vw,540px);font-size:min(9.6vw,148px)" aria-hidden="true">
        <span class="justify-self-end" style="margin-right:0.2em">MEET</span><span></span><span class="justify-self-start" style="margin-left:0.2em">KYLIE</span>
      </div>

      <div class="relative z-10 mx-auto mt-16 w-[80vw] max-w-[380px] lg:absolute lg:bottom-0 lg:left-1/2 lg:mt-0 lg:w-[min(38vw,540px)] lg:max-w-none lg:-translate-x-1/2">
        <img
          src="/images/about/kylie-disco.jpg"
          alt="Kylie Kelly sitting in an armchair in a lilac outfit, holding a disco ball up high and a glass of pink bubbles"
          class="block aspect-[2/3] w-full rounded-t-[999px] object-cover object-top"
          width="1400"
          height="2100"
          fetchpriority="high"
        />
      </div>

      <div class="relative z-10 mt-10 text-center lg:absolute lg:bottom-[12%] lg:left-[calc(50%+min(19vw,270px)+2.5vw)] lg:mt-0 lg:w-[min(24vw,340px)] lg:text-left">
        <p class="text-lg leading-relaxed text-white">Ex wedding photographer turned email nerd. Mum of two. Will talk you out of posting daily.</p>
        <div class="mt-7 flex flex-wrap justify-center gap-3 lg:justify-start">
          <a href="/services" class="btn-pink">See How I Can Help →</a>
          <a href="https://www.skool.com/email-marketing-skool/about" class="btn-outline !border-white text-white">Join The Free Community</a>
        </div>
      </div>
    </div>
  </section>

  <div class="relative z-10 -mt-8 overflow-hidden rounded-t-[2.5rem] bg-white lg:-mt-14 lg:rounded-t-[3.5rem]">

  <!-- AS FEATURED IN -->
  <section class="border-y border-black/10 bg-white px-6 py-10 lg:py-14">
    <p class="mb-8 text-center text-xs uppercase tracking-widest text-muted">As featured in:</p>
    <div class="mx-auto flex max-w-4xl flex-wrap items-center justify-center gap-x-14 gap-y-8 lg:max-w-6xl lg:gap-x-20">
      <a href="https://www.forbes.com/advisor/business/software/email-marketing-strategy/" target="_blank" rel="noopener">
        <img src="/images/press/forbes.png" alt="Forbes" class="h-10 w-auto opacity-80 transition-opacity hover:opacity-100 sm:h-12 lg:h-14 xl:h-16" />
      </a>
      <img src="/images/press/business-insider.jpg" alt="Business Insider" class="h-10 w-auto opacity-80 sm:h-12 lg:h-14 xl:h-16" />
      <a href="https://www.londondaily.news/why-six-figure-female-entrepreneurs-are-breaking-up-with-social-media-in-2025/" target="_blank" rel="noopener">
        <img src="/images/press/london-daily-news.png" alt="London Daily News" class="h-10 w-auto opacity-80 transition-opacity hover:opacity-100 sm:h-12 lg:h-14 xl:h-16" />
      </a>
      <a href="https://businessmondays.co.uk/independent-business-podcast-surpasses-200-episodes-40000-downloads-highlighting-the-power-of-sustainable-growth/" target="_blank" rel="noopener">
        <img src="/images/press/business-mondays.jpg" alt="Business Mondays" class="h-14 w-auto opacity-80 transition-opacity hover:opacity-100 sm:h-16 lg:h-20 xl:h-24" />
      </a>
    </div>
  </section>

  <!-- THE BIG STATEMENT -->
  <section class="px-6 py-20 sm:py-28">
    <div class="mx-auto max-w-5xl">
      <p class="mb-8 text-center text-sm font-semibold uppercase tracking-widest text-pink sm:text-base">A little about me</p>
      <h2 class="mx-auto max-w-4xl text-center font-sans text-3xl font-medium leading-snug text-balance sm:text-5xl sm:leading-snug">
        I spent ten years chasing wedding bookings, then a few more chasing likes for a business that wasn't paying the bills. And honestly? <Highlight>I'm done chasing anything now.</Highlight>
      </h2>
      <div class="mx-auto mt-14 grid max-w-4xl items-center gap-10 md:grid-cols-[1.1fr_0.9fr]">
        <div class="space-y-5 text-lg leading-relaxed">
          <p>These days I build audiences the slower, sturdier way. <strong class="uppercase tracking-wide">Email lists. Real relationships. Rooms worth being in.</strong> No algorithm required.</p>
          <p>Maybe you're posting (or not posting) and still wondering where your next client is coming from. Maybe your list has stalled, or it's growing and nobody's buying. I've asked myself every single one of those questions. More than once.</p>
          <p class="font-serif text-2xl font-bold italic leading-snug text-pink sm:text-3xl">Here's the short version of how I found some answers.</p>
        </div>
        <div class="relative mx-auto w-full max-w-xs">
          <img src="/images/about/laughing.jpg" alt="Kylie laughing, sitting on the floor in a printed tee and leopard skirt" class="aspect-[4/5] w-full rounded-[1.75rem] object-cover shadow-[0_24px_50px_rgba(0,0,0,0.15)]" loading="lazy" />
          <span class="absolute -bottom-4 -left-3 -rotate-3 rounded-full bg-pink px-4 py-2 text-[11px] font-semibold uppercase tracking-widest text-white shadow-lg sm:-left-6">Done chasing</span>
        </div>
      </div>
    </div>
  </section>

  <!-- ORIGIN / TIMELINE -->
  <section class="bg-black px-6 py-20 text-white sm:py-28">
    <div class="mx-auto max-w-5xl">
      <div class="mb-16 text-center sm:mb-20">
        <p class="mb-3 text-sm font-semibold uppercase tracking-widest text-pink sm:text-base">How it all unfolded</p>
        <h2 class="font-serif text-3xl font-normal italic sm:text-5xl">The short version of a very long story.</h2>
      </div>
      <div class="space-y-16 md:space-y-24">
        {timeline.map((t, i) => (
          <div class="grid items-center gap-8 md:grid-cols-2 md:gap-16">
            <div class={`flex justify-center ${i % 2 ? 'md:order-2' : ''}`}>
              <figure class="w-64 bg-white p-2.5 pb-11 shadow-2xl sm:w-72" style={`transform: rotate(${tilt[i]}deg)`}>
                <img src={t.photo} alt={t.alt} class="aspect-[4/5] w-full object-cover" loading="lazy" />
              </figure>
            </div>
            <div class={i % 2 ? 'md:order-1' : ''}>
              <p class="mb-3 text-sm font-semibold uppercase tracking-widest text-pink-light">{t.label}</p>
              <p class="timeline-text text-xl leading-relaxed text-white/90 sm:text-2xl sm:leading-relaxed" set:html={t.text} />
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- THINGS I ANSWER TO -->
  <section class="bg-white px-6 py-20 sm:py-28">
    <div class="mx-auto max-w-6xl">
      <div class="mb-14 text-center">
        <p class="mb-3 text-xs font-semibold uppercase tracking-widest text-pink">A few of the things I answer to</p>
        <h2 class="font-serif text-3xl font-bold italic sm:text-4xl">Titles I'm most proud of.</h2>
      </div>
      <div class="grid grid-cols-2 gap-x-5 gap-y-12 lg:grid-cols-4">
        {answerTo.map((a, i) => (
          <div class={i % 2 ? 'lg:mt-12' : ''}>
            <div class="relative">
              {a.photo ? (
                <img src={a.photo} alt={`Kylie Kelly: ${a.label}`} class="aspect-[4/5] w-full rounded-[1.5rem] object-cover" loading="lazy" />
              ) : (
                <div class="grid aspect-[4/5] w-full place-items-center rounded-[1.5rem] bg-[#e9d9ec] p-4 text-center">
                  <span class="font-serif text-xl italic text-black/50">photo coming</span>
                </div>
              )}
              <span class="absolute -left-2 top-5 rounded-full border border-black bg-white px-4 py-1.5 text-[11px] font-semibold uppercase tracking-widest sm:-left-3">{a.label}</span>
            </div>
            <p class="mt-4 text-sm leading-relaxed sm:text-base">{a.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- THE QUIZ (on lined paper) -->
  <section class="quiz-paper px-6 py-20 sm:py-28">
    <div class="mx-auto max-w-3xl">
      <div class="mb-14 text-center">
        <p class="mb-3 text-lg font-semibold uppercase tracking-widest text-pink sm:text-2xl">Quick-fire round</p>
        <h2 class="text-3xl font-bold sm:text-4xl">Oh yeah, we're doing this Cosmo girl style.</h2>
        <p class="mx-auto mt-4 max-w-xl text-black">Ten questions. No wrong answers (although a couple of mine are questionable).</p>
      </div>
      <div class="grid gap-x-16 gap-y-12 md:grid-cols-2">
        {quiz.map((item, n) => (
          <div>
            <p class="mb-4 text-xs font-semibold uppercase tracking-widest"><span class="mr-2 font-serif text-lg font-bold italic normal-case tracking-normal text-pink">{n + 1}.</span>{item.q}</p>
            {item.answer ? (
              <p class="hand write text-[1.9rem] leading-[1.2] sm:text-[2.2rem]">{item.answer}</p>
            ) : (
              <ul class="space-y-2 text-[17px]">
                {item.opts!.map((o, i) => (
                  <li class="flex items-center gap-3">
                    <span class="w-5 flex-none text-black/35">{'abcde'[i]}.</span>
                    {item.pick!.includes(i) ? (
                      <span class="circ relative inline-block px-3 py-0.5 font-semibold">
                        {o}
                        <svg class="pointer-events-none absolute left-[-6px] top-[-4px] h-[calc(100%+8px)] w-[calc(100%+12px)] overflow-visible" viewBox="0 0 200 50" preserveAspectRatio="none" aria-hidden="true"><path pathLength="1" d="M14 30 C 6 12, 58 3, 112 4 C 168 5, 199 15, 193 29 C 187 45, 140 48, 94 47 C 48 47, 4 41, 13 20" fill="none" stroke="#e040fb" stroke-width="2.4" stroke-linecap="round" vector-effect="non-scaling-stroke" /></svg>
                      </span>
                    ) : (
                      <span class="text-black/70">{o}</span>
                    )}
                  </li>
                ))}
              </ul>
            )}
            {item.note && <p class="hand write mt-3 text-[1.5rem] leading-snug text-pink sm:text-[1.7rem]">{item.note}</p>}
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- LATEST FROM THE PODCAST -->
  <section class="bg-white px-6 py-20">
    <div class="mx-auto max-w-5xl">
      <p class="mb-10 text-center text-base font-semibold uppercase tracking-[0.2em] sm:text-lg">Fresh off the podcast</p>
      <div class="grid gap-8 md:grid-cols-3">
        {latest.map((ep) => (
          <a href={ep.href} class="group block">
            <EpisodeArt num={ep.num} title={ep.title} guest={ep.guest} class="transition-transform duration-300 group-hover:-translate-y-1.5" />
            <div class="mt-4 flex items-center justify-between gap-3 px-1">
              <span class="text-[11px] font-semibold uppercase tracking-widest text-black/70">{ep.date}</span>
              <span class="grid h-9 w-9 flex-none place-items-center rounded-full bg-black text-white transition-transform duration-300 group-hover:scale-110" aria-hidden="true"><svg viewBox="0 0 16 16" class="h-4 w-4" fill="currentColor"><path d={playIcon} /></svg></span>
            </div>
          </a>
        ))}
      </div>
      <p class="mt-10 text-center"><a href="/podcast" class="font-semibold underline underline-offset-4 hover:text-pink">See every episode →</a></p>
    </div>
  </section>

  <!-- WHERE TO GO NEXT -->
  <section class="bg-offwhite px-6 py-24 sm:py-36">
    <div class="mx-auto max-w-6xl">
      <div class="mb-20 text-center">
        <p class="mb-3 text-xs font-semibold uppercase tracking-widest text-pink">Ways to keep going</p>
        <h2 class="text-3xl font-bold sm:text-4xl">Now that you know me, here's where to go next.</h2>
      </div>
      <div class="grid items-center gap-20 lg:grid-cols-[1.1fr_0.9fr] lg:gap-24">
        <div class="space-y-16">
          {paths.map((p) => (
            <a href={p.href} class="group flex items-center gap-7 sm:gap-9">
              <img src={p.photo} alt="" class="h-24 w-24 flex-none rounded-full object-cover sm:h-36 sm:w-36" loading="lazy" />
              <div>
                <h3 class="text-2xl font-bold sm:text-3xl">{p.title}</h3>
                <p class="mt-3 max-w-md text-base leading-7 text-black/80">{p.text}</p>
                <span class="mt-5 inline-block font-semibold underline underline-offset-4 group-hover:text-pink">{p.cta}</span>
              </div>
            </a>
          ))}
        </div>
        <div class="relative mx-auto w-full max-w-md">
          <img src="/images/classics-kylie.jpg" alt="Kylie Kelly in a sparkly jacket holding a microphone" class="aspect-[4/5] w-full rounded-[2rem] object-cover" loading="lazy" />
          <div class="absolute -right-3 bottom-6 flex flex-col gap-3 sm:-right-8">
            {[
              { label: 'Listen to the podcast', href: '/podcast', tint: 'bg-pink text-white', ext: false },
              { label: 'Watch on YouTube', href: 'https://www.youtube.com/@KylieKelly', tint: 'bg-black text-white', ext: true },
              { label: 'Visit the shop', href: 'https://shop.kyliekelly.com/', tint: 'bg-[#e9d9ec]', ext: true },
              { label: 'Find CoLab', href: 'https://findcolab.com/', tint: 'bg-[#e9d9ec]', ext: true },
            ].map((l) => (
              <a href={l.href} {...(l.ext ? { target: "_blank", rel: "noopener" } : {})} class="flex items-center justify-between gap-6 rounded-full bg-white py-2 pl-6 pr-2 text-[15px] font-semibold shadow-lg transition-transform duration-300 hover:-translate-y-0.5">
                {l.label}
                <span class={`grid h-9 w-9 place-items-center rounded-full ${l.tint}`}><svg viewBox="0 0 16 16" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={arrowIcon} /></svg></span>
              </a>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  </div>

</Layout>

<style is:global>
  .timeline-text strong { color: #f0a6ff; font-weight: 700; }
  .hand {
    font-family: 'Nothing You Could Do', 'Segoe Script', cursive;
    font-weight: 400;
    color: #1a1a1a;
  }
  .quiz-paper {
    background-color: #fdfaf8;
    background-image: repeating-linear-gradient(to bottom, transparent 0, transparent 35px, rgba(110, 150, 210, 0.2) 35px, rgba(110, 150, 210, 0.2) 36px);
  }
  @media (min-width: 1100px) {
    .quiz-paper {
      background-image:
        linear-gradient(to right, transparent 4.5rem, rgba(224, 64, 251, 0.18) 4.5rem, rgba(224, 64, 251, 0.18) calc(4.5rem + 1px), transparent calc(4.5rem + 1px)),
        repeating-linear-gradient(to bottom, transparent 0, transparent 35px, rgba(110, 150, 210, 0.2) 35px, rgba(110, 150, 210, 0.2) 36px);
    }
  }
  /* Circles draw themselves and handwriting is written out once it scrolls into view. */
  .js .circ path { stroke-dasharray: 1; stroke-dashoffset: 1; transition: stroke-dashoffset 0.9s cubic-bezier(0.5, 0, 0.2, 1) 0.15s; }
  .js .circ.is-in path { stroke-dashoffset: 0; }
  .js .write { clip-path: inset(-20% 100% -30% -2%); transition: clip-path 1.4s cubic-bezier(0.4, 0, 0.2, 1) 0.1s; }
  .js .write.is-in { clip-path: inset(-20% -2% -30% -2%); }
  @media (prefers-reduced-motion: reduce) {
    .js .circ path, .js .write { transition: none; }
  }
</style>

<script>
  const root = document.documentElement;
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // The first screen fades back as the page slides over it
  const hero = document.getElementById('hero-inner');
  if (hero && !reduce && window.matchMedia('(min-width: 1024px)').matches) {
    const update = () => {
      const p = Math.min(1, Math.max(0, window.scrollY / (window.innerHeight * 0.85)));
      hero.style.opacity = String(1 - p * 0.8);
      hero.style.transform = `scale(${1 - p * 0.05})`;
      hero.style.transformOrigin = '50% 100%';
    };
    window.addEventListener('scroll', update, { passive: true });
    update();
  }

  if (!reduce && 'IntersectionObserver' in window) {
    root.classList.add('js');
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          const el = entry.target as HTMLElement;
          if (el.dataset.writes) el.querySelectorAll('.write').forEach((w) => w.classList.add('is-in'));
          else el.classList.add('is-in');
          io.unobserve(el);
        });
      },
      { threshold: 0.5 }
    );
    // Handwriting is clipped away until it is written out, so watch the box around it instead
    document.querySelectorAll<HTMLElement>('.write').forEach((w) => {
      const box = w.parentElement as HTMLElement;
      box.dataset.writes = '1';
      io.observe(box);
    });
    document.querySelectorAll('.circ').forEach((el) => io.observe(el));
  }
</script>
