---
import Layout from '../layouts/Layout.astro';
import FreebieReveal from '../components/FreebieReveal.astro';

const arrow = 'M4 12L12 4M5.5 4H12v6.5';

const elsewhere = [
  { title: 'The Podcast', text: 'The Email Growth Show, every Friday. Real talk on growing your list without social media.', href: '/podcast', image: '/images/hero-1.jpg', dot: 'bg-pink text-white' },
  { title: 'The Free Community', text: 'Email Marketing Skool: a 90-day growth plan and 1,300+ women doing the same work.', href: 'https://www.skool.com/email-marketing-skool/about', image: '/images/hero-8.jpg', dot: 'bg-pink-light text-black' },
  { title: 'My Favorites', text: 'The tools and resources I actually use to run my business.', href: '/resources', image: '/images/desk-scene.jpg', dot: 'bg-[#e9d9ec] text-black' },
  { title: 'The Blog', text: 'Practical posts on email, visibility and growing a business.', href: '/blog', image: '/images/hero-2.jpg', dot: 'bg-black text-white' },
];

const socials = [
  { label: 'Instagram', href: 'https://www.instagram.com/the_kyliekelly/', dot: 'bg-pink-light text-black' },
  { label: 'Apple Podcasts', href: 'https://podcasts.apple.com/podcast/id1550211753', dot: 'bg-[#e9d9ec] text-black' },
  { label: 'Spotify', href: 'https://open.spotify.com/show/69feUlzhejQl1xIMpCLyC3', dot: 'bg-pink text-white' },
];

const field = 'w-full rounded-full bg-white px-6 py-4 text-[15px] text-black placeholder:text-black/55 shadow-[0_6px_24px_rgba(0,0,0,0.04)] border border-transparent focus:outline-none focus:border-pink focus:ring-1 focus:ring-pink';
---
<Layout title="Contact | Kylie Kelly" description="Questions, collaborations, or podcast invitations? Get in touch with Kylie Kelly. Replies within 48 hours, Monday to Friday AEST.">

  <!-- TAG BAR -->
  <section class="bg-pink-light px-6 py-4">
    <p class="max-w-4xl mx-auto flex items-center justify-center gap-4 text-xs sm:text-sm font-normal uppercase tracking-widest text-black text-center">
      <span class="hidden sm:block h-px flex-1 bg-black/30"></span>
      Wife. Mom of two boys. Email marketing educator. Host of The Email Growth Show.
      <span class="hidden sm:block h-px flex-1 bg-black/30"></span>
    </p>
  </section>

  <!-- GET IN TOUCH -->
  <section class="bg-[#fbe6f7] px-6 pt-16 pb-24 sm:pt-24 sm:pb-32">
    <div class="max-w-2xl mx-auto">
      <h1 class="text-center text-5xl sm:text-7xl font-bold leading-none mb-8">
        Get in <span class="script-accent italic text-pink">touch</span>
      </h1>
      <p class="text-center text-black mb-12 max-w-xl mx-auto leading-relaxed">
        <strong>Say hey. I'd love to hear from you.</strong> Got a question, a collaboration idea, or a podcast pitch? Pop it in the form below and it lands straight in my inbox <span class="italic">{'{not a chatbot, not a VA, just me}'}</span>. I get back to everyone within 48 hours, Monday to Friday AEST. Or email me at <a href="mailto:hello@kyliekelly.com" class="font-semibold text-pink underline underline-offset-4">hello@kyliekelly.com</a>.
      </p>

      <div id="contact-thanks" class="hidden rounded-[2rem] bg-white px-8 py-12 text-center shadow-[0_6px_24px_rgba(0,0,0,0.04)]" role="status" tabindex="-1">
        <p class="font-serif italic text-pink text-3xl mb-3">Message sent!</p>
        <p class="font-serif text-2xl sm:text-3xl leading-snug text-balance mb-4">Thank you, <span id="contact-thanks-name">lovely</span>. It's on its way to my inbox.</p>
        <p class="text-black">I get back to everyone within 48 hours, Monday to Friday AEST.</p>
      </div>

      <form id="contact-form" class="space-y-4" action="mailto:hello@kyliekelly.com" method="post" enctype="text/plain" novalidate>
        <div style="position:absolute;left:-9999px;top:auto;width:1px;height:1px;overflow:hidden;" aria-hidden="true">
          <label for="c-website">Leave this field empty</label>
          <input id="c-website" name="website" type="text" tabindex="-1" autocomplete="off" />
        </div>
        <label class="sr-only" for="c-name">Your name</label>
        <input id="c-name" name="Name" type="text" required placeholder="Your name" autocomplete="name" class={field} />
        <label class="sr-only" for="c-email">Your email address</label>
        <input id="c-email" name="Email" type="email" required placeholder="Your email address" autocomplete="email" class={field} />
        <label class="sr-only" for="c-subject">What is it about?</label>
        <input id="c-subject" name="Subject" type="text" required placeholder="What's it about?" class={field} />
        <label class="sr-only" for="c-found">How did you find me?</label>
        <input id="c-found" name="Found me via" type="text" placeholder="How did you find me? (optional)" class={field} />
        <label class="sr-only" for="c-message">Any details you'd like to share</label>
        <textarea id="c-message" name="Message" rows="6" required placeholder="Any details you'd like to share" class="w-full rounded-[1.75rem] bg-white px-6 py-4 text-[15px] text-black placeholder:text-black/55 shadow-[0_6px_24px_rgba(0,0,0,0.04)] border border-transparent focus:outline-none focus:border-pink focus:ring-1 focus:ring-pink"></textarea>
        <div class="flex flex-col-reverse sm:flex-row sm:items-center sm:justify-between gap-5 pt-2">
          <p id="contact-status" class="text-sm text-black/70" role="status" aria-live="polite">Your message goes straight to my inbox.</p>
          <button id="contact-send" type="submit" class="group inline-flex items-center justify-between gap-4 self-end rounded-full bg-black text-white pl-8 pr-2 py-2 text-[15px] font-semibold cursor-pointer transition-transform duration-300 hover:-translate-y-1">
            <span id="contact-send-label">Send it</span>
            <span class="grid place-items-center h-11 w-11 rounded-full bg-pink text-white transition-colors duration-300 group-hover:bg-white group-hover:text-black"><svg viewBox="0 0 16 16" class="h-4 w-4 transition-transform duration-300 group-hover:rotate-45" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={arrow} /></svg></span>
          </button>
        </div>
      </form>
    </div>
  </section>

  <!-- FIND ME ELSEWHERE -->
  <section class="relative z-10 -mt-12 rounded-t-[2.5rem] bg-white px-6 py-20 sm:py-28">
    <div class="max-w-5xl mx-auto">
      <p class="text-xs uppercase tracking-widest font-semibold text-center mb-3">Not ready to write?</p>
      <h2 class="font-serif text-4xl sm:text-5xl text-center mb-14 sm:mb-20">Find me elsewhere</h2>
      <div class="grid md:grid-cols-[1fr_0.9fr] gap-12 md:gap-16 items-center">
        <ul class="space-y-9">
          {elsewhere.map((e) => (
            <li>
              <a href={e.href} class="group flex items-center gap-5">
                <img src={e.image} alt="" class="h-20 w-20 flex-none rounded-full object-cover" loading="lazy" />
                <span class="flex-1">
                  <span class="block font-serif text-2xl mb-1">{e.title}</span>
                  <span class="block text-sm text-black">{e.text}</span>
                </span>
                <span class={`grid place-items-center h-10 w-10 flex-none rounded-full transition-colors duration-300 group-hover:bg-pink group-hover:text-white ${e.dot}`} aria-hidden="true"><svg viewBox="0 0 16 16" class="h-4 w-4 transition-transform duration-300 group-hover:rotate-45" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d={arrow} /></svg></span>
              </a>
            </li>
          ))}
        </ul>
        <div class="relative overflow-hidden rounded-[2rem] bg-[#e9d9ec] min-h-[560px] md:min-h-[680px]">
          <img src="/images/hero-7.jpg" alt="Kylie Kelly laughing, holding a disco ball" class="absolute inset-0 h-full w-full object-cover object-top" loading="lazy" />
          <div class="absolute inset-x-0 bottom-0 p-6 space-y-3 bg-gradient-to-t from-black/45 to-transparent pt-24">
            {socials.map((s) => (
              <a href={s.href} target="_blank" rel="noopener" class="group flex items-center justify-between rounded-full bg-white pl-6 pr-2 py-2 text-[15px] font-semibold text-black transition-transform duration-300 hover:-translate-y-1">
                {s.label}
                <span class={`grid place-items-center h-10 w-10 rounded-full transition-colors duration-300 group-hover:bg-black group-hover:text-white ${s.dot}`}><svg viewBox="0 0 16 16" class="h-4 w-4 transition-transform duration-300 group-hover:rotate-45" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={arrow} /></svg></span>
              </a>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- FREEBIE REVEAL: sits behind the footer and is uncovered at the very end of the page -->
  <FreebieReveal slot="reveal" />

</Layout>

<script>
  // Send the message through the site's own /api/contact, which emails it to hello@kyliekelly.com.
  // If anything goes wrong, fall back to opening the visitor's email app with the message filled in.
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const status = document.getElementById('contact-status');
  const thanks = document.getElementById('contact-thanks');
  const sendButton = document.getElementById('contact-send') as HTMLButtonElement | null;
  const sendLabel = document.getElementById('contact-send-label');
  const loadedAt = Date.now();

  if (form) {
    const get = (data: FormData, key: string) => String(data.get(key) ?? '').trim();

    const openEmailApp = (data: FormData) => {
      const lines = [`Name: ${get(data, 'Name')}`, `Email: ${get(data, 'Email')}`];
      if (get(data, 'Found me via')) lines.push(`Found me via: ${get(data, 'Found me via')}`);
      lines.push('', get(data, 'Message'));
      const subject = get(data, 'Subject') || 'Hello from kyliekelly.com';
      window.location.href = `mailto:hello@kyliekelly.com?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(lines.join('\n'))}`;
    };

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (!form.reportValidity()) return;
      const data = new FormData(form);
      if (sendButton) sendButton.disabled = true;
      if (sendLabel) sendLabel.textContent = 'Sending…';
      if (status) status.textContent = '';

      try {
        const response = await fetch('/api/contact', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            name: get(data, 'Name'),
            email: get(data, 'Email'),
            subject: get(data, 'Subject'),
            found: get(data, 'Found me via'),
            message: get(data, 'Message'),
            website: get(data, 'website'),
            loadedAt,
          }),
        });
        if (!response.ok) throw new Error(`status ${response.status}`);
        const nameEl = document.getElementById('contact-thanks-name');
        if (nameEl) nameEl.textContent = get(data, 'Name').split(' ')[0] || 'lovely';
        form.classList.add('hidden');
        thanks?.classList.remove('hidden');
        thanks?.focus();
      } catch {
        if (sendButton) sendButton.disabled = false;
        if (sendLabel) sendLabel.textContent = 'Send it';
        if (status) {
          status.innerHTML = 'That did not go through. <a href="mailto:hello@kyliekelly.com" class="font-semibold text-pink underline underline-offset-4">Email me directly</a> and I will get back to you.';
        }
        openEmailApp(data);
      }
    });
  }
</script>
