---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Contact Kylie Kelly | Email Marketing Educator" description="Questions, collaborations, or podcast invitations? Get in touch with Kylie Kelly. Replies within 48 hours, Monday to Friday AEST.">

  <section class="bg-black text-white px-6 py-20">
    <div class="max-w-2xl mx-auto text-center">
      <h1 class="text-4xl sm:text-5xl font-bold mb-6">Let's start the conversation that puts your name on the map.</h1>
      <p class="text-warmgray">
        Got a question, collaboration idea, or want to work together? I'd love to hear from you. Send me a message and I'll get back to you within 48 hours, Monday to Friday AEST.
      </p>
      <p class="text-warmgray mt-4">Or email me directly at <a href="mailto:hello@kyliekelly.com" class="text-pink-light underline">hello@kyliekelly.com</a></p>
    </div>
  </section>

  <section class="px-6 py-16">
    <form class="max-w-lg mx-auto space-y-4">
      <div>
        <label for="name" class="block text-xs uppercase tracking-wide text-muted mb-1">Name</label>
        <input id="name" name="name" type="text" class="w-full border border-warmgray rounded-md px-4 py-3" required />
      </div>
      <div>
        <label for="email" class="block text-xs uppercase tracking-wide text-muted mb-1">Email</label>
        <input id="email" name="email" type="email" class="w-full border border-warmgray rounded-md px-4 py-3" required />
      </div>
      <div>
        <label for="message" class="block text-xs uppercase tracking-wide text-muted mb-1">Message</label>
        <textarea id="message" name="message" rows="5" class="w-full border border-warmgray rounded-md px-4 py-3" required></textarea>
      </div>
      <button type="submit" class="btn-primary w-full">Send Message</button>
      <p class="text-xs text-muted text-center">
        Note: wire this up to your form handler of choice (Formspree, Resend, etc.) once live, it's just markup for now.
      </p>
    </form>
  </section>

</Layout>
