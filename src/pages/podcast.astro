---
import Layout from '../layouts/Layout.astro';
import Highlight from '../components/Highlight.astro';
import CountUpStats from '../components/CountUpStats.astro';
import PodcastFreebieReveal from '../components/PodcastFreebieReveal.astro';
import PodcastFreebieBand from '../components/PodcastFreebieBand.astro';
import AskKylieBand from '../components/AskKylieBand.astro';
import EpisodeArt from '../components/EpisodeArt.astro';
import reviewData from '../data/listener-reviews.json';
import { getEpisodes } from '../lib/episodes';
import { getDownloads } from '../lib/stats';
import { guestPhotoFor } from '../lib/guestPhotos';
import { pickClassics } from '../lib/classics';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

const arrow = 'M4 12L12 4M5.5 4H12v6.5';
const playIcon = 'M5 3.5v9l7.5-4.5z';

// Real episodes from the podcast feed, newest first.
const allEpisodes = await getEpisodes();
const episodeCount = allEpisodes.length ? Number(allEpisodes[0].num) : 272;
const downloads = await getDownloads();
const minsLabel = (ep: { mins: string | null }) => (ep.mins ? `${ep.mins} min listen` : '');

const newest = allEpisodes.slice(0, 3);
const latestGrid = allEpisodes.slice(3, 9);

// Classics: hand-picked episodes (edit the list in src/lib/classics.ts).
const topEpisodes = pickClassics(allEpisodes);

// Round photos for the Top Episodes rows: the same face-matched shoot photos the covers use.
const photoModules = import.meta.glob<{ default: ImageMetadata }>('../assets/episode-photos/*.{jpg,jpeg,png,webp}', { eager: true });
const topPhotos = Object.entries(photoModules)
  .sort(([a], [b]) => a.localeCompare(b))
  .map(([, mod]) => mod.default);

const findHere = [
  'Real strategies to grow your email list and sell to it, without relying on social media',
  "Solo episodes from me, and guests who are building their businesses differently too",
  'Full show notes with every episode, so you can read it, skim it, or listen on your walk',
  'A new episode every Friday',
];

// Real 5-star Apple Podcasts reviews, word for word. Picked for length so the cards stay tidy.
const praiseOrder = [4, 0, 6, 7, 2, 1];
const praise = praiseOrder.map((i) => reviewData[i]);
const praiseStyle = [
  'bg-[#e9d9ec] text-black -rotate-2',
  'bg-pink text-white rotate-1',
  'bg-[#fbe6f7] text-black rotate-2',
  'bg-pink-light text-black rotate-1',
  'bg-white text-black -rotate-2',
  'bg-[#e9d9ec] text-black rotate-2',
];
// Where each card sits as it slides up over the pinned heading (phone first, then wide screens).
const praisePlace = [
  'self-start ml-0 lg:ml-[6%]',
  'self-end mr-0 lg:mr-[8%] -mt-6 lg:-mt-24',
  'self-start ml-2 lg:ml-[24%] mt-6 lg:mt-4',
  'self-end mr-2 lg:mr-[2%] -mt-4 lg:-mt-28',
  'self-start ml-0 lg:ml-[3%] mt-6 lg:mt-8',
  'self-end mr-0 lg:mr-[22%] -mt-4 lg:-mt-20',
];
const playTint = ['bg-pink text-white', 'bg-black text-white', 'bg-pink-light text-black'];
// Colours for the numbered Classics list
const classicsTint = ['text-pink', 'text-black', 'text-[#a21cb8]', 'text-[#6b3a82]'];
---
<Layout title="The Email Growth Show | Kylie Kelly" description="A top 1.5% podcast globally for women growing an email list without social media. Every Friday, real talk on visibility, list growth, and building a business without the burnout.">

  <section class="bg-black text-white px-6 py-4">
    <p class="max-w-4xl mx-auto flex items-center justify-center gap-4 text-xs sm:text-sm font-normal uppercase tracking-widest text-white text-center">
      <span class="hidden sm:block h-px flex-1 bg-white/30"></span>
      Wife. Mom of two boys. Email marketing educator. Host of The Email Growth Show.
      <span class="hidden sm:block h-px flex-1 bg-white/30"></span>
    </p>
  </section>

  <!-- HERO: the background drifts slowly through soft colours -->
  <section class="pod-hero px-6 pt-14 pb-28 sm:pt-20 sm:pb-36 overflow-hidden">
    <div class="max-w-6xl mx-auto grid md:grid-cols-[1.05fr_0.95fr] gap-14 md:gap-10 items-center">
      <div>
        <p class="flex items-center gap-3 text-sm font-semibold mb-6">
          <span class="text-pink tracking-[0.2em]" role="img" aria-label="5 out of 5 stars">★★★★★</span>
          Top 1.5% podcast globally
        </p>
        <p class="text-xs uppercase tracking-widest font-semibold mb-3">The Email Growth Show with Kylie Kelly</p>
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold leading-[1.08] text-balance mb-6">
          The podcast for women growing an email list <span class="script-accent italic text-pink">without social media.</span>
        </h1>
        <p class="text-black max-w-md mb-9">
          Every Friday, real talk on visibility, list growth, and building a business without the burnout <span class="italic">{'{no algorithm required}'}</span>.
        </p>
        <div class="flex flex-col sm:flex-row sm:flex-wrap gap-3 items-start">
          <a href="https://podcasts.apple.com/podcast/id1550211753" target="_blank" rel="noopener" class="group inline-flex items-center gap-4 rounded-full bg-white text-black pl-6 pr-2 py-2 text-[15px] font-semibold shadow-[0_8px_30px_rgba(0,0,0,0.06)] transition-transform duration-300 hover:-translate-y-1">
            Listen on Apple
            <span class="grid place-items-center h-10 w-10 rounded-full bg-pink text-white transition-colors duration-300 group-hover:bg-black"><svg viewBox="0 0 16 16" class="h-4 w-4 transition-transform duration-300 group-hover:rotate-45" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={arrow} /></svg></span>
          </a>
          <a href="https://open.spotify.com/show/69feUlzhejQl1xIMpCLyC3" target="_blank" rel="noopener" class="group inline-flex items-center gap-4 rounded-full bg-white text-black pl-6 pr-2 py-2 text-[15px] font-semibold shadow-[0_8px_30px_rgba(0,0,0,0.06)] transition-transform duration-300 hover:-translate-y-1">
            Listen on Spotify
            <span class="grid place-items-center h-10 w-10 rounded-full bg-black text-white transition-colors duration-300 group-hover:bg-pink"><svg viewBox="0 0 16 16" class="h-4 w-4 transition-transform duration-300 group-hover:rotate-45" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={arrow} /></svg></span>
          </a>
          <a href="https://emailgrowthshow.buzzsprout.com/share" target="_blank" rel="noopener" class="group inline-flex items-center gap-3 px-3 py-3 text-[15px] font-semibold underline underline-offset-4 decoration-black/30 hover:decoration-pink">
            All platforms
            <span aria-hidden="true">→</span>
          </a>
        </div>
      </div>

      <div class="relative mx-auto w-[82%] sm:w-full max-w-[460px]">
        <div class="pod-cover relative">
          <img src="/images/podcast-cover.jpg" alt="The Email Growth Show podcast cover, with host Kylie Kelly" class="block w-full rounded-[1.75rem] shadow-[0_30px_70px_rgba(0,0,0,0.18)]" width="900" height="900" />
          <span class="pod-flare" aria-hidden="true"></span>
        </div>
      </div>
    </div>
  </section>

  <!-- ABOUT THE SHOW -->
  <section class="relative z-10 -mt-14 sm:-mt-20 rounded-t-[2.5rem] bg-white px-6 pt-20 pb-16 sm:pt-28 sm:pb-24 text-center">
    <div class="max-w-3xl mx-auto">
      <p class="text-xs uppercase tracking-widest font-semibold mb-5">About the show</p>
      <h2 class="text-3xl sm:text-5xl font-bold leading-tight text-balance">
        I'm here to help you get known, trusted, and selling to the right people, <Highlight>without living on social media</Highlight>.
      </h2>
      <p class="mt-6 text-black max-w-xl mx-auto">Recorded from my home office, often while my kids are asleep.</p>
    </div>
    <div class="max-w-2xl mx-auto mt-14 text-left">
      <p class="font-serif font-bold italic text-pink text-3xl sm:text-4xl mb-7">What you'll find here</p>
      <ul class="space-y-4">
        {findHere.map((line) => (
          <li class="flex items-start gap-4">
            <span class="mt-1 grid place-items-center h-6 w-6 flex-none rounded-full bg-pink text-white" aria-hidden="true"><svg viewBox="0 0 16 16" class="h-3 w-3" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 8h9M8.5 4l4 4-4 4" /></svg></span>
            <span class="font-serif text-xl sm:text-2xl leading-snug">{line}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- MARQUEE -->
  <section class="overflow-hidden bg-white pb-12 sm:pb-16" aria-hidden="true">
    <div class="pod-marquee flex w-max">
      {[0, 1].map(() => (
        <div class="flex flex-none">
          {Array.from({ length: 5 }).map(() => (
            <span class="font-serif text-5xl sm:text-7xl uppercase whitespace-nowrap pr-8">Tune in + grow your list <span class="text-pink">/</span></span>
          ))}
        </div>
      ))}
    </div>
  </section>

  <!-- NEWEST EPISODES: round artwork cards -->
  {newest.length > 0 && (
    <section class="bg-white px-6 pb-20 sm:pb-28">
      <div class="max-w-5xl mx-auto">
        <p class="text-base sm:text-lg uppercase tracking-[0.2em] font-semibold mb-12 text-center">New this month</p>
        <div class="flex gap-4 overflow-x-auto snap-x snap-mandatory scroll-px-6 pb-4 -mx-6 px-6 md:mx-0 md:px-0 md:pb-0 md:overflow-visible md:grid md:grid-cols-3 md:gap-x-6 md:gap-y-12">
          {newest.map((ep, i) => (
            <a href={ep.href} class="group block w-[68%] max-w-[300px] flex-none snap-start md:w-auto md:max-w-none">
              <EpisodeArt num={ep.num} title={ep.title} guest={ep.guest} class="transition-transform duration-300 group-hover:-translate-y-1.5" />
              <div class="mt-5 flex items-center justify-between gap-3 px-1">
                <span class="text-[11px] uppercase tracking-widest font-semibold text-black/70">{ep.date}{ep.mins ? ` · ${minsLabel(ep)}` : ''}</span>
                <span class={`grid place-items-center h-10 w-10 flex-none rounded-full transition-transform duration-300 group-hover:scale-110 ${playTint[i % playTint.length]}`} aria-hidden="true"><svg viewBox="0 0 16 16" class="h-4 w-4" fill="currentColor"><path d={playIcon} /></svg></span>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- PODCAST FREEBIE -->
  <section class="bg-white px-6 pb-20 sm:pb-28">
    <PodcastFreebieBand uid="band" />
    <div class="mt-6 sm:mt-8"><AskKylieBand /></div>
  </section>

  <!-- ABOUT YOUR HOST -->
  <section class="bg-black text-white px-6 py-20 sm:py-28 rounded-t-[2.5rem]">
    <div class="max-w-5xl mx-auto">
      <p class="text-pink text-xs uppercase tracking-widest font-semibold mb-4">About your host</p>
      <h2 class="text-3xl sm:text-5xl font-bold leading-tight text-balance max-w-3xl mb-14">
        I'm Kylie, ex international wedding photographer turned email marketing educator, and your host.
      </h2>
      <div class="grid md:grid-cols-[0.8fr_1.2fr] gap-10 md:gap-16 items-start">
        <img src="/images/kylie-headshot.jpg" alt="Kylie Kelly smiling, sitting in a chair wearing a lilac top" class="w-full max-w-sm aspect-[4/5] object-cover object-[50%_25%] rounded-[2rem]" loading="lazy" />
        <div>
          <p class="font-serif text-2xl sm:text-3xl leading-snug mb-6 text-balance">
            I started this podcast to show women that you can grow a real email list without living on social media.
          </p>
          <p class="text-warmgray mb-5">
            Wife, mom of two boys, and proof that it works. I went from 0 to 7,000+ subscribers in 18 months without social media, and now I share exactly how, every Friday. Some weeks it's just me. Some weeks it's a guest who's building it differently too.
          </p>
          <a href="/meet-kylie" class="group inline-flex items-center gap-3 font-semibold">
            More about me
            <span class="grid place-items-center h-10 w-10 rounded-full bg-pink text-white transition-colors duration-300 group-hover:bg-white group-hover:text-black"><svg viewBox="0 0 16 16" class="h-4 w-4 transition-transform duration-300 group-hover:rotate-45" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={arrow} /></svg></span>
          </a>
        </div>
      </div>
      <div class="mt-20 pt-12 border-t border-white/15">
        <CountUpStats dark stats={[
          { value: episodeCount, label: 'Episodes' },
          { value: downloads.value, suffix: downloads.live ? '' : '+', label: 'Downloads' },
          { prefix: 'TOP ', value: 1.5, suffix: '%', label: 'Podcasts globally' },
        ]} />
      </div>
    </div>
  </section>

  <!-- PRAISE: the heading stays pinned while the review cards slide up over it -->
  <section class="praise relative bg-offwhite px-6 pb-20 sm:pb-28">
    <div class="sticky top-0 z-0 flex h-screen flex-col items-center justify-center text-center pointer-events-none">
      <p class="font-serif text-[7.5vw] leading-none sm:text-[min(3.6vw,4.25rem)] uppercase tracking-[0.06em] text-black mb-3 sm:mb-5">Praise for</p>
      <h2 class="font-serif text-[30vw] leading-[0.88] sm:text-[min(16vw,19rem)] sm:leading-none uppercase text-pink">The<br class="sm:hidden" /> Show</h2>
    </div>
    <div class="relative z-10 mx-auto flex max-w-6xl flex-col gap-6 -mt-[8vh]">
      {praise.map((r, i) => (
        <figure data-praise class={`praise-card w-[92%] sm:w-[500px] lg:w-[540px] rounded-[2.25rem] p-8 sm:p-10 lg:p-12 shadow-[0_20px_50px_rgba(0,0,0,0.1)] ${praiseStyle[i]} ${praisePlace[i]}`}>
          <p class="tracking-[0.2em] mb-4" role="img" aria-label="5 out of 5 stars">★★★★★</p>
          <blockquote class="text-base sm:text-lg lg:text-xl leading-relaxed">&ldquo;{r.body}&rdquo;</blockquote>
          <figcaption class="mt-7 text-xs uppercase tracking-widest font-semibold">{r.name}</figcaption>
        </figure>
      ))}
    </div>
    <p class="relative z-10 text-center text-sm text-black/70 mt-16">5-star reviews from Apple Podcasts</p>
  </section>

  <!-- CLASSICS: the most-downloaded episodes -->
  {topEpisodes.length > 0 && (
    <section class="bg-[#e9d9ec] px-6 py-20 sm:py-28 overflow-hidden">
      <div class="max-w-6xl mx-auto">
        <p class="text-center text-xs sm:text-sm uppercase tracking-[0.3em] font-semibold mb-2 sm:mb-3">Tune in to these popular episodes</p>
        <h2 class="text-center font-serif font-bold uppercase leading-[0.9] text-pink text-[17vw] sm:text-[min(14vw,13rem)] mb-12 sm:mb-16">Classics</h2>

        <div class="grid gap-10 md:grid-cols-[0.8fr_1.2fr] md:gap-14 lg:gap-20 items-stretch">
          <div class="relative mx-auto w-full max-w-[420px] md:max-w-none md:min-h-[640px]">
            <img src="/images/classics-kylie.jpg" alt="Kylie Kelly holding a microphone in a pink sequin jacket" class="block w-full aspect-[3/4] md:absolute md:inset-0 md:h-full md:aspect-auto object-cover object-[50%_20%]" width="1000" height="1500" loading="lazy" />
            <a href="/podcast/archive" class="group absolute left-0 top-[58%] inline-flex items-center gap-3 bg-white px-6 py-4 text-xs sm:text-sm font-semibold uppercase tracking-[0.18em] text-black shadow-[0_10px_30px_rgba(0,0,0,0.15)] transition-transform duration-300 hover:-translate-y-1 md:-left-6">
              All episodes <span class="text-pink transition-transform duration-300 group-hover:translate-x-1" aria-hidden="true">→</span>
            </a>
          </div>

          <ol class="divide-y divide-black/10">
            {topEpisodes.map((ep, i) => (
              <li>
                <a href={ep.href} class="group flex items-center gap-4 sm:gap-8 py-6 sm:py-8">
                  <span class={`font-serif font-bold leading-none text-5xl sm:text-8xl w-[1.25em] sm:w-[1.4em] flex-none tabular-nums ${classicsTint[i % classicsTint.length]}`}>{String(i + 1).padStart(2, '0')}</span>
                  <span class="flex-1 min-w-0">
                    <span class={`block font-serif font-bold leading-[1.12] text-base sm:text-2xl text-balance transition-opacity duration-300 group-hover:opacity-70 ${classicsTint[i % classicsTint.length]}`}>{ep.title}</span>
                  </span>
                  {(topPhotos.length > 0 || guestPhotoFor(ep.num)) && (
                    <Image src={guestPhotoFor(ep.num) ?? topPhotos[(Number(ep.num) * 5) % topPhotos.length]} alt="" widths={[200, 300]} sizes="(min-width: 640px) 140px, 84px" class="h-[84px] w-[84px] sm:h-[140px] sm:w-[140px] flex-none object-cover object-[50%_22%] transition-transform duration-300 group-hover:scale-[1.04]" loading="lazy" />
                  )}
                </a>
              </li>
            ))}
          </ol>
        </div>
      </div>
    </section>
  )}

  <!-- ALL THE LATEST -->
  {latestGrid.length > 0 && (
    <section class="bg-white px-6 py-20 sm:py-28">
      <div class="max-w-5xl mx-auto">
        <h2 class="font-serif font-bold italic text-4xl sm:text-5xl mb-12">The latest on the pod:</h2>
        <div class="flex gap-4 overflow-x-auto snap-x snap-mandatory scroll-px-6 pb-4 -mx-6 px-6 md:mx-0 md:px-0 md:pb-0 md:overflow-visible md:grid md:grid-cols-3 md:gap-x-6 md:gap-y-10">
          {latestGrid.map((ep) => (
            <a href={ep.href} class="group block w-[68%] max-w-[300px] flex-none snap-start md:w-auto md:max-w-none">
              <EpisodeArt num={ep.num} title={ep.title} guest={ep.guest} class="transition-transform duration-300 group-hover:-translate-y-1.5" />
              <p class="text-[11px] uppercase tracking-widest font-semibold text-black/70 mt-4 px-1">{ep.date}{ep.mins ? ` · ${minsLabel(ep)}` : ''}</p>
            </a>
          ))}
        </div>
        <!-- Episode library banner -->
        <div class="relative mt-16 sm:mt-20 grid items-center gap-10 overflow-hidden rounded-[2rem] bg-pink px-7 py-12 text-white shadow-[0_30px_70px_rgba(224,64,251,0.25)] sm:px-12 md:grid-cols-[0.8fr_1.2fr] md:gap-14 md:py-16">
          <div class="mx-auto w-[78%] max-w-[300px] -rotate-3 bg-white p-3 pb-12 shadow-[0_20px_40px_rgba(0,0,0,0.25)] md:w-full">
            <img src="/images/kylie-podcast.jpg" alt="Kylie Kelly recording an episode of The Email Growth Show" class="aspect-[4/5] w-full object-cover object-[50%_30%]" width="600" height="750" loading="lazy" />
          </div>
          <div class="text-center md:text-left">
            <p class="mb-4 font-serif italic text-lg text-white/90">Looking for a past episode?</p>
            <h2 class="mb-5 font-serif text-4xl leading-[1.08] text-balance sm:text-5xl">Every episode, every show note: <span class="italic">one library.</span></h2>
            <p class="mx-auto mb-8 max-w-md leading-relaxed md:mx-0">Binge the whole back catalogue of The Email Growth Show, newest first, with the show notes one click away.</p>
            <a href="/podcast/archive" class="group inline-flex items-center gap-4 rounded-full bg-black pl-7 pr-2 py-2 text-xs font-semibold uppercase tracking-[0.18em] text-white transition-transform duration-300 hover:-translate-y-1">
              Browse the episode library
              <span class="grid h-11 w-11 place-items-center rounded-full bg-white text-black transition-colors duration-300 group-hover:bg-pink group-hover:text-white"><svg viewBox="0 0 16 16" class="h-4 w-4 transition-transform duration-300 group-hover:rotate-45" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={arrow} /></svg></span>
            </a>
          </div>
        </div>
      </div>
    </section>
  )}

  <!-- GUESTS + SPONSORS -->
  <section class="bg-offwhite px-6 py-20 sm:py-28">
    <div class="max-w-3xl mx-auto grid md:grid-cols-2 gap-6">
      <div class="relative overflow-hidden rounded-[2rem] bg-black text-white min-h-[520px] md:min-h-[640px] flex items-center justify-center text-center p-8 sm:p-10">
        <img src="/images/desk-scene.jpg" alt="" aria-hidden="true" class="absolute inset-0 h-full w-full object-cover opacity-[0.16] grayscale" loading="lazy" />
        <div class="relative max-w-sm">
          <h2 class="font-serif text-3xl sm:text-4xl leading-tight mb-4 text-balance">Want to come on the show?</h2>
          <p class="mb-7">I'm always looking for guests with a real number to share: a launch that worked, one that flopped, or a way of growing an audience that doesn't look like everyone else's.</p>
          <a href="https://airtable.com/appVoSzOoIw5keVNQ/shrZ7aZ0Jjrf5bIAA" target="_blank" rel="noopener" class="inline-block rounded-full bg-white text-black px-7 py-3.5 text-[15px] font-semibold transition-transform duration-300 hover:-translate-y-1">Apply here →</a>
        </div>
      </div>
      <div class="flex flex-col overflow-hidden rounded-[2rem] bg-white md:min-h-[640px]">
        <img src="/images/kylie-podcast.jpg" alt="Kylie Kelly recording a podcast" class="h-72 w-full object-cover object-[50%_30%]" loading="lazy" />
        <div class="flex flex-1 flex-col justify-center p-8 sm:p-10">
          <h2 class="font-serif text-3xl sm:text-4xl leading-tight mb-4 text-balance">Sponsors / media inquiries</h2>
          <p class="mb-7">Interested in sponsoring an episode, or want to feature the show? Say hello and I'll get back to you.</p>
          <a href="/contact" class="inline-block rounded-full bg-pink text-white px-7 py-3.5 text-[15px] font-semibold transition-transform duration-300 hover:-translate-y-1">Contact us</a>
        </div>
      </div>
    </div>
  </section>

  <!-- FREEBIE REVEAL: sits behind the footer and is uncovered at the very end of the page -->
  <PodcastFreebieReveal slot="reveal" />

</Layout>

<style>
  /* Hero background drifts through soft colours */
  .pod-hero {
    background-color: #e9d9ec;
    animation: pod-hues 30s ease-in-out infinite;
  }
  @keyframes pod-hues {
    0%, 100% { background-color: #e9d9ec; }
    25% { background-color: #fbe6f7; }
    50% { background-color: #fde8dd; }
    75% { background-color: #dfe5f8; }
  }

  /* Tilted cover with a lens flare in the top-left corner */
  .pod-cover {
    transform: rotate(5deg);
    animation: pod-float 7s ease-in-out infinite;
  }
  @keyframes pod-float {
    0%, 100% { transform: rotate(5deg) translateY(0); }
    50% { transform: rotate(4deg) translateY(-8px); }
  }
  .pod-flare {
    position: absolute;
    top: -9%;
    left: -9%;
    width: 30%;
    aspect-ratio: 1;
    pointer-events: none;
    background: radial-gradient(circle, rgba(255,255,255,1) 0 7%, rgba(255,255,255,0.7) 16%, rgba(255,255,255,0) 58%);
    animation: pod-flare 5s ease-in-out infinite;
  }
  .pod-flare::before,
  .pod-flare::after {
    content: '';
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
  }
  .pod-flare::before {
    width: 150%;
    height: 2px;
    background: linear-gradient(90deg, rgba(255,255,255,0), #fff, rgba(255,255,255,0));
  }
  .pod-flare::after {
    width: 2px;
    height: 150%;
    background: linear-gradient(180deg, rgba(255,255,255,0), #fff, rgba(255,255,255,0));
  }
  @keyframes pod-flare {
    0%, 100% { opacity: 0.85; transform: scale(1); }
    50% { opacity: 1; transform: scale(1.18); }
  }

  /* Review cards rise and settle as they scroll into view */
  .praise-card { transition: opacity 0.8s ease, translate 0.9s cubic-bezier(0.2, 0.7, 0.2, 1); }
  .praise-card.is-waiting { opacity: 0; translate: 0 70px; }
  @media (prefers-reduced-motion: reduce) {
    .praise-card.is-waiting { opacity: 1; translate: 0 0; }
  }

  .pod-marquee { animation: pod-marquee 70s linear infinite; }
  @keyframes pod-marquee {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }
  @media (prefers-reduced-motion: reduce) {
    .pod-hero, .pod-cover, .pod-flare, .pod-marquee { animation: none; }
  }
</style>

<script>
  // Cards below the fold start lowered and faded, then settle as they come into view.
  const cards = document.querySelectorAll<HTMLElement>('[data-praise]');
  if ('IntersectionObserver' in window && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const io = new IntersectionObserver((entries) => {
      entries.forEach((e) => {
        if (e.isIntersecting) {
          e.target.classList.remove('is-waiting');
          io.unobserve(e.target);
        }
      });
    }, { threshold: 0.12 });
    cards.forEach((c) => {
      if (c.getBoundingClientRect().top > window.innerHeight) c.classList.add('is-waiting');
      io.observe(c);
    });
  }
</script>
