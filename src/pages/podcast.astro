---
import Layout from '../layouts/Layout.astro';

const recentEpisodes = [
  {
    num: '265',
    meta: 'Solo Episode · 26 Min Listen',
    title: "The Low-Lift Way I'm Growing My List Right Now",
    desc: "The real numbers from my first audio pop-up event since 2022. 303 signups, 370+ downloads, and one very humbling $97 offer.",
    href: '/podcast/episodes/low-lift-email-list-growth/',
  },
  {
    num: '264',
    meta: 'With Anita Mack · 28 Min Listen',
    title: 'How to Actually Delegate to Claude',
    desc: "Claude vs Claude Code vs the Chrome extension, and how my biz bestie built a full sales page with Claude in under two hours.",
    href: '/podcast/episodes/claude-claude-code-chrome-extension-delegate/',
  },
  {
    num: '260',
    meta: 'With Katherine Mackenzie-Smith',
    title: 'How to Plan the Rest of Your Year Without Burning Out',
    desc: "Why a 90-day plan beats a 12-month one, and how to review the first half of your year before you plan the second.",
    href: '/podcast/episodes/plan-rest-of-year-without-burning-out/',
  },
];
---
<Layout title="The Email Growth Show | Kylie Kelly" description="A top 1.5% podcast globally for women growing an email list without social media. Every Friday, real talk on visibility, list growth, and building a business without the burnout.">

  <section class="bg-pink-light px-6 py-4">
    <p class="max-w-4xl mx-auto flex items-center justify-center gap-4 text-xs sm:text-sm font-normal uppercase tracking-widest text-black text-center">
      <span class="hidden sm:block h-px flex-1 bg-black/30"></span>
      Wife. Mom of two boys. Founder of Kylie Kelly. Host of The Email Growth Show.
      <span class="hidden sm:block h-px flex-1 bg-black/30"></span>
    </p>
  </section>

  <!-- HERO -->
  <section class="bg-black text-white px-6 py-20 text-center">
    <div class="max-w-2xl mx-auto">
      <p class="text-pink text-xs uppercase tracking-widest font-semibold mb-4">The Podcast</p>
      <h1 class="text-4xl sm:text-5xl font-bold mb-6">The Email Growth Show</h1>
      <p class="text-warmgray max-w-xl mx-auto mb-10">
        A top 1.5% podcast globally for women growing an email list without social media. Every Friday, real talk on visibility, list growth, and building a business without the burnout <span class="italic">{'{no algorithm required}'}</span>.
      </p>
      <div class="flex flex-wrap justify-center gap-4">
        <a href="https://podcasts.apple.com/eg/podcast/this-mama-means-business-with-kylie-kelly/id1550211753" class="btn-outline !border-white text-white">Apple Podcasts</a>
        <a href="https://open.spotify.com/show/69feUlzhejQl1xIMpCLyC3" class="btn-outline !border-white text-white">Spotify</a>
        <a href="https://emailgrowthshow.buzzsprout.com/share" class="btn-pink">All Platforms →</a>
      </div>
    </div>
  </section>

  <!-- ABOUT YOUR HOST -->
  <section class="bg-offwhite px-6 py-16">
    <div class="max-w-3xl mx-auto grid sm:grid-cols-[auto_1fr] gap-8 items-center text-center sm:text-left">
      <div class="w-32 h-32 rounded-full overflow-hidden mx-auto sm:mx-0">
        <img src="/images/kylie-headshot.jpg" alt="Kylie Kelly smiling" class="w-full h-full object-cover" />
      </div>
      <div>
        <p class="text-pink text-xs uppercase tracking-widest font-semibold mb-2">About Your Host</p>
        <p class="font-serif text-xl font-bold mb-2">Kylie Kelly</p>
        <p class="text-black text-sm mb-4">
          Wife, mom of two boys, and proof that you can grow a real email list without living on social media. I went from 0 to 7,000+ subscribers in 18 months, no ads, no algorithm, and now I share exactly how, every Friday.
        </p>
        <a href="/meet-kylie" class="text-sm font-semibold underline underline-offset-2 hover:text-pink">More About Me →</a>
      </div>
    </div>
  </section>

  <!-- INTRO STRIP -->
  <section class="px-6 py-16 text-center">
    <div class="max-w-2xl mx-auto">
      <h2 class="text-2xl sm:text-3xl font-bold mb-6">Recorded from my home office, often while my kids are asleep.</h2>
      <p class="text-muted">
        Tune in for real strategies to build and monetise your email list, no social media or paid ads required. Some weeks it's just me. Some weeks it's a guest who's building it differently too. Every episode gets full show notes, so you can read it, skim it, or listen on your walk.
      </p>
    </div>
  </section>

  <!-- RECENT EPISODES -->
  <section class="bg-offwhite px-6 py-20">
    <div class="max-w-5xl mx-auto">
      <div class="text-center mb-14">
        <p class="text-pink text-xs uppercase tracking-widest font-semibold mb-3">Recent Episodes</p>
        <h2 class="text-3xl sm:text-4xl font-bold">Hit play <span class="italic">{'{or scroll, we don\'t judge}'}</span>.</h2>
      </div>
      <div class="grid md:grid-cols-3 gap-6">
        {recentEpisodes.map((ep) => (
          <div class="bg-white rounded-lg p-7 flex flex-col">
            <p class="font-serif italic text-pink text-2xl mb-3">{ep.num}</p>
            <p class="text-xs uppercase tracking-widest font-semibold text-muted mb-3">{ep.meta}</p>
            <h3 class="text-lg font-bold mb-3">{ep.title}</h3>
            <p class="text-sm text-muted mb-6 flex-grow">{ep.desc}</p>
            <a href={ep.href} class="text-sm font-semibold underline underline-offset-2 hover:text-pink">Read the show notes →</a>
          </div>
        ))}
      </div>
      <div class="text-center mt-12">
        <a href="/podcast/archive" class="btn-primary">Browse The Full Episode Library →</a>
      </div>
    </div>
  </section>

  <!-- TESTIMONIAL -->
  <section class="bg-pink-light px-6 py-16 text-center">
    <div class="max-w-2xl mx-auto">
      <p class="font-serif italic text-xl leading-relaxed mb-5">"I went from stuck and overwhelmed to 122 new subscribers, in just days of working with Kylie (all without social media!!) She is great at what she does!!"</p>
      <p class="text-xs uppercase tracking-widest font-semibold">— Erin K.</p>
    </div>
  </section>

  <!-- BE OUR GUEST -->
  <section class="bg-black text-white px-6 py-20 text-center">
    <div class="max-w-xl mx-auto">
      <p class="text-pink text-xs uppercase tracking-widest font-semibold mb-4">Want To Be On The Show?</p>
      <h2 class="text-2xl sm:text-3xl font-bold mb-5">Got a story, strategy, or real result other list-builders need to hear?</h2>
      <p class="text-warmgray mb-8">
        I'm always looking for guests with a real number to share, a launch that worked, one that flopped, or a way of growing an audience that doesn't look like everyone else's. If that's you, pitch yourself.
      </p>
      <a href="/contact" class="btn-pink">Apply to Be a Guest →</a>
    </div>
  </section>

  <!-- EMAIL OPT-IN -->
  <section class="px-6 py-20 text-center">
    <div class="max-w-xl mx-auto">
      <p class="text-pink text-xs uppercase tracking-widest font-semibold mb-4">Before You Go</p>
      <h2 class="text-2xl sm:text-3xl font-bold mb-5">Get the strategies before they're episodes.</h2>
      <p class="text-muted mb-8">
        Join my free list for the same visibility and email growth strategies I talk about on the show, straight to your inbox, no waiting for Friday.
      </p>
      <a href="https://kyliekelly.myflodesk.com/audience" class="btn-primary">Get Your Next 1000 Subscribers →</a>
    </div>
  </section>

</Layout>
