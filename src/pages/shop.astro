<style is:global>
  .shop-tab { padding: 0.6rem 0.1rem; margin-bottom: -1px; font-size: 15px; font-weight: 600; border-bottom: 3px solid transparent; color: rgba(0, 0, 0, 0.6); }
  .shop-tab:hover { color: #000; }
  .shop-tab[aria-selected='true'] { color: #000; border-bottom-color: #e040fb; }
</style>

<style>
  .shop-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    white-space: nowrap;
    border: 1px solid #000;
    border-radius: 9999px;
    padding: 0.6rem 1.1rem;
    font-size: 15px;
    font-weight: 600;
    background: #fff;
    transition: background-color 0.25s ease, color 0.25s ease, border-color 0.25s ease;
  }
  .shop-chip:hover { border-color: #e040fb; }
  .shop-chip[aria-pressed='true'] { background: #e040fb; color: #000; }
  .shop-dialog::backdrop { background: rgba(0, 0, 0, 0.55); }
  .shop-dialog { max-height: 90vh; overflow-y: auto; margin: auto; }
  .shop-dialog[open] { animation: shop-pop 0.35s cubic-bezier(0.2, 0.8, 0.2, 1); }
  @keyframes shop-pop { from { opacity: 0; transform: translateY(14px) scale(0.98); } to { opacity: 1; transform: none; } }
  @media (prefers-reduced-motion: reduce) {
    .shop-dialog[open] { animation: none; }
  }
</style>

<script>
  const root = document.querySelector<HTMLElement>('[data-shop]');
  const grid = document.querySelector<HTMLElement>('[data-grid]');
  if (root && grid) {
    const cards = Array.from(grid.querySelectorAll<HTMLElement>('[data-card]'));
    const search = root.querySelector<HTMLInputElement>('[data-search]')!;
    const sortEl = root.querySelector<HTMLSelectElement>('[data-sort]')!;
    const chips = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-chip]'));
    const typeBoxes = Array.from(root.querySelectorAll<HTMLInputElement>('[data-type-filter]'));
    const priceRadios = Array.from(root.querySelectorAll<HTMLInputElement>('[data-price-filter]'));
    const panel = root.querySelector<HTMLElement>('[data-filters-panel]');
    const toggle = root.querySelector<HTMLButtonElement>('[data-filters-toggle]');
    const toggleCount = root.querySelector<HTMLElement>('[data-filters-count]');
    const count = root.querySelector<HTMLElement>('[data-count]')!;
    const clearBtns = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-clear]'));
    const empty = document.querySelector<HTMLElement>('[data-empty]')!;

    const state = { q: '', cat: '', types: [] as string[], price: '', sort: 'featured' };

    const num = (el: HTMLElement, key: string) => Number(el.dataset[key] ?? 0);
    const sorters: Record<string, (a: HTMLElement, b: HTMLElement) => number> = {
      featured: (a, b) => num(a, 'order') - num(b, 'order'),
      newest: (a, b) => String(b.dataset.added).localeCompare(String(a.dataset.added)),
      'price-asc': (a, b) => num(a, 'price') - num(b, 'price') || num(a, 'order') - num(b, 'order'),
      'price-desc': (a, b) => num(b, 'price') - num(a, 'price') || num(a, 'order') - num(b, 'order'),
      az: (a, b) => String(a.dataset.title).localeCompare(String(b.dataset.title)),
    };

    const readUrl = () => {
      const p = new URLSearchParams(location.search);
      state.q = p.get('q') ?? '';
      state.cat = p.get('category') ?? '';
      state.types = (p.get('type') ?? '').split(',').filter(Boolean);
      state.price = p.get('price') ?? '';
      state.sort = sorters[p.get('sort') ?? ''] ? (p.get('sort') as string) : 'featured';
    };
    const writeUrl = () => {
      const p = new URLSearchParams();
      if (state.q) p.set('q', state.q);
      if (state.cat) p.set('category', state.cat);
      if (state.types.length) p.set('type', state.types.join(','));
      if (state.price) p.set('price', state.price);
      if (state.sort !== 'featured') p.set('sort', state.sort);
      const qs = p.toString();
      try { history.replaceState(null, '', qs ? `${location.pathname}?${qs}` : location.pathname); } catch { /* fine without it */ }
    };

    const syncControls = () => {
      search.value = state.q;
      sortEl.value = state.sort;
      chips.forEach((c) => c.setAttribute('aria-pressed', String((c.dataset.chip ?? '') === state.cat)));
      typeBoxes.forEach((b) => { b.checked = state.types.includes(b.value); });
      priceRadios.forEach((r) => { r.checked = r.value === state.price; });
    };

    const apply = () => {
      const words = state.q.toLowerCase().split(/\s+/).filter(Boolean);
      const shown = cards.filter((c) => {
        if (state.cat && c.dataset.category !== state.cat) return false;
        if (state.types.length && !state.types.includes(c.dataset.type ?? '')) return false;
        if (state.price && c.dataset.band !== state.price) return false;
        const hay = c.dataset.search ?? '';
        return words.every((w) => hay.includes(w));
      });
      cards.forEach((c) => { c.style.display = shown.includes(c) ? '' : 'none'; });
      [...cards].sort(sorters[state.sort]).forEach((c) => grid.appendChild(c));

      count.textContent = shown.length === cards.length ? `${cards.length} products` : `${shown.length} of ${cards.length} products`;
      const panelFilters = state.types.length + (state.price ? 1 : 0);
      if (toggleCount) {
        toggleCount.textContent = String(panelFilters);
        toggleCount.classList.toggle('hidden', panelFilters === 0);
      }
      const anyFilter = Boolean(state.q || state.cat || panelFilters);
      clearBtns.forEach((b) => { if (!b.closest('[data-empty]')) b.classList.toggle('hidden', !anyFilter); });
      empty.classList.toggle('hidden', shown.length > 0);
      grid.classList.toggle('hidden', shown.length === 0);
      writeUrl();
    };

    search.addEventListener('input', () => { state.q = search.value.trim(); apply(); });
    sortEl.addEventListener('change', () => { state.sort = sortEl.value; apply(); });
    chips.forEach((c) => c.addEventListener('click', () => { state.cat = c.dataset.chip ?? ''; syncControls(); apply(); }));
    typeBoxes.forEach((b) => b.addEventListener('change', () => { state.types = typeBoxes.filter((x) => x.checked).map((x) => x.value); apply(); }));
    priceRadios.forEach((r) => r.addEventListener('change', () => { state.price = r.value; apply(); }));
    clearBtns.forEach((b) => b.addEventListener('click', () => { state.q = ''; state.cat = ''; state.types = []; state.price = ''; syncControls(); apply(); }));
    toggle?.addEventListener('click', () => {
      if (!panel) return;
      const open = panel.classList.toggle('hidden') === false;
      toggle.setAttribute('aria-expanded', String(open));
    });

    // Quick look: the details are already in the page, the window just shows a copy of them.
    const dialog = document.querySelector<HTMLDialogElement>('[data-dialog]');
    const body = document.querySelector<HTMLElement>('[data-dialog-body]');
    if (dialog && body && typeof dialog.showModal === 'function') {
      grid.querySelectorAll<HTMLButtonElement>('[data-quick]').forEach((btn) => {
        btn.classList.remove('hidden');
        btn.addEventListener('click', () => {
          const tpl = btn.closest('[data-card]')?.querySelector<HTMLTemplateElement>('[data-detail]');
          if (!tpl) return;
          body.replaceChildren(tpl.content.cloneNode(true));
          showTab(btn.dataset.openTab ?? 'inside');
          dialog.showModal();
        });
      });
      const showTab = (name: string) => {
        body.querySelectorAll<HTMLElement>('[data-tab]').forEach((tab) => tab.setAttribute('aria-selected', String(tab.dataset.tab === name)));
        body.querySelectorAll<HTMLElement>('[data-panel]').forEach((panel) => { panel.hidden = panel.dataset.panel !== name; });
      };
      body.addEventListener('click', (e) => {
        const tab = (e.target as HTMLElement).closest<HTMLElement>('[data-tab]');
        if (tab) showTab(tab.dataset.tab ?? 'inside');
      });
      dialog.querySelector('[data-dialog-close]')?.addEventListener('click', () => dialog.close());
      dialog.addEventListener('click', (e) => { if (e.target === dialog) dialog.close(); });
    }

    readUrl();
    syncControls();
    if (panel && toggle && (state.types.length || state.price)) { panel.classList.remove('hidden'); toggle.setAttribute('aria-expanded', 'true'); }
    apply();
  }
</script>

<script>
  // Keeps the featured block right on a page that was built days ago: once the presale has ended it drops the presale wording and shows the regular price.
  const bar = document.querySelector<HTMLElement>('[data-presale][data-ends]');
  if (bar && Date.now() >= new Date(bar.dataset.ends ?? '').getTime()) {
    document.querySelectorAll<HTMLElement>('[data-presale]').forEach((el) => el.remove());
    const price = document.querySelector<HTMLElement>('[data-price-now]');
    if (price?.dataset.regular) price.textContent = price.dataset.regular;
    const cta = document.querySelector<HTMLElement>('[data-cta]');
    const label = cta?.querySelector('a > span');
    if (cta?.dataset.regularLabel && label) label.textContent = cta.dataset.regularLabel;
  }
</script>
