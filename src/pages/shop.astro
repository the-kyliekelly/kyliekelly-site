---
// The KK Digital Product Shop. Every product lives in src/data/shop-products.json, so adding one to the shop is
// adding one entry there: the page, the category chips, the filters, the counts and the search all update themselves.
// The cards are written into the page (so Google and visitors without JavaScript see everything) and a small script
// adds searching, filtering, sorting, the quick look window and a shareable link for each filtered view.
import Layout from '../layouts/Layout.astro';
import FreebieReveal from '../components/FreebieReveal.astro';
import ArrowButton from '../components/ArrowButton.astro';
import allProducts from '../data/shop-products.json';
import settings from '../data/shop-settings.json';
import allReviews from '../data/shop-reviews.json';

// Seasonal switch: while shop-settings.json names a category under "season", that category goes first in Featured order
// and a short note shows above the grid. Empty the category (set it to "") when the season is over.
const season = settings.season?.category ?? '';
const effOrder = (p: { category: string; order: number }) => p.order - (season && p.category === season ? 100 : 0);
const products = [...allProducts].sort((a, b) => effOrder(a) - effOrder(b));
// The Filters button and panel only appear once there are enough products to need them.
const showFilters = products.length >= 9;

// The featured Money-Making Email System block shows the presale price until presaleEnds, then the regular price.
const feat = settings.featured;
const freeImg = settings.start_free;
const presaleLive = Date.now() < new Date(feat.presaleEnds).getTime();
const savings = feat.regularPrice - feat.presalePrice;
const studentHub = 'https://hello-53.teachery.co/my-learning';

// Reviews live in src/data/shop-reviews.json (one entry per review, matched to a product by its slug).
const reviewsFor = (slug: string) => allReviews.filter((r) => r.product === slug).sort((a, b) => b.date.localeCompare(a.date));
const stars = (n: number) => '\u2605'.repeat(n) + '\u2606'.repeat(5 - n);
const summary = (slug: string) => {
  const list = reviewsFor(slug);
  const count = list.length;
  const avg = count ? list.reduce((s, r) => s + r.rating, 0) / count : 0;
  const bars = [5, 4, 3, 2, 1].map((n) => ({ n, pct: count ? Math.round((list.filter((r) => r.rating === n).length / count) * 100) : 0 }));
  return { list, count, avg, bars };
};
const reviewFormUrl = settings.reviews.formUrl;
const niceDate = (d: string) => new Date(d + 'T00:00:00Z').toLocaleDateString('en-AU', { month: 'long', year: 'numeric', timeZone: 'UTC' });

const arrow = 'M4 12L12 4M5.5 4H12v6.5';
const money = (n: number) => `$${n}`;

const categories = [...new Set(products.map((p) => p.category))];
const types = [...new Set(products.map((p) => p.type))];
const countBy = (key: 'category' | 'type') => Object.fromEntries([...new Set(products.map((p) => p[key]))].map((v) => [v, products.filter((p) => p[key] === v).length]));
const catCounts = countBy('category');
const typeCounts = countBy('type');
const priceBands = [
  { id: 'under-50', label: 'Under $50', test: (n: number) => n < 50 },
  { id: '50-99', label: '$50 to $99', test: (n: number) => n >= 50 && n < 100 },
  { id: '100-plus', label: '$100 and over', test: (n: number) => n >= 100 },
].filter((b) => products.some((p) => b.test(p.price)));
const bandOf = (n: number) => (priceBands.find((b) => b.test(n)) ?? priceBands[0]).id;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'The KK Digital Product Shop',
  itemListElement: products.map((p, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    item: {
      '@type': 'Product',
      name: p.title,
      description: p.short,
      brand: { '@type': 'Brand', name: 'Kylie Kelly' },
      offers: { '@type': 'Offer', url: p.buy, price: String(p.price), priceCurrency: 'USD', availability: 'https://schema.org/InStock' },
    },
  })),
};
---
<Layout title="Digital Product Shop: Email Marketing Courses & Templates | Kylie Kelly" description="Courses, templates and coaching for growing your email list without social media. Filter by topic or price, pick the one thing you need and start today.">
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </Fragment>

  <!-- HERO -->
  <section class="relative overflow-hidden bg-black px-6 pt-14 pb-14 text-center text-white sm:pt-20 sm:pb-16">
    <div class="pointer-events-none absolute -left-24 top-1/2 h-[26rem] w-[26rem] -translate-y-1/2 rounded-full bg-pink/25 blur-[120px]" aria-hidden="true"></div>
    <div class="pointer-events-none absolute -right-24 top-0 h-[22rem] w-[22rem] rounded-full bg-pink/20 blur-[120px]" aria-hidden="true"></div>
    <div class="relative mx-auto max-w-3xl">
      <p class="mb-5 text-xs font-semibold uppercase tracking-widest text-white">&mdash; The KK Digital Product Shop &mdash;</p>
      <h1 class="font-serif text-[clamp(2.75rem,7.4vw,6rem)] leading-[0.95] text-balance">
        Grab what you need, <span class="script-accent font-bold italic text-pink">start today.</span>
      </h1>
      <p class="mx-auto mt-6 max-w-xl text-lg text-white">Courses, templates and coaching for growing your email list without social media. Pick the one thing you need and put it to work today.</p>
      <p class="mt-7"><a href={studentHub} target="_blank" rel="noopener" class="inline-block text-xs font-semibold uppercase tracking-widest text-white underline decoration-pink decoration-2 underline-offset-[6px] transition-colors hover:text-pink">Already a student? Log in here</a></p>
    </div>
  </section>

  <!-- FEATURED: THE MONEY-MAKING EMAIL SYSTEM -->
  <section class="bg-white px-6 pt-10 sm:pt-12" aria-label="Featured course">
    <div class="mx-auto max-w-6xl overflow-hidden rounded-[2rem] border-2 border-black bg-white">
      {presaleLive && (
        <p class="bg-black px-6 py-3.5 text-center text-[15px] font-semibold text-white sm:text-base" data-presale data-ends={feat.presaleEnds}><span class="mr-2 text-pink" aria-hidden="true">&#10022;</span>{feat.presaleBar}<span class="ml-2 text-pink" aria-hidden="true">&#10022;</span></p>
      )}
      <div class="grid bg-[#070605] md:grid-cols-[0.9fr_1.1fr]">
        <div class="relative aspect-[4/3] md:aspect-auto md:min-h-[22rem]">
          <img
            src={`${feat.image.src}-640.webp`}
            srcset={`${feat.image.src}-480.webp 480w, ${feat.image.src}-640.webp 640w`}
            sizes="(min-width: 768px) 48vw, 92vw"
            width={feat.image.w} height={feat.image.h} alt={feat.image.alt}
            class="absolute inset-0 h-full w-full object-cover object-left-top" loading="lazy" decoding="async"
          />
          <div class="absolute inset-y-0 right-0 w-1/3 bg-gradient-to-r from-transparent to-[#070605] max-md:hidden" aria-hidden="true"></div>
          <p class="absolute bottom-4 left-4 -rotate-3 rounded-full border-2 border-black bg-pink px-5 py-2 text-2xl font-bold leading-none text-black shadow-[3px_3px_0_0_#000] sm:bottom-6 sm:left-6">{presaleLive ? <s class="mr-2 text-base font-semibold opacity-60" data-presale>{money(feat.regularPrice)}</s> : null}<span data-price-now data-regular={money(feat.regularPrice)}>{money(presaleLive ? feat.presalePrice : feat.regularPrice)}</span></p>
        </div>
        <div class="flex flex-col justify-center px-7 pb-9 pt-2 text-white sm:px-10 md:py-12 lg:pr-14">
          <p class="mb-4 text-sm font-semibold uppercase tracking-[0.2em] text-pink">{presaleLive ? feat.eyebrowPresale : feat.kicker}</p>
          <h2 class="mb-5 font-serif text-[2.4rem] font-bold leading-[1.05] text-balance sm:text-5xl">{feat.title} {feat.accent}</h2>
          <p class="mb-2 text-lg text-white">{feat.subtitle}</p>
          <p class="mb-6 text-[15px] text-pink">{feat.byline}</p>
          {presaleLive && <p class="mb-5 text-[15px] font-semibold" data-presale>{money(feat.presalePrice)} until 30 November, then {money(feat.regularPrice)}. That's {money(savings)} off.</p>}
          <div data-cta data-regular-label={feat.regularLabel}><ArrowButton href={feat.buy} label={presaleLive ? feat.presaleLabel : feat.regularLabel} variant="light" sameTab /></div>
          <p class="mt-6 max-w-md text-[13px] text-warmgray">{feat.proof}</p>
        </div>
      </div>
    </div>
  </section>

  <!-- FIND SOMETHING: search, categories, filters and sorting -->
  <section class="bg-white px-6 pb-6 pt-10 sm:pt-12" aria-label="Find a product" data-shop>
    <div class="mx-auto max-w-6xl">
      <div class="flex flex-col gap-4 lg:flex-row lg:items-center">
        <label class="relative block flex-1" for="shop-search">
          <span class="sr-only">Search the shop</span>
          <svg viewBox="0 0 20 20" class="pointer-events-none absolute left-5 top-1/2 h-5 w-5 -translate-y-1/2 text-black/60" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true"><circle cx="9" cy="9" r="6" /><path d="M14 14l4 4" /></svg>
          <input id="shop-search" type="search" placeholder="Search the shop: try Instagram, Black Friday, templates..." autocomplete="off" class="w-full rounded-full border border-black/30 bg-white py-3.5 pl-12 pr-5 text-[15px] outline-none transition-colors placeholder:text-black/55 focus:border-pink" data-search />
        </label>
        <div class="flex items-center gap-3">
          {showFilters && (
            <button type="button" class="inline-flex items-center gap-2 rounded-full border border-black px-5 py-3 text-[15px] font-semibold transition-colors hover:bg-black hover:text-white" aria-expanded="false" aria-controls="shop-filters" data-filters-toggle>
              <svg viewBox="0 0 20 20" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true"><path d="M3 5h14M6 10h8M9 15h2" /></svg>
              Filters <span class="hidden rounded-full bg-pink px-2 py-0.5 text-xs text-black" data-filters-count>0</span>
            </button>
          )}
          <label class="flex items-center gap-2 text-[15px]" for="shop-sort">
            <span class="hidden font-semibold sm:inline">Sort</span>
            <select id="shop-sort" class="rounded-full border border-black bg-white py-3 pl-4 pr-9 text-[15px] font-semibold outline-none focus:border-pink" data-sort>
              <option value="featured">Featured</option>
              <option value="newest">Newest</option>
              <option value="price-asc">Price: low to high</option>
              <option value="price-desc">Price: high to low</option>
              <option value="az">A to Z</option>
            </select>
          </label>
        </div>
      </div>

      <!-- category chips -->
      <div class="-mx-6 mt-5 overflow-x-auto px-6 pb-1 [scrollbar-width:none] [&::-webkit-scrollbar]:hidden" role="group" aria-label="Categories">
        <div class="flex w-max gap-2.5 sm:w-auto sm:flex-wrap">
          <button type="button" class="shop-chip" data-chip="" aria-pressed="true">All <span class="opacity-60">{products.length}</span></button>
          {categories.map((c) => <button type="button" class="shop-chip" data-chip={c} aria-pressed="false">{c} <span class="opacity-60">{catCounts[c]}</span></button>)}
        </div>
      </div>

      <!-- filter panel -->
      {showFilters && <div id="shop-filters" class="mt-5 hidden rounded-[1.75rem] border border-black/15 bg-offwhite p-6 sm:p-8" data-filters-panel>
        <div class="grid gap-8 sm:grid-cols-2">
          <fieldset>
            <legend class="mb-3 text-xs font-semibold uppercase tracking-widest">Type</legend>
            <div class="space-y-2.5">
              {types.map((t) => (
                <label class="flex cursor-pointer items-center gap-3 text-[15px]">
                  <input type="checkbox" value={t} class="h-5 w-5 accent-[#e040fb]" data-type-filter />
                  <span>{t} <span class="text-black/60">({typeCounts[t]})</span></span>
                </label>
              ))}
            </div>
          </fieldset>
          <fieldset>
            <legend class="mb-3 text-xs font-semibold uppercase tracking-widest">Price</legend>
            <div class="space-y-2.5">
              <label class="flex cursor-pointer items-center gap-3 text-[15px]"><input type="radio" name="shop-price" value="" checked class="h-5 w-5 accent-[#e040fb]" data-price-filter /> <span>Any price</span></label>
              {priceBands.map((b) => <label class="flex cursor-pointer items-center gap-3 text-[15px]"><input type="radio" name="shop-price" value={b.id} class="h-5 w-5 accent-[#e040fb]" data-price-filter /> <span>{b.label}</span></label>)}
            </div>
          </fieldset>
        </div>
      </div>}

      <!-- result count and active filters -->
      <div class="mt-6 flex flex-wrap items-center gap-x-4 gap-y-2 text-[15px]">
        <p class="font-semibold" aria-live="polite" data-count>{products.length} products</p>
        <button type="button" class="hidden text-sm font-semibold underline decoration-pink decoration-2 underline-offset-4 hover:decoration-black" data-clear>Clear all filters</button>
      </div>
    </div>
  </section>

  <!-- THE PRODUCTS -->
  <section class="bg-white px-6 pb-20 sm:pb-24" aria-label="Products">
    <div class="mx-auto max-w-6xl">
      {season && settings.season.note && <p class="mb-6 rounded-full bg-black px-6 py-3.5 text-center text-[15px] font-semibold text-white sm:text-base" data-season-note><span class="mr-2 text-pink" aria-hidden="true">&#10022;</span>{settings.season.note}</p>}
      <ul class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3" data-grid>
        {products.map((p) => {
          const img = (p as { image?: { src: string; w: number; h: number; alt: string } }).image;
          const compareAt = (p as { compareAt?: number }).compareAt;
          const rv = summary(p.slug);
          return (
            <li class="shop-card group flex flex-col overflow-hidden rounded-[2rem] border-2 border-black bg-white transition duration-300 hover:-translate-y-1.5 hover:shadow-[7px_7px_0_0_#e040fb]" data-card data-slug={p.slug} data-category={p.category} data-type={p.type} data-price={p.price} data-band={bandOf(p.price)} data-title={p.title} data-added={p.added} data-order={effOrder(p)} data-search={[p.title, p.kicker, p.short, p.category, p.type, ...p.tags].join(' ').toLowerCase()}>
              {img ? (
                <div class={`relative aspect-[3/2] bg-white`}>
                  {p.look === 'black' && <div class="absolute inset-x-4 bottom-4 top-12 rounded-2xl bg-black" aria-hidden="true"></div>}
                  <img
                    src={`${img.src}-800.webp`}
                    srcset={`${img.src}-480.webp 480w, ${img.src}-800.webp 800w, ${img.src}-1200.webp 1200w`}
                    sizes="(min-width: 1024px) 370px, (min-width: 640px) 45vw, 92vw"
                    width={img.w} height={img.h} alt={img.alt}
                    class={`absolute inset-x-4 bottom-4 top-12 h-[calc(100%-4rem)] w-[calc(100%-2rem)] object-contain ${p.look === 'black' ? 'p-3' : ''}`}
                    loading="lazy" decoding="async"
                  />
                  <p class="absolute left-5 top-4 rounded-full bg-black px-3 py-1 text-[11px] font-semibold uppercase tracking-widest text-white">{p.category}</p>
                  {p.badge && <span class="absolute right-5 top-4 rounded-full bg-pink px-3 py-1 text-[11px] font-semibold uppercase tracking-widest text-black">{p.badge}</span>}
                  <p class="absolute bottom-3 right-4 -rotate-3 rounded-full border-2 border-black bg-pink px-4 py-1.5 text-xl font-bold leading-none text-black shadow-[3px_3px_0_0_#000] transition-transform duration-300 group-hover:rotate-0 group-hover:scale-105">{compareAt && <s class="mr-1.5 text-sm font-semibold opacity-60">{money(compareAt)}</s>}{money(p.price)}</p>
                </div>
              ) : (
                <div class="relative flex aspect-[3/2] flex-col justify-between bg-white p-6">
                  <div class="flex items-start justify-between gap-3">
                    <p class="rounded-full bg-black px-3 py-1 text-[11px] font-semibold uppercase tracking-widest text-white">{p.category}</p>
                    {p.badge && <span class="rounded-full bg-pink px-3 py-1 text-[11px] font-semibold uppercase tracking-widest text-black">{p.badge}</span>}
                  </div>
                  <p class="font-serif text-2xl italic leading-tight text-pink text-balance">{p.kicker}</p>
                  <p class="absolute bottom-3 right-4 -rotate-3 rounded-full border-2 border-black bg-pink px-4 py-1.5 text-xl font-bold leading-none text-black shadow-[3px_3px_0_0_#000]">{money(p.price)}</p>
                </div>
              )}
              <div class="flex flex-1 flex-col p-6">
                <h2 class="mb-2 font-serif text-[1.85rem] font-bold leading-[1.02] text-balance sm:text-[2rem]">{p.title}</h2>
                {rv.count > 0 && (
                  <button type="button" class="mb-2 inline-flex items-center gap-2 self-start text-sm hover:underline" data-quick={p.slug} data-open-tab="reviews" aria-haspopup="dialog" aria-label={`${rv.avg.toFixed(1)} out of 5 from ${rv.count} ${rv.count === 1 ? 'review' : 'reviews'}. Read the reviews`}>
                    <span class="tracking-wide text-pink" aria-hidden="true">{stars(Math.round(rv.avg))}</span>
                    <span class="font-semibold">{rv.avg.toFixed(1)}</span>
                    <span class="text-black/70">({rv.count} {rv.count === 1 ? 'review' : 'reviews'})</span>
                  </button>
                )}
                <p class="mb-1 text-sm font-semibold text-pink">{p.kicker}</p>
                <p class="mb-6 mt-2 line-clamp-3 flex-1 text-[15px] text-black">{p.short}</p>
                <a href={p.buy} target="_self" aria-label={`Buy ${p.title}, ${money(p.price)}`} class="group/btn flex items-center justify-between gap-3 rounded-full bg-black px-6 py-3.5 text-base font-semibold text-white transition-colors duration-300 hover:bg-pink hover:text-black">
                  <span>Buy now</span>
                  <svg viewBox="0 0 16 16" class="h-4 w-4 transition-transform duration-300 group-hover/btn:rotate-45" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={arrow} /></svg>
                </a>
                <button type="button" class="mt-4 hidden self-center text-[15px] font-semibold underline decoration-pink decoration-2 underline-offset-4 hover:decoration-black" data-quick={p.slug} aria-haspopup="dialog">Quick look: what's inside</button>
              </div>
              <template data-detail>
                <p class="mb-2 text-xs font-semibold uppercase tracking-widest text-pink">{p.category} &middot; {p.type}</p>
                <h2 class="mb-3 font-serif text-3xl font-bold leading-tight text-balance">{p.title}</h2>
                <p class="mb-6 text-black">{p.short}</p>
                <div role="tablist" class="mb-5 flex gap-6 border-b border-black/15" aria-label="About this product">
                  <button type="button" role="tab" class="shop-tab" aria-selected="true" data-tab="inside">What's inside</button>
                  <button type="button" role="tab" class="shop-tab" aria-selected="false" data-tab="reviews">Reviews ({rv.count})</button>
                </div>
                <div role="tabpanel" data-panel="inside">
                  <ul class="mb-7 space-y-2.5 text-[15px]">
                    {p.inside.map((item) => <li class="flex gap-3"><span class="text-pink" aria-hidden="true">&#9679;</span><span>{item}</span></li>)}
                  </ul>
                </div>
                <div role="tabpanel" data-panel="reviews" hidden>
                  {rv.count > 0 ? (
                    <div class="mb-6">
                      <div class="mb-5 grid items-center gap-4 rounded-2xl bg-offwhite p-5 sm:grid-cols-[auto_1fr] sm:gap-8">
                        <div class="text-center">
                          <p class="font-serif text-4xl font-bold leading-none">{rv.avg.toFixed(1)}</p>
                          <p class="mt-1 tracking-wide text-pink" aria-hidden="true">{stars(Math.round(rv.avg))}</p>
                          <p class="mt-1 text-xs">Based on {rv.count} {rv.count === 1 ? 'review' : 'reviews'}</p>
                        </div>
                        <ul class="space-y-1 text-xs" aria-label="Rating breakdown">
                          {rv.bars.map((b) => (
                            <li class="flex items-center gap-2"><span class="w-4 text-right">{b.n}</span><span class="h-2 flex-1 overflow-hidden rounded-full bg-black/10"><span class="block h-full rounded-full bg-pink" style={`width:${b.pct}%`}></span></span><span class="w-9 text-right">{b.pct}%</span></li>
                          ))}
                        </ul>
                      </div>
                      <ul class="space-y-5">
                        {rv.list.map((r) => (
                          <li class="border-b border-black/10 pb-5 last:border-0 last:pb-0">
                            <p class="tracking-wide text-pink" aria-label={`${r.rating} out of 5 stars`}>{stars(r.rating)}</p>
                            <p class="mt-1 font-semibold">{r.name}{r.tagline && <span class="font-normal text-black/70">, {r.tagline}</span>} <span class="text-sm font-normal text-black/60">&middot; {niceDate(r.date)}</span></p>
                            {r.title && <p class="mt-2 font-serif text-lg font-bold leading-snug">{r.title}</p>}
                            <p class="mt-1 text-[15px]">{r.text}</p>
                          </li>
                        ))}
                      </ul>
                    </div>
                  ) : (
                    <p class="mb-6 text-[15px]">No reviews here yet. If you've bought this, I'd love to hear what you thought.</p>
                  )}
                  <p class="mb-7"><a href={reviewFormUrl} target="_blank" rel="noopener" class="inline-flex rounded-full border-2 border-black px-6 py-3 text-[15px] font-semibold transition-colors hover:bg-black hover:text-white">Write a review</a></p>
                </div>
                <div class="flex flex-wrap items-center gap-x-6 gap-y-4">
                  <ArrowButton href={p.buy} label={`Buy now, ${money(p.price)}`} variant="dark" sameTab />
                  <a href={p.login} target="_blank" rel="noopener" class="text-[15px] font-semibold underline decoration-pink decoration-2 underline-offset-4 hover:decoration-black">Existing student log in</a>
                </div>
              </template>
            </li>
          );
        })}
      </ul>

      <!-- nothing matched -->
      <div class="mx-auto hidden max-w-md py-16 text-center" data-empty>
        <p class="mb-3 font-serif text-3xl">Nothing matches that, yet.</p>
        <p class="mb-6">Try a different word, or clear your filters to see everything in the shop.</p>
        <button type="button" class="rounded-full bg-black px-7 py-3.5 text-[15px] font-semibold text-white transition-colors hover:bg-pink hover:text-black" data-clear>Clear all filters</button>
      </div>
    </div>
  </section>

  <!-- REASSURANCE -->
  <section class="border-y border-black/10 bg-white px-6 py-8" aria-label="About buying">
    <ul class="mx-auto grid max-w-5xl gap-5 text-center text-[15px] sm:grid-cols-3 sm:gap-8">
      <li><span class="font-semibold">Secure checkout.</span> Payments are handled by Teachery and ThriveCart, never on this site.</li>
      <li><span class="font-semibold">Digital products.</span> Nothing to ship, so you can start straight away.</li>
      <li><span class="font-semibold">Questions first?</span> Email <a href="mailto:hello@kyliekelly.com" class="underline decoration-pink decoration-2 underline-offset-4 hover:decoration-black">hello@kyliekelly.com</a></li>
    </ul>
    <p class="mx-auto mt-6 max-w-2xl text-center text-[15px]"><span class="font-semibold">Already a student?</span> <a href={studentHub} target="_blank" rel="noopener" class="underline decoration-pink decoration-2 underline-offset-4 hover:decoration-black">Log in here</a>, or use "Existing student log in" in a product's quick look.</p>
  </section>

  <!-- START FREE -->
  <section class="bg-offwhite px-6 py-16 sm:py-20" aria-label="Start free">
