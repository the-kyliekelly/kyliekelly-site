---
// "Ask Kylie": listeners record a voice question for The Email Growth Show.
// The recorder is SpeakPipe. Its loader script is added in the browser (see the script at the bottom),
// and the recorder itself is drawn inline in the "Record your question" card.
import Layout from '../layouts/Layout.astro';

const arrow = 'M4 12L12 4M5.5 4H12v6.5';

const SPEAKPIPE_TOKEN = 'xfaqwaa1sa5oaxahjizgb5e8zk59zw8d'; // SpeakPipe public token for the show
const recorderSrc = `https://www.speakpipe.com/apps/dialog/${SPEAKPIPE_TOKEN}`;
const MAX_SECONDS = 90; // Matches the maximum recording length set in SpeakPipe

const steps = [
  { n: '1', title: 'Press record', text: 'Ask your question out loud, the way you would if we were having a coffee.' },
  { n: '2', title: 'Send it to me', text: 'It lands straight with me, no sign-up and no account needed.' },
  { n: '3', title: 'Listen for it', text: 'Questions I can help with may be answered on a future episode of The Email Growth Show.' },
];

const tips = [
  'Find somewhere quiet, and hold your phone close like you are leaving a voice note for a friend.',
  'One question per recording. Want to ask two? Record twice.',
  'Be specific about where you are at. Your list size, what you sell and what you have already tried.',
  `Keep it short. You have up to ${MAX_SECONDS} seconds, and under a minute is the sweet spot.`,
  'Say your first name at the start so I can say it back to you.',
];
---
<Layout
  title="Ask Kylie | Send a Voice Question to The Email Growth Show"
  description="Record a voice question for The Email Growth Show. Ask Kylie Kelly about growing your email list, getting seen without social media and building a business that fits your life."
>

  <section class="bg-black text-white px-6 py-4">
    <p class="max-w-4xl mx-auto flex items-center justify-center gap-4 text-xs sm:text-sm font-normal uppercase tracking-widest text-center">
      <span class="hidden sm:block h-px flex-1 bg-white/30"></span>
      The Email Growth Show &middot; Listener questions
      <span class="hidden sm:block h-px flex-1 bg-white/30"></span>
    </p>
  </section>

  <!-- HERO -->
  <section class="bg-offwhite px-6 pt-14 pb-14 sm:pt-24 sm:pb-20 text-center">
    <div class="max-w-3xl mx-auto">
      <p class="text-xs uppercase tracking-widest font-semibold mb-5">Your question, in your own voice</p>
      <h1 class="text-5xl sm:text-7xl font-bold leading-[1.05] text-balance mb-7">
        Ask <span class="script-accent italic text-pink">Kylie</span>
      </h1>
      <p class="text-lg sm:text-xl leading-relaxed text-black max-w-xl mx-auto mb-9">
        Stuck on your email list, your visibility, or how to grow without living on social media? Record your question and I may answer it on a future episode of The Email Growth Show.
      </p>
      <a href="#record" class="group inline-flex items-center gap-4 rounded-full bg-black text-white pl-7 pr-2 py-2 text-[15px] font-semibold transition-transform duration-300 hover:-translate-y-1">
        Record my question
        <span class="grid place-items-center h-11 w-11 rounded-full bg-pink text-white transition-colors duration-300 group-hover:bg-white group-hover:text-black"><svg viewBox="0 0 16 16" class="h-4 w-4 transition-transform duration-300 group-hover:translate-y-0.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M8 3v10M3.5 8.5L8 13l4.5-4.5" /></svg></span>
      </a>
    </div>
  </section>

  <!-- HOW IT WORKS -->
  <section class="bg-white px-6 py-16 sm:py-24">
    <div class="max-w-5xl mx-auto">
      <p class="text-xs uppercase tracking-widest font-semibold mb-10 text-center">How it works</p>
      <ol class="grid gap-5 md:grid-cols-3 md:gap-6">
        {steps.map((s) => (
          <li class="flex items-start gap-5 rounded-[2rem] bg-offwhite p-7 md:flex-col md:gap-4 md:p-8">
            <span class="grid h-12 w-12 flex-none place-items-center rounded-full bg-pink font-serif text-xl text-white" aria-hidden="true">{s.n}</span>
            <div>
              <h2 class="font-serif text-2xl leading-tight mb-2">{s.title}</h2>
              <p class="text-[15px] leading-relaxed">{s.text}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- SAY IT LIKE THIS -->
  <section class="bg-white px-6 pb-16 sm:pb-24">
    <div class="max-w-3xl mx-auto">
      <div class="relative overflow-hidden rounded-[2rem] bg-black text-white px-7 py-10 sm:px-14 sm:py-14 shadow-[0_30px_70px_rgba(0,0,0,0.18)]">
        <span class="absolute -right-10 -top-10 h-40 w-40 rounded-full bg-pink/30 blur-3xl" aria-hidden="true"></span>
        <p class="relative text-pink text-xs uppercase tracking-widest font-semibold mb-4">Not sure what to say?</p>
        <h2 class="relative font-serif font-bold italic text-4xl sm:text-5xl leading-tight mb-8">Say it like this</h2>
        <blockquote class="relative font-serif text-2xl sm:text-3xl leading-snug sm:leading-snug text-balance">
          &ldquo;Hi Kylie, it&rsquo;s <span class="text-pink">[your first name]</span>. I <span class="text-pink">[what you do]</span>, and my email list is <span class="text-pink">[where it is at right now]</span>. My question is: <span class="text-pink">[your one question]</span>. Thank you!&rdquo;
        </blockquote>
        <p class="relative mt-8 text-sm leading-relaxed text-warmgray">One question per recording, and just fill in the pink bits in your own words. No script reading required.</p>
      </div>
    </div>
  </section>

  <!-- A FEW THINGS THAT HELP -->
  <section class="bg-offwhite px-6 py-16 sm:py-24">
    <div class="max-w-2xl mx-auto">
      <h2 class="font-serif text-3xl sm:text-4xl leading-tight text-center mb-10">A few things that help</h2>
      <ul class="space-y-4">
        {tips.map((tip) => (
          <li class="flex items-start gap-4">
            <span class="mt-1 grid h-6 w-6 flex-none place-items-center rounded-full bg-pink text-white" aria-hidden="true"><svg viewBox="0 0 16 16" class="h-3 w-3" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 8h9M8.5 4l4 4-4 4" /></svg></span>
            <span class="text-[17px] leading-relaxed">{tip}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- RECORD YOUR QUESTION -->
  <section id="record" class="scroll-mt-20 bg-white px-6 py-16 sm:py-24">
    <div class="max-w-xl mx-auto text-center">
      <p class="text-pink text-xs uppercase tracking-widest font-semibold mb-3">Ready when you are</p>
      <h2 class="font-serif font-bold italic text-4xl sm:text-5xl leading-tight mb-4">Record your question</h2>
      <p class="mb-8 leading-relaxed">Tap the microphone, allow access when your phone asks, and talk. You can listen back before you send it.</p>

      <div class="rounded-[2rem] bg-offwhite p-4 sm:p-6 shadow-[0_20px_50px_rgba(0,0,0,0.08)]">
        <iframe
          id="ask-recorder"
          title="Record your question for Kylie"
          src={recorderSrc}
          allow="microphone"
          loading="lazy"
          class="mx-auto block h-[420px] w-full max-w-[360px] rounded-2xl border-0 bg-white"
        ></iframe>
        <noscript><p class="p-4 text-sm">The recorder needs JavaScript. You can also email your question to <a href="mailto:hello@kyliekelly.com" class="font-semibold text-pink underline underline-offset-4">hello@kyliekelly.com</a>.</p></noscript>
      </div>

      <p class="mt-5 text-sm">
        Recorder not loading?
        <button type="button" id="ask-open-recorder" class="font-semibold text-pink underline underline-offset-4 cursor-pointer">Open it in a pop-up instead</button>.
      </p>

      <p class="mt-8 text-xs leading-relaxed text-black/70 max-w-md mx-auto">
        By sending a recording you agree that I may play it, or use parts of it, on The Email Growth Show and in related content. Your name and message are handled as set out in the <a href="/privacy-policy#voice-messages" class="font-semibold underline underline-offset-2 hover:text-pink">Privacy Policy</a>.
      </p>
    </div>
  </section>

  <!-- WHAT HAPPENS NEXT -->
  <section class="bg-black text-white px-6 py-16 sm:py-24 rounded-t-[2.5rem]">
    <div class="max-w-3xl mx-auto text-center">
      <p class="text-pink text-xs uppercase tracking-widest font-semibold mb-4">What happens next</p>
      <h2 class="font-serif text-3xl sm:text-5xl leading-tight text-balance mb-6">I can&rsquo;t answer every question on air, but I do want to hear it.</h2>
      <p class="text-warmgray leading-relaxed max-w-xl mx-auto mb-10">
        Questions that I think will help the most listeners may be answered on a future episode. If yours is one of them, keep an ear out for your first name. New episodes land every Friday.
      </p>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-3">
        <a href="https://podcasts.apple.com/podcast/id1550211753" target="_blank" rel="noopener" class="group inline-flex items-center gap-4 rounded-full bg-white text-black pl-6 pr-2 py-2 text-[15px] font-semibold transition-transform duration-300 hover:-translate-y-1">
          Listen on Apple
          <span class="grid place-items-center h-10 w-10 rounded-full bg-pink text-white transition-colors duration-300 group-hover:bg-black"><svg viewBox="0 0 16 16" class="h-4 w-4 transition-transform duration-300 group-hover:rotate-45" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={arrow} /></svg></span>
        </a>
        <a href="https://open.spotify.com/show/69feUlzhejQl1xIMpCLyC3" target="_blank" rel="noopener" class="group inline-flex items-center gap-4 rounded-full bg-white text-black pl-6 pr-2 py-2 text-[15px] font-semibold transition-transform duration-300 hover:-translate-y-1">
          Listen on Spotify
          <span class="grid place-items-center h-10 w-10 rounded-full bg-pink text-white transition-colors duration-300 group-hover:bg-black"><svg viewBox="0 0 16 16" class="h-4 w-4 transition-transform duration-300 group-hover:rotate-45" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={arrow} /></svg></span>
        </a>
      </div>
      <p class="mt-8 text-sm"><a href="/podcast" class="font-serif text-lg uppercase tracking-[0.12em] underline underline-offset-4 decoration-white/40 hover:decoration-white">Back to the podcast &rarr;</a></p>
    </div>
  </section>

</Layout>

<style is:global>
  /* The page has its own recorder card, so hide SpeakPipe's floating "Send Voicemail" tab here. */
  #-speakpipe-widget-side-button { display: none !important; }
</style>

<script is:inline define:vars={{ SPEAKPIPE_TOKEN }}>
  // Load SpeakPipe's script in the browser (it needs the page to exist first), once.
  (function (d) {
    if (d.getElementById('speakpipe-loader')) return;
    var app = d.createElement('script');
    app.id = 'speakpipe-loader';
    app.type = 'text/javascript';
    app.async = true;
    app.src = 'https://www.speakpipe.com/loader/' + SPEAKPIPE_TOKEN + '.js';
    var s = d.getElementsByTagName('script')[0];
    s.parentNode.insertBefore(app, s);
  })(document);

  // Fallback button: SpeakPipe's own pop-up recorder, in case the inline one cannot load.
  var openBtn = document.getElementById('ask-open-recorder');
  if (openBtn) {
    openBtn.addEventListener('click', function () {
      if (typeof window._speakpipe_open_widget === 'function') window._speakpipe_open_widget();
      else window.open('https://www.speakpipe.com/' + SPEAKPIPE_TOKEN, '_blank', 'noopener');
    });
  }
</script>
