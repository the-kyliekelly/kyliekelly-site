---
import fs from 'node:fs';
import path from 'node:path';
import Layout from '../layouts/Layout.astro';
import Highlight from '../components/Highlight.astro';
import FreebieReveal from '../components/FreebieReveal.astro';

const arrow = 'M4 12L12 4M5.5 4H12v6.5';

// Brand logos: drop <slug>.png (or .svg/.webp/.jpg) into public/images/logos/ and it appears above the tool name.
// No file yet = a simple initial badge instead.
const logoFor = (slug: string) => {
  for (const ext of ['png', 'svg', 'webp', 'jpg']) {
    if (fs.existsSync(path.join(process.cwd(), 'public/images/logos', `${slug}.${ext}`))) return `/images/logos/${slug}.${ext}`;
  }
  return null;
};

// Tools Kylie uses. Links are affiliate links, so they carry rel="sponsored".
// pill = the floating sticker in the hero (pos is the md+ position, r the tilt, d the float delay).
const tools = [
  { slug: 'flodesk', name: 'Flodesk', tag: 'Email marketing', desc: 'This is where my email list lives. I use it to send my emails, deliver my freebies and run my automations, without the tech headache.', perk: '25% off your first year', url: 'https://flodesk.com/c/KYLIEKELLY', tint: 'bg-[#e9d9ec]',
    pill: { cls: 'bg-pink text-white', pos: 'md:left-[3%] md:top-[12%]', r: '-6deg', d: '0s' } },
  { slug: 'teachery', name: 'Teachery', tag: 'Courses', desc: 'This is where I host my courses and programs. Super simple to set up and it just works.', perk: '$950 lifetime deal', url: 'https://www.teachery.co/limited-time?a=c4AganJG', tint: 'bg-[#fbe6f7]',
    pill: { cls: 'bg-white text-black', pos: 'md:right-[4%] md:top-[8%]', r: '4deg', d: '-1.2s' } },
  { slug: 'buzzsprout', name: 'Buzzsprout', tag: 'Podcasting', desc: 'This is where all my podcast episodes live. Super easy to use, helps me track downloads, and integrates beautifully with my website.', perk: '$20 credit', url: 'https://www.buzzsprout.com/?referrer_id=2046932', tint: 'bg-pink-light',
    pill: { cls: 'bg-pink-light text-black', pos: 'md:left-[0%] md:top-[44%]', r: '-3deg', d: '-2.4s' } },
  { slug: 'descript', name: 'Descript', tag: 'Audio & video editing', desc: 'Edit audio and video by editing the transcript, like a doc. A game changer for podcasts and clips.', perk: '50% off your first 2 months of Creator', url: 'https://descript.cello.so/JlEIs2TnSLt', tint: 'bg-pink-light',
    pill: { cls: 'bg-[#fbe6f7] text-black', pos: 'md:right-[0%] md:top-[44%]', r: '5deg', d: '-3.1s' } },
  { slug: 'wispr-flow', name: 'Wispr Flow', tag: 'Voice dictation', desc: 'Talk instead of type. It turns your voice into clean, ready-to-send text in any app.', perk: 'A free month of Flow Pro', url: 'https://wisprflow.ai/r?KYLIE344', tint: 'bg-[#e9d9ec]',
    pill: { cls: 'bg-[#e9d9ec] text-black', pos: 'md:left-[7%] md:bottom-[8%]', r: '5deg', d: '-0.6s' } },
  { slug: 'senja', name: 'Senja', tag: 'Social proof', desc: 'Collect testimonials and show them off beautifully, without chasing screenshots.', perk: null, url: 'https://www.senja.io?via=kylie39', tint: 'bg-[#fbe6f7]',
    pill: { cls: 'bg-black text-white ring-2 ring-white/30', pos: 'md:right-[8%] md:bottom-[10%]', r: '-5deg', d: '-1.8s' } },
  { slug: 'ever-ads', name: 'Ever Ads', tag: 'Facebook ads', desc: 'A Facebook ads tool I’ve just started working with.', perk: null, url: 'https://ever-ads.com?via=kylie-993999', tint: 'bg-[#e9d9ec]',
    pill: { cls: 'bg-white text-black', pos: 'md:left-[27%] md:top-[0%]', r: '3deg', d: '-2.8s' } },
  { slug: 'boutique-lawyer', name: 'The Boutique Lawyer', tag: 'Legal templates', desc: 'I’ve used their legal templates for everything from client contracts to my website terms. It’s the peace of mind every business owner needs.', perk: null, url: 'https://the-boutique-lawyer.myshopify.com/kyliekelly', tint: 'bg-[#fbe6f7]',
    pill: { cls: 'bg-pink text-white', pos: 'md:right-[27%] md:bottom-[0%]', r: '-3deg', d: '-3.6s' } },
].map((t) => ({ ...t, logo: logoFor(t.slug) }));

const places = [
  { title: 'The KK Digital Product Shop', text: 'Grab-and-go courses, templates and trainings for growing your list without social media.', href: 'https://shop.kyliekelly.com/', image: '/images/shop-mockup.jpg', dot: 'bg-pink-light text-black' },
  { title: 'Email Marketing Skool', text: 'My free community, with a simple 90-day growth plan and the Email Marketing Starter Kit.', href: 'https://www.skool.com/email-marketing-skool/about', image: '/images/hero-8.jpg', dot: 'bg-[#e9d9ec] text-black' },
  { title: 'The Email Growth Show', text: 'My podcast, every Friday, with full show notes for every episode.', href: '/podcast', image: '/images/hero-1.jpg', dot: 'bg-[#fbe6f7] text-black' },
  { title: 'Find CoLab', text: 'Where women in business find their next collaboration partner, so you can grow your lists together.', href: 'https://findcolab.com/?utm_source=website&utm_medium=favorites-page&utm_campaign=resources&utm_content=hottest-recs', image: '/images/hero-7.jpg', dot: 'bg-pink-light text-black' },
];
---
<Layout title="Favorites | Kylie Kelly" description="A few of my favorite things: the tools and resources I actually use to run my business.">

  <section class="bg-pink-light px-6 py-4">
    <p class="max-w-4xl mx-auto flex items-center justify-center gap-4 text-xs sm:text-sm font-normal uppercase tracking-widest text-black text-center">
      <span class="hidden sm:block h-px flex-1 bg-black/30"></span>
      Everything I love, all in one place
      <span class="hidden sm:block h-px flex-1 bg-black/30"></span>
    </p>
  </section>

  <!-- HERO -->
  <section class="relative bg-black text-white px-6 pt-20 pb-40 sm:pt-28 sm:pb-52 text-center overflow-hidden">
    <div class="pointer-events-none absolute left-1/2 top-1/2 h-[70%] w-[70%] -translate-x-1/2 -translate-y-1/2 rounded-full bg-pink/25 blur-[120px]" aria-hidden="true"></div>
    <div class="relative max-w-6xl mx-auto md:min-h-[520px] flex flex-col items-center justify-center">
      <h1 class="font-serif uppercase leading-[0.9] text-[clamp(3rem,14vw,11rem)]">
        <span class="block text-pink">Favorites</span>
        <span class="block">Right now</span>
      </h1>
      <p class="mt-6 text-warmgray text-lg sm:text-xl">A few of my favorite things</p>
      <div class="mt-10 flex flex-wrap justify-center gap-3 md:mt-0 md:block">
        {tools.map((t) => (
          <a href={`#${t.slug}`} class={`fav-pill inline-block rounded-full px-5 py-2.5 text-sm font-semibold shadow-xl sm:px-7 sm:py-3.5 sm:text-base md:absolute ${t.pill.cls} ${t.pill.pos}`} style={`--r:${t.pill.r};--d:${t.pill.d}`}>{t.name}</a>
        ))}
      </div>
    </div>
  </section>

  <!-- THE HOTTEST RECS -->
  <section class="relative z-10 -mt-14 sm:-mt-20 rounded-t-[2.5rem] bg-white px-6 pt-20 pb-16 sm:pt-28 sm:pb-24 text-center">
    <div class="max-w-3xl mx-auto">
      <p class="text-pink font-semibold uppercase tracking-widest text-sm mb-5">The hottest recs</p>
      <h2 class="text-3xl sm:text-5xl font-bold leading-tight text-balance">
        I only recommend what I <Highlight>actually use</Highlight>. Here are a few of my favorites, all in one place.
      </h2>
      <p class="mt-6 text-sm text-black/70 max-w-xl mx-auto">
        Friendly heads up: some links are affiliate links, which means I may earn a commission (and I will absolutely spend it at a coffee shop). I never recommend anything I don't personally use and love.
      </p>
    </div>

    <div class="max-w-2xl mx-auto mt-14 space-y-4 text-left">
      {places.map((p) => (
        <a href={p.href} class="group flex items-center gap-5 rounded-[1.75rem] bg-offwhite p-4 sm:p-5 transition-transform duration-300 hover:-translate-y-1">
          <img src={p.image} alt="" class="h-20 w-20 sm:h-24 sm:w-24 flex-none rounded-full object-cover" loading="lazy" />
          <span class="flex-1">
            <span class="block font-serif text-xl sm:text-2xl mb-1">{p.title}</span>
            <span class="block text-sm text-black">{p.text}</span>
          </span>
          <span class={`grid place-items-center h-11 w-11 flex-none rounded-full transition-colors duration-300 group-hover:bg-pink group-hover:text-white ${p.dot}`} aria-hidden="true"><svg viewBox="0 0 16 16" class="h-4 w-4 transition-transform duration-300 group-hover:rotate-45" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d={arrow} /></svg></span>
        </a>
      ))}
    </div>
  </section>

  <!-- GO DEEPER: the quiz -->
  <section class="bg-white px-6 pb-20 sm:pb-28">
    <div class="mx-auto grid max-w-5xl items-center gap-10 rounded-[2.5rem] bg-[#fbe6f7] p-8 sm:p-12 md:grid-cols-2 md:gap-14 lg:p-16">
      <div class="relative mx-auto w-full max-w-[260px] sm:max-w-sm md:max-w-none">
        <div class="pointer-events-none absolute inset-x-[6%] inset-y-[8%] rounded-full bg-white/90 blur-3xl" aria-hidden="true"></div>
        <img src="/images/freebie-mockup.png" alt="The Your Next 1000 Subscribers quiz on a desktop monitor" class="relative block h-auto w-full drop-shadow-[0_0_26px_rgba(255,255,255,0.95)]" loading="lazy" />
        <span class="absolute -top-2 right-0 inline-flex items-center gap-2 rounded-full bg-white px-4 py-2 text-xs font-semibold text-black shadow-lg sm:text-sm">
          <span class="h-2.5 w-2.5 rounded-full bg-pink"></span>
          Free &middot; 60 seconds
        </span>
      </div>
      <div class="text-center md:text-left">
        <p class="mb-3 text-xs font-semibold uppercase tracking-widest">Wanna go deeper?</p>
        <h2 class="mb-4 font-serif text-4xl italic leading-tight text-balance sm:text-5xl">Your Next 1,000 Subscribers</h2>
        <p class="mb-8 text-black sm:text-lg">
          Answer 6 quick questions and get the list-building strategy most likely to work for your business right now. Then dive into the guide, full of real case studies.
        </p>
        <a href="/guide" class="group inline-flex items-center gap-4 rounded-full bg-black pl-7 pr-2 py-2 text-[15px] font-semibold text-white transition-transform duration-300 hover:-translate-y-1">
          Take the quiz
          <span class="grid h-10 w-10 place-items-center rounded-full bg-pink text-white transition-colors duration-300 group-hover:bg-white group-hover:text-black"><svg viewBox="0 0 16 16" class="h-4 w-4 transition-transform duration-300 group-hover:rotate-45" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={arrow} /></svg></span>
        </a>
      </div>
    </div>
  </section>

  <!-- MARQUEE -->
  <section class="overflow-hidden bg-white pb-12 sm:pb-16" aria-hidden="true">
    <div class="fav-marquee flex w-max">
      {[0, 1].map(() => (
        <div class="flex flex-none">
          {Array.from({ length: 5 }).map(() => (
            <span class="font-serif text-5xl sm:text-7xl uppercase whitespace-nowrap pr-8">Favorites right now <span class="text-pink">/</span></span>
          ))}
        </div>
      ))}
    </div>
  </section>

  <!-- TOOLS I USE -->
  <section class="bg-offwhite px-6 py-20 sm:py-28">
    <div class="max-w-7xl mx-auto">
      <p class="text-xs uppercase tracking-widest font-semibold text-center mb-3">Business tools</p>
      <h2 class="font-serif text-4xl font-bold italic sm:text-5xl text-center mb-14">The ones I actually use</h2>
      <div class="flex flex-wrap justify-center gap-6">
        {tools.map((t) => (
          <article id={t.slug} class={`flex scroll-mt-24 flex-col rounded-[2rem] p-8 w-full sm:w-[calc(50%-12px)] xl:w-[calc(25%-18px)] ${t.tint}`}>
            <div class="mb-6 flex items-center justify-between gap-3">
              <p class="inline-block self-start rounded-full bg-white px-4 py-1.5 text-xs uppercase tracking-widest font-semibold">{t.tag}</p>
            </div>
            {t.logo ? (
              <h3 class="mb-5 inline-flex h-20 max-w-full items-center self-start rounded-2xl bg-white px-6">
                <img src={t.logo} alt={t.name} class="max-h-11 w-auto max-w-full object-contain" loading="lazy" />
              </h3>
            ) : (
              <h3 class="font-serif text-4xl mb-5 text-balance">{t.name}</h3>
            )}
            <p class="text-sm text-black mb-6 flex-grow">{t.desc}</p>
            {t.perk && (
              <p class="mb-6 inline-flex items-center gap-2 self-start rounded-full bg-black px-4 py-2 text-xs font-semibold text-white">
                <span class="h-2 w-2 rounded-full bg-pink"></span>
                {t.perk}
              </p>
            )}
            <a href={t.url} target="_blank" rel="sponsored noopener" class="group inline-flex items-center gap-4 self-start rounded-full bg-white text-black pl-6 pr-2 py-2 text-[15px] font-semibold transition-transform duration-300 hover:-translate-y-1" aria-label={`Visit ${t.name} (affiliate link)`}>
              Visit now
              <span class="grid place-items-center h-10 w-10 rounded-full bg-pink text-white transition-colors duration-300 group-hover:bg-black"><svg viewBox="0 0 16 16" class="h-4 w-4 transition-transform duration-300 group-hover:rotate-45" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={arrow} /></svg></span>
            </a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- FREEBIE REVEAL: sits behind the footer and is uncovered at the very end of the page -->
  <FreebieReveal slot="reveal" />

</Layout>

<style>
  .fav-marquee { animation: fav-marquee 70s linear infinite; }
  @keyframes fav-marquee {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }
  .fav-pill {
    rotate: var(--r, 0deg);
    animation: fav-bob 5s ease-in-out infinite;
    animation-delay: var(--d, 0s);
    transition: scale 0.25s ease, box-shadow 0.25s ease;
  }
  .fav-pill:hover { scale: 1.12; box-shadow: 0 18px 40px rgba(240, 166, 255, 0.45); }
  @keyframes fav-bob {
    0%, 100% { translate: 0 0; }
    50% { translate: 0 -10px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .fav-marquee { animation: none; }
    .fav-pill { animation: none; }
  }
</style>
