---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Events | Kylie Kelly" description="Kylie Kelly's events are coming back in 2027. Pop your name on the list to hear when they're announced.">
  <section class="bg-black text-white px-6 py-24 text-center" style="background-color:#111;">
    <p class="text-pink text-xs uppercase tracking-widest font-normal mb-4">Events</p>
    <h1 class="text-4xl sm:text-5xl font-bold italic mb-8 max-w-2xl mx-auto leading-tight">
      Events are coming <span class="text-pink">back in 2027.</span>
    </h1>
    <p class="text-warmgray max-w-xl mx-auto mb-4">
      This page used to be home to my Empire Expansion event.
    </p>
    <p class="text-warmgray max-w-xl mx-auto mb-10">
      I'm bringing events back in 2027. If you'd like to hear when they're announced, pop your name on my list.
    </p>
    <a href="https://kyliekelly.myflodesk.com/audience" class="btn-pink">Get on the list →</a>
    <p class="text-sm mt-12">Cheering you on always, Kylie xx</p>
  </section>
</Layout>
