---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Page not found | Kylie Kelly" description="That page has moved or never existed. Here are the best places to start." noindex>

  <section class="bg-pink-light px-6 py-24 text-center">
    <p class="text-pink text-xs uppercase tracking-widest font-semibold mb-4">Page not found</p>
    <h1 class="font-serif italic text-4xl sm:text-5xl font-bold mb-6 max-w-2xl mx-auto">That page has wandered off.</h1>
    <p class="max-w-xl mx-auto text-lg mb-10">It might have moved when the site got a refresh. Here are the best places to pick things back up.</p>
    <div class="flex flex-wrap justify-center gap-4">
      <a href="/podcast" class="btn-primary">Listen to the podcast →</a>
      <a href="/blog" class="btn-outline">Read the blog</a>
      <a href="/" class="btn-outline">Back to the homepage</a>
    </div>
  </section>

</Layout>
