---
import Layout from '../layouts/Layout.astro';

const topics = [
  { title: 'Visibility Without Burnout: Strategic Growth for Women Who Want to Be Seen', desc: "What sustainable visibility really looks like, and why it's the key to audience and revenue growth for female founders done with the hustle." },
  { title: 'The RISE Framework\u2122: 4 Steps to Grow Your Audience & Authority Without Paid Ads', desc: 'The simple 4-part framework Kylie uses to help business owners grow audience, boost credibility, and create consistent income.' },
  { title: 'From Overlooked to In-Demand: List Building Strategies That Actually Convert', desc: 'How to attract the right people without social media burnout, build connection fast, and sell with ease.' },
  { title: "Let's Rethink Visibility: Why Showing Up More Isn't the Answer", desc: 'What intentional visibility looks like, and how to build brand recognition without sacrificing your sanity.' },
  { title: "Email Is Not Dead, It's Just Boring (Here's How to Fix It)", desc: 'A no-fluff take on how to write emails people actually want to read.' },
];
---
<Layout title="Press & Speaking | Kylie Kelly, Email Marketing Expert" description="Book Kylie Kelly for your podcast, summit or stage. Featured in Forbes and Business Insider.">

  <section class="bg-black text-white px-6 py-20 text-center">
    <h1 class="text-4xl sm:text-5xl font-bold mb-6 max-w-2xl mx-auto">A Trusted Voice On Sustainable Online Business &amp; Trust-Led Growth</h1>
    <a href="mailto:hello@kyliekelly.com" class="btn-pink">Invite Kylie to Speak →</a>
  </section>

  <section class="px-6 py-16">
    <div class="max-w-2xl mx-auto text-center">
      <p class="text-muted mb-8">
        Kylie Kelly is one of the leading voices on sustainable online business and relationship-led growth. She has built two multi six-figure businesses and brings more than a decade of experience across audience growth, visibility, and long-term business strategy. Host of The Email Growth Show, a top 1.5% podcast. Featured in Forbes, Authority Magazine, and Business Insider.
      </p>
      <div class="flex justify-center gap-4">
        <a href="https://drive.google.com/file/d/1c-2DqDiIy-NH_wC1hEy_n6MzjbRlrQV5/view" class="btn-outline text-xs !py-2 !px-5">Press Kit →</a>
        <a href="https://drive.google.com/drive/folders/1L1G8_h3uJ2fMgyV5oKA344Y6XuhJw-da" class="btn-outline text-xs !py-2 !px-5">Approved Photos →</a>
      </div>
    </div>
  </section>

  <section class="bg-offwhite px-6 py-16">
    <div class="max-w-3xl mx-auto">
      <h2 class="text-2xl font-bold text-center mb-10">Kylie's Signature Topics</h2>
      <div class="space-y-6">
        {topics.map((t) => (
          <div class="bg-white rounded-lg p-6">
            <p class="font-serif font-bold mb-2">{t.title}</p>
            <p class="text-sm text-muted">{t.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="px-6 py-16 text-center">
    <a href="mailto:hello@kyliekelly.com" class="btn-primary">Invite Kylie to Speak →</a>
  </section>

</Layout>
