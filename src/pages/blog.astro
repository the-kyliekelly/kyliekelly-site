---
import Layout from '../layouts/Layout.astro';
import RotatingBadge from '../components/RotatingBadge.astro';
import FreebieReveal from '../components/FreebieReveal.astro';
import allPosts from '../data/blog-posts.json';
import { getEpisodes } from '../lib/episodes';
import { blogCovers } from '../lib/blog';

const arrow = 'M4 12L12 4M5.5 4H12v6.5';
const playIcon = 'M5 3.5v9l7.5-4.5z';

// Blog posts are category 35. Podcast episodes (category 36) live in the episode library.
// Each post gets a cover image (the title graphic from the post) and a topic label: see src/lib/blog.ts.
const covers = blogCovers;

const clean = (html: string) => html.replace(/<[^>]+>/g, ' ').replace(/&[#\w]+;/g, ' ').replace(/\s+/g, ' ').trim();
const shorten = (text: string, max: number) => {
  const t = clean(text);
  if (t.length <= max) return t;
  return t.slice(0, max).replace(/\s+\S*$/, '') + '…';
};

const posts = allPosts
  .filter((p) => p.categories.includes(35) && covers[p.slug])
  .sort((a, b) => +new Date(b.date) - +new Date(a.date))
  .map((p) => ({
    slug: p.slug,
    title: p.title,
    href: `/${p.slug}/`,
    date: new Date(p.date).toLocaleDateString('en-AU', { day: 'numeric', month: 'short', year: 'numeric' }),
    excerpt: shorten(p.excerpt, 190),
    short: shorten(p.excerpt, 110),
    ...covers[p.slug],
  }));

const tileTint = ['bg-[#e9d9ec]', 'bg-[#fbe6f7]', 'bg-pink-light', 'bg-offwhite'];
const [featured, ...rest] = posts;

const pills = [
  { label: 'The blog', href: '#latest', dot: 'bg-pink text-white', active: true },
  { label: 'Podcast show notes', href: '/podcast/archive', dot: 'bg-pink-light text-black' },
  { label: 'Favorites', href: '/resources', dot: 'bg-[#e9d9ec] text-black' },
  { label: 'Free community', href: 'https://www.skool.com/email-marketing-skool/about', dot: 'bg-black text-white' },
];

// Topic filters: every topic that has a post, the busiest first.
const topicCounts = new Map<string, number>();
for (const p of posts) topicCounts.set(p.topic, (topicCounts.get(p.topic) ?? 0) + 1);
const topics = [...topicCounts.entries()].sort((x, y) => y[1] - x[1]).map(([t]) => t);

const episodes = (await getEpisodes()).slice(0, 3);
---
<Layout title="The Blog | Kylie Kelly" description="Email marketing, visibility and growing a business without living on social media. Practical posts from Kylie Kelly.">
  <link slot="head" rel="alternate" type="application/rss+xml" title="The Kylie Kelly Blog" href="/blog/rss.xml" />

  <section class="bg-pink-light px-6 py-4">
    <p class="max-w-4xl mx-auto flex items-center justify-center gap-4 text-xs sm:text-sm font-normal uppercase tracking-widest text-black text-center">
      <span class="hidden sm:block h-px flex-1 bg-black/30"></span>
      Wife. Mom of two boys. Email marketing educator. Host of The Email Growth Show.
      <span class="hidden sm:block h-px flex-1 bg-black/30"></span>
    </p>
  </section>

  <!-- HERO -->
  <section class="bg-offwhite px-6 pt-16 pb-24 sm:pt-24 sm:pb-32 text-center">
    <div class="max-w-4xl mx-auto">
      <p class="text-xs uppercase tracking-widest font-semibold mb-5">The blog</p>
      <h1 class="text-4xl sm:text-6xl lg:text-7xl font-bold leading-[1.05] text-balance mb-7">
        Welcome to the <span class="script-accent italic text-pink">Kylie Kelly</span> blog
      </h1>
      <p class="text-black max-w-xl mx-auto mb-10">
        Email marketing, visibility and growing a business without living on social media. Looking for the podcast? Every episode's show notes live in the episode library.
      </p>
      <form role="search" class="relative mx-auto mb-8 max-w-md" data-blog-search-form>
        <label for="blog-search-top" class="sr-only">Search the blog</label>
        <input id="blog-search-top" data-blog-search type="search" placeholder="Search the blog" autocomplete="off" class="w-full rounded-full border border-black bg-transparent px-7 py-4 pr-16 text-[13px] uppercase tracking-[0.2em] placeholder:text-black/50 focus:border-pink focus:outline-none focus:ring-1 focus:ring-pink" />
        <button type="submit" aria-label="Search" class="absolute right-5 top-1/2 -translate-y-1/2 text-pink transition-transform hover:translate-x-0.5"><svg viewBox="0 0 24 24" class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 12h16M14 6l6 6-6 6" /></svg></button>
      </form>
      <div class="flex flex-wrap justify-center gap-3">
        {pills.map((p) => (
          <a href={p.href} class={`group inline-flex items-center gap-4 rounded-full pl-6 pr-2 py-2 text-[15px] font-semibold shadow-[0_8px_30px_rgba(0,0,0,0.05)] transition-transform duration-300 hover:-translate-y-1 ${p.active ? 'bg-black text-white' : 'bg-white text-black'}`}>
            {p.label}
            <span class={`grid place-items-center h-10 w-10 rounded-full transition-colors duration-300 ${p.dot}`}><svg viewBox="0 0 16 16" class="h-4 w-4 transition-transform duration-300 group-hover:rotate-45" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={arrow} /></svg></span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- FEATURED POST -->
  {featured && (
    <section class="relative">
      <div class="grid md:grid-cols-2">
        <a href={featured.href} class="block bg-[#e9d9ec] overflow-hidden">
          <img src={featured.image} alt="" class="w-full h-full max-h-[560px] md:max-h-[680px] object-cover object-top" />
        </a>
        <div class="bg-black text-white flex flex-col justify-center px-8 sm:px-14 lg:px-20 py-16 sm:py-20">
          <p class="text-pink text-xs uppercase tracking-widest font-semibold mb-5">{featured.topic} · {featured.date}</p>
          <h2 class="font-serif text-3xl sm:text-4xl lg:text-5xl leading-tight text-balance mb-6">{featured.title}</h2>
          <p class="text-warmgray mb-9 max-w-md">{featured.excerpt}</p>
          <a href={featured.href} class="inline-block self-start rounded-full bg-[#e9d9ec] text-black px-7 py-3.5 text-[15px] font-semibold transition-transform duration-300 hover:-translate-y-1">Read the post</a>
        </div>
      </div>
      <RotatingBadge text="FEATURED POST • FEATURED POST • " fill="#e040fb" textColor="#fff" size={130} class="absolute -top-16 right-6 md:right-16 z-10" />
    </section>
  )}

  <!-- QUIZ BAND -->
  <section class="px-6 pt-24 pb-20 sm:pt-32 sm:pb-28">
    <div class="mx-auto grid max-w-6xl items-center gap-6 rounded-[2rem] bg-black px-8 py-10 text-white sm:px-14 md:grid-cols-[1fr_auto]">
      <div>
        <p class="font-serif text-3xl uppercase leading-[1.02] sm:text-5xl">What's your fastest way to grow your list?</p>
        <p class="mt-3 text-warmgray">Take the free quiz and find out. No social media needed.</p>
      </div>
      <a href="/guide" class="inline-block rounded-full bg-pink px-9 py-4 text-center text-sm font-semibold uppercase tracking-widest text-white transition duration-300 hover:-translate-y-1 hover:bg-white hover:text-black">Take the quiz →</a>
    </div>
  </section>

  <!-- ALL RECENT POSTS -->
  <section id="latest" class="scroll-mt-24 bg-white px-6 py-20 sm:py-28">
    <div class="mx-auto max-w-6xl">
      <p class="mb-3 text-center text-xs uppercase tracking-[0.3em] font-semibold">All recent posts</p>
      <h2 class="mb-8 text-center font-serif text-4xl font-bold italic sm:text-5xl" data-blog-heading>Everything on the blog</h2>
      <form role="search" class="relative mx-auto mb-8 max-w-md" data-blog-search-form>
        <label for="blog-search" class="sr-only">Search the blog</label>
        <input id="blog-search" data-blog-search type="search" placeholder="Search the blog" autocomplete="off" class="w-full rounded-full border border-black bg-white px-6 py-4 pr-14 text-[15px] focus:border-pink focus:outline-none focus:ring-1 focus:ring-pink" />
        <svg viewBox="0 0 20 20" class="pointer-events-none absolute right-5 top-1/2 h-5 w-5 -translate-y-1/2" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><circle cx="8.5" cy="8.5" r="5.5" /><path d="M13 13l4 4" /></svg>
      </form>
    <nav aria-label="Blog topics" class="mx-auto mb-14 hidden max-w-4xl flex-wrap justify-center gap-2" data-blog-filters>
      <button type="button" data-topic="" aria-pressed="true" class="blog-pill">All posts</button>
      {topics.map((t) => <button type="button" data-topic={t} aria-pressed="false" class="blog-pill">{t}</button>)}
    </nav>
      <div class="grid gap-x-6 gap-y-12 sm:grid-cols-2 lg:grid-cols-3" data-blog-grid>
        {posts.map((p, i) => (
          <>
          {i === 6 && (
            <div data-blog-promo class="sm:col-span-2 lg:col-span-3 grid items-center gap-6 rounded-[2rem] bg-[#e9d9ec] px-8 py-10 sm:px-14 md:grid-cols-[1fr_auto]">
              <div>
                <p class="font-serif text-3xl font-bold italic leading-tight sm:text-4xl">Want my Start Here email template?</p>
                <p class="mt-3 max-w-xl">It's the one email I use to welcome new subscribers, and it's yours free. Grab it and make it your own.</p>
              </div>
              <a href="/start" class="inline-block rounded-full bg-black px-9 py-4 text-center text-sm font-semibold uppercase tracking-widest text-white transition duration-300 hover:-translate-y-1 hover:bg-pink">Get the template →</a>
            </div>
          )}
          <a href={p.href} class="group block" data-topic={p.topic} data-search={`${p.title} ${p.short} ${p.topic}`.toLowerCase()}>
            <div class={`relative aspect-square overflow-hidden rounded-[1.5rem] ${tileTint[i % tileTint.length]} transition-transform duration-300 group-hover:-translate-y-1`}>
              <img src={p.image} alt="" class="h-full w-full object-cover object-top" loading="lazy" />
              <span class="absolute bottom-3 right-3 grid h-10 w-10 place-items-center rounded-full bg-white text-black shadow-md transition-colors duration-300 group-hover:bg-pink group-hover:text-white" aria-hidden="true"><svg viewBox="0 0 16 16" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d={arrow} /></svg></span>
            </div>
            <p class="mt-4 mb-1.5 text-[11px] uppercase tracking-widest font-semibold text-pink">{p.topic} · {p.date}</p>
            <h3 class="font-serif text-xl font-bold leading-snug text-balance transition-colors group-hover:text-pink">{p.title}</h3>
            <p class="mt-2 text-sm text-black/80">{p.short}</p>
          </a>
          </>
        ))}
      </div>
      <p class="mt-12 hidden text-center" data-blog-empty>Nothing on the blog matches that yet. <a href="/podcast/archive" class="font-semibold underline underline-offset-4 hover:text-pink">Try the episode library →</a></p>
    </div>
  </section>

  <!-- BEFORE YOU GET ANY FURTHER: full-width photo with the press logos in the same block -->
  <section class="bg-[#d5b9db]">
    <div class="relative overflow-hidden">
      <img src="/images/hero-8.jpg" alt="" aria-hidden="true" width="1200" height="1458" loading="lazy" class="absolute inset-0 h-full w-full object-cover object-[60%_24%]" />
      <div class="absolute inset-0 bg-[#d5b9db]/65 md:bg-transparent md:bg-[linear-gradient(90deg,#d5b9db_0%,rgba(213,185,219,0.9)_28%,rgba(213,185,219,0)_60%)]" aria-hidden="true"></div>
      <div class="relative mx-auto flex min-h-[560px] max-w-6xl flex-col justify-center px-6 py-20 sm:py-24 md:min-h-[720px]">
        <div class="max-w-xl">
          <h2 class="mb-6 font-serif italic text-4xl font-bold leading-tight sm:text-5xl">Before you get any further... Hi! I'm Kylie Kelly!</h2>
          <p class="mb-8 max-w-md">I'm an email marketing educator who grew my list from 0 to 7,000+ subscribers in 18 months without social media. My obsession is teaching you how to get known, trusted and selling, without the algorithm running your life. I'm glad you're here!</p>
          <a href="/meet-kylie" class="inline-block bg-black px-8 py-4 text-xs font-semibold uppercase tracking-widest text-white transition-colors hover:bg-pink">Meet Kylie →</a>
        </div>
      </div>
    </div>
    <div class="bg-gradient-to-r from-[#d5b9db] to-white">
    <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-center gap-x-12 gap-y-6 px-6 py-12">
      <p class="text-xs uppercase tracking-[0.25em] font-semibold">As seen in:</p>
      <img src="/images/press/forbes.png" alt="Forbes" loading="lazy" class="h-9 w-auto" />
      <img src="/images/press/business-insider.jpg" alt="Business Insider" loading="lazy" class="h-12 w-auto mix-blend-multiply" />
      <img src="/images/press/london-daily-news.png" alt="London Daily News" loading="lazy" class="h-9 w-auto mix-blend-multiply" />
      <img src="/images/press/business-mondays.jpg" alt="Business Mondays" loading="lazy" class="h-14 w-auto mix-blend-multiply" />
    </div>
    </div>
  </section>

  <!-- PREFER TO LISTEN -->
  {episodes.length > 0 && (
    <section class="relative overflow-hidden bg-black text-white px-6 py-20 sm:py-28">
      <img src="/images/podcast-cover.jpg" alt="" aria-hidden="true" class="absolute inset-0 h-full w-full scale-125 object-cover opacity-60 blur-2xl" />
      <div class="absolute inset-0 bg-gradient-to-b from-pink/50 via-black/35 to-black/60" aria-hidden="true"></div>
      <div class="relative max-w-2xl mx-auto">
        <p class="text-xs uppercase tracking-widest font-semibold text-center mb-3">Prefer to listen?</p>
        <h2 class="font-serif text-4xl sm:text-6xl uppercase text-center leading-[0.98] mb-12">Show notes<br />+ episodes</h2>
        <div class="space-y-4">
          {episodes.map((ep, i) => (
            <a href={ep.href} class="group flex items-center gap-4 sm:gap-5 rounded-full bg-white text-black p-3 pr-4 sm:pr-5 shadow-xl transition-transform duration-300 hover:-translate-y-1">
              <img src="/images/hero-1.jpg" alt="" class="h-16 w-16 sm:h-20 sm:w-20 flex-none rounded-full object-cover" loading="lazy" />
              <span class="flex-1 min-w-0">
                <span class="block text-[11px] uppercase tracking-widest font-semibold text-black/70 mb-1">Ep {ep.num}{ep.mins ? ` · ${ep.mins} min listen` : ''}</span>
                <span class="block font-semibold leading-snug text-[15px] sm:text-base">{ep.title}</span>
              </span>
              <span class={`grid place-items-center h-11 w-11 flex-none rounded-full transition-transform duration-300 group-hover:scale-110 ${['bg-pink text-white', 'bg-black text-white', 'bg-pink-light text-black'][i % 3]}`} aria-hidden="true"><svg viewBox="0 0 16 16" class="h-4 w-4" fill="currentColor"><path d={playIcon} /></svg></span>
            </a>
          ))}
        </div>
        <p class="text-center mt-12">
          <a href="/podcast/archive" class="font-serif text-xl underline underline-offset-4 decoration-white/40 hover:decoration-white">All episodes + show notes →</a>
        </p>
      </div>
    </section>
  )}

  <!-- FREEBIE REVEAL: sits behind the footer and is uncovered at the very end of the page -->
  <FreebieReveal slot="reveal" />

</Layout>

<style>
  .blog-pill {
    border: 1px solid #000;
    border-radius: 9999px;
    background: #fff;
    padding: 0.55rem 1.1rem;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    transition: background-color 0.2s, color 0.2s;
  }
  .blog-pill:hover { background: #f1d4f8; }
  .blog-pill[aria-pressed='true'] { background: #000; color: #fff; }
</style>

<script>
  // Search and topic filters for the post grid. Without script the filters stay hidden and every post shows.
  const grid = document.querySelector<HTMLElement>('[data-blog-grid]');
  const filters = document.querySelector<HTMLElement>('[data-blog-filters]');
  const inputs = [...document.querySelectorAll<HTMLInputElement>('input[data-blog-search]')];
  const input = inputs[0];
  const forms = [...document.querySelectorAll<HTMLFormElement>('[data-blog-search-form]')];
  const empty = document.querySelector<HTMLElement>('[data-blog-empty]');
  const heading = document.querySelector<HTMLElement>('[data-blog-heading]');

  if (grid && filters && input) {
    filters.classList.remove('hidden');
    filters.classList.add('flex');
    const cards = [...grid.querySelectorAll<HTMLElement>('a[data-topic]')];
    let topic = '';

    const apply = () => {
      const q = input.value.trim().toLowerCase();
      let shown = 0;
      for (const card of cards) {
        const ok = (!topic || card.dataset.topic === topic) && (!q || (card.dataset.search ?? '').includes(q));
        card.classList.toggle('hidden', !ok);
        if (ok) shown++;
      }
      empty?.classList.toggle('hidden', shown > 0);
      grid.querySelectorAll<HTMLElement>('[data-blog-promo]').forEach((el) => el.classList.toggle('hidden', Boolean(q || topic)));
      if (heading) heading.textContent = q || topic ? `${shown} ${shown === 1 ? 'post' : 'posts'}${topic ? ` in ${topic}` : ''}${q ? ` for "${input.value.trim()}"` : ''}` : 'Everything on the blog';
    };

    filters.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('button[data-topic]');
      if (!btn) return;
      topic = btn.dataset.topic ?? '';
      filters.querySelectorAll('button').forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
      apply();
    });
    // The search boxes at the top and above the posts share one search.
    for (const box of inputs) {
      box.addEventListener('input', () => {
        for (const other of inputs) if (other !== box) other.value = box.value;
        apply();
      });
    }
    for (const f of forms) {
      f.addEventListener('submit', (e) => {
        e.preventDefault();
        apply();
        document.getElementById('latest')?.scrollIntoView({ behavior: 'smooth' });
      });
    }
  }
</script>
