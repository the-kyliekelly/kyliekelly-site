</Layout>

<script define:vars={{ PRICE_RISES }}>
  // On 1 December the email system's price changes to $997 without needing a new build.
  if (Date.now() >= Date.parse(PRICE_RISES)) {
    document.querySelectorAll('[data-mmes-price]').forEach((el) => { el.textContent = '$997'; });
    document.querySelectorAll('[data-mmes-note]').forEach((el) => el.remove());
  }

  // The testimonial cards slide in from the sides when they scroll into view.
  const cards = document.querySelector('.svc-cards');
  if (cards && 'IntersectionObserver' in window && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    document.documentElement.classList.add('svc-js');
    const io = new IntersectionObserver((entries) => {
      entries.forEach((e) => {
        if (!e.isIntersecting) return;
        e.target.classList.add('is-in');
        io.unobserve(e.target);
      });
    }, { threshold: 0.35 });
    io.observe(cards);
  }
</script>

<style>
  .svc-card { rotate: var(--r, 0deg); }
  :global(.svc-js) .svc-card {
    opacity: 0;
    transition: opacity 0.8s ease, translate 1.1s cubic-bezier(0.2, 0.8, 0.2, 1), rotate 1.1s cubic-bezier(0.2, 0.8, 0.2, 1);
    rotate: 0deg;
  }
  :global(.svc-js) .svc-from-left { translate: -70vw 0; }
  :global(.svc-js) .svc-from-right { translate: 70vw 0; }
  :global(.svc-js) .svc-from-bottom { translate: 0 90px; transition-delay: 0.25s; }
  :global(.svc-js) .svc-cards.is-in .svc-card { opacity: 1; translate: 0 0; rotate: var(--r, 0deg); }
</style>
