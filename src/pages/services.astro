    transition-delay: calc(var(--i, 0) * 120ms);
  }
  :global(.svc-js) .svc-more.is-in .svc-mini { opacity: 1; translate: 0 0; }
  .svc-pop-btn { display: none; }
  :global(.svc-pop-js) .svc-pop-btn { display: inline-flex; cursor: pointer; }
  .svc-lbl-close { display: none; }
  [data-open] .svc-lbl-open { display: none; }
  [data-open] .svc-lbl-close { display: inline; }
  [data-open] .svc-plus-v { display: none; }
  :global(.svc-pop-js) .svc-pop { display: none; }
  :global(.svc-pop-js) [data-open] .svc-pop { display: block; }
  @media (min-width: 768px) {
    :global(.svc-pop-js) .svc-pop {
      display: block;
      position: absolute;
      top: 50%;
      width: calc(50% - 1.5rem);
      margin: 0;
      z-index: 20;
      opacity: 0;
      visibility: hidden;
      transform: translateY(-50%) translateX(var(--from, 0));
      transition: opacity 0.45s ease, transform 0.6s cubic-bezier(0.2, 0.8, 0.2, 1), visibility 0.45s;
    }
    .svc-pop-right { right: 0; --from: 40px; }
    .svc-pop-left { left: 0; --from: -40px; }
    :global(.svc-pop-js) [data-open] .svc-pop { opacity: 1; visibility: visible; transform: translateY(-50%) translateX(0); }
  }
  @media (prefers-reduced-motion: reduce) {
    :global(.svc-pop-js) .svc-pop { transition: none; }
  }
  .svc-ticker { animation: svc-ticker 110s linear infinite; }
  @keyframes svc-ticker {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }
  @media (prefers-reduced-motion: reduce) {
    .svc-ticker { animation: none; }
  }
  .svc-card { rotate: var(--r, 0deg); }
  :global(.svc-js) .svc-card {
    opacity: 0;
    transition: opacity 0.8s ease, translate 1.1s cubic-bezier(0.2, 0.8, 0.2, 1), rotate 1.1s cubic-bezier(0.2, 0.8, 0.2, 1);
    rotate: 0deg;
  }
  :global(.svc-js) .svc-from-left { translate: -70vw 0; }
  :global(.svc-js) .svc-from-right { translate: 70vw 0; }
  :global(.svc-js) .svc-from-bottom { translate: 0 90px; transition-delay: 0.25s; }
  :global(.svc-js) .svc-cards.is-in .svc-card { opacity: 1; translate: 0 0; rotate: var(--r, 0deg); }
</style>
