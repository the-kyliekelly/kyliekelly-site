---
import Layout from '../layouts/Layout.astro';
import InnerCircleWaitlist from '../components/InnerCircleWaitlist.astro';
import RotatingBadge from '../components/RotatingBadge.astro';
import FreebieReveal from '../components/FreebieReveal.astro';
import ArrowButton from '../components/ArrowButton.astro';
import TestimonialSlider from '../components/TestimonialSlider.astro';

const arrow = 'M4 12L12 4M5.5 4H12v6.5';

// The Money-Making Email System is $297 until 11:59pm US Eastern on 30 November, then $997.
// That moment is 3:59pm Sydney time on 1 December, the same moment the announcement bar hides.
// The page works this out when it is built, and a small script at the bottom keeps it right on the day.
const PRICE_RISES = '2026-12-01T15:59:00+11:00';
const earlyPrice = Date.now() < Date.parse(PRICE_RISES);

// The three steps, shown as a menu at the top of the page.
const menu = [
  { num: '01', title: 'Start for free', line: 'Take the 60-second quiz and join the free Email Marketing Skool community.', href: '#step-01', cta: 'See the details', tint: 'bg-white' },
  { num: '02', title: 'The Money-Making Email System', line: 'My signature email course: start, grow, nurture and sell, all in one place.', href: '#step-02', cta: 'See the details', tint: 'bg-white' },
  { num: '03', title: 'The KK Digital Product Shop', line: 'Grab-and-go courses, templates and trainings, plus the Coaching Group.', href: '#step-03', cta: 'Explore the shop', tint: 'bg-white' },
];

const stats = [
  { num: '7,000+', label: 'email subscribers in 18 months, without social media' },
  { num: '1,400+', label: 'women in Email Marketing Skool' },
  { num: 'Top 1.5%', label: 'podcast globally, The Email Growth Show' },
  { num: '130+', label: 'collaborations pitched, run or hosted since 2022' },
];

const offers = [
  {
    id: 'step-01',
    num: '01',
    eyebrow: 'Start here',
    title: 'Start for free',
    tag: 'Free \u00b7 60 seconds',
    desc: 'Take the Your Next 1,000 Subscribers quiz: 6 quick questions and you get the list-building strategy most likely to work for your business right now. Then come and join the free Email Marketing Skool community, where 1,400+ women are growing their lists without social media.',
    items: [],
    cta: 'Take the quiz',
    href: '/guide',
    cta2: { label: 'Join the free community', href: 'https://www.skool.com/email-marketing-skool/about' },
    image: 'freebie-mockup',
    imgW: 1000, imgH: 807, imgSizes: [600, 1000],
    alt: 'The Your Next 1000 Subscribers quiz on a desktop monitor',
    mockup: true,
    flip: false,
    bg: 'bg-white',
  },
  {
    id: 'step-02',
    num: '02',
    eyebrow: 'My signature email course',
    title: 'The Money-Making Email System',
    tag: '',
    desc: 'My signature email course for women who want more sales from their list without living on social media. Start, grow, nurture and sell, all in one place.',
    items: [
      'A quiz that points you to your part, plus a weekend Fast Track',
      'Email foundations, freebies and opt-ins',
      'List building with collaborations and search',
      'Nurture and selling, plus the automations worth having',
      'Advanced: bundles, summits, sponsored newsletters, launches and ads',
    ],
    presale: 'Pre-sale: the whole course opens 1 December. Pay in full or 3 x $99.',
    pop: { bg: 'bg-white', title: "A little bit about what's inside:" },
    cta: 'Get the Money-Making Email System',
    href: 'https://system.kyliekelly.com/join',
    image: 'mmes-checkout',
    imgW: 800, imgH: 788, imgSizes: [480, 800],
    alt: 'Kylie Kelly smiling in a bright pink top',
    flip: true,
    bg: 'bg-[#e9d9ec]',
  },
  {
    id: 'step-03',
    num: '03',
    eyebrow: 'Grab what you need, start today',
    title: 'The KK Digital Product Shop',
    tag: 'Grab and go',
    desc: 'Courses, templates and trainings for growing your email list without social media. Pick the one thing you need and put it to work today, from my 50 a Day list growth system to the Coaching Group.',
    items: [
      '50 a Day, my no-social email list growth system',
      'Templates and trainings you can put to work the same day',
      'The Coaching Group: weekly voice-note coaching, straight to your phone',
    ],
    pop: { bg: 'bg-[#e9d9ec]', title: "A little bit about what's in the shop:" },
    cta: 'Explore the shop',
    href: 'https://shop.kyliekelly.com/',
    image: 'shop-mockup',
    imgW: 800, imgH: 800, imgSizes: [480, 800],
    alt: 'The KK Digital Product Shop preview',
    flip: false,
    bg: 'bg-white',
    quote: { text: "I legitimately feel my shoulders drop every time I listen to one of your Voxer responses… I don't need to do everything, I just need to do the next right thing.", name: 'Nicole Elliott, in the Coaching Group' },
  },
];

const ticker = ['No algorithm required', 'Email lists', 'Real relationships', 'Rooms worth being in', 'Relationships over algorithms'];

const faqs = [
  {
    q: 'Which one should I start with?',
    a: "Start with the quiz. It takes about a minute and points you to the list-building strategy that fits your business right now. If you're ready to build the whole system, go for the Money-Making Email System. If you just need one thing, or want me in your corner every week, explore the shop.",
  },
  {
    q: 'Do I need to be on social media to grow my email list?',
    a: 'No. Everything I teach is built around growing your email list and selling to it without relying on social media. I grew my own list from zero to 7,000+ subscribers in 18 months that way.',
  },
  {
    q: "What's the Money-Making Email System?",
    a: "It's my signature email marketing course. It takes you through starting, growing, nurturing and selling to your email list in one place, built on collaborations and relationships instead of the algorithm.",
  },
  {
    q: "What's in the shop?",
    a: 'Grab-and-go courses, templates and trainings for growing your list without social media. The big ones are 50 a Day ($27), my system for growing your list by 50 new subscribers a day, and the Coaching Group, weekly voice-note coaching straight to your phone.',
  },
  {
    q: 'What is the Inner Circle?',
    a: "It's my higher-touch group, opening in early 2027: a whole year of deeper support, actual implementation and a small group of women to do it with. You also get every course in my shop while you're in. It isn't open yet, so pop your name on the waitlist and I'll email you the second I can tell you more.",
  },
];

// Structured data so Google can show the page properly: the questions above, the course, and where this page sits on the site.
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Course',
    name: 'The Money-Making Email System',
    description: 'An email marketing course for women who want more sales from their list without living on social media. Start, grow, nurture and sell, all in one place.',
    provider: { '@type': 'Person', name: 'Kylie Kelly', url: 'https://kyliekelly.com/meet-kylie' },
    url: 'https://system.kyliekelly.com/join',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://kyliekelly.com/' },
      { '@type': 'ListItem', position: 2, name: 'Work With Me', item: 'https://kyliekelly.com/services' },
    ],
  },
];

---
<Layout title="Email Marketing Course & Ways to Work With Me | Kylie Kelly" description="Start with a free list-building quiz, join the Money-Making Email System course, or grab a shop template. Grow your email list without social media.">
  <Fragment slot="head">
    {jsonLd.map((d) => <script type="application/ld+json" set:html={JSON.stringify(d)} />)}
  </Fragment>

  <!-- HERO: the three steps as a menu -->
  <section class="relative overflow-hidden bg-gradient-to-b from-[#fbe6f7] via-white to-white px-6 pt-10 pb-14 sm:pt-14 sm:pb-24">
    <div class="mx-auto max-w-6xl text-center">
      <div class="mx-auto mb-5 h-20 w-20">
        <img src="/images/responsive/kylie-headshot-160.webp" srcset="/images/responsive/kylie-headshot-160.webp 160w, /images/responsive/kylie-headshot-320.webp 320w" sizes="80px" width="160" height="240" alt="Kylie Kelly smiling, sitting in a chair wearing a lilac top" class="h-full w-full rounded-full object-cover object-[50%_25%]" decoding="async" />
      </div>
      <p class="mb-4 text-xs font-semibold uppercase tracking-widest text-pink">&mdash; Ways to work with me &mdash;</p>
      <h1 class="font-serif text-[clamp(2.5rem,6.2vw,5rem)] leading-[0.98] text-balance">
        Where do you want to <span class="script-accent italic text-pink">start</span>?
      </h1>
      <p class="mx-auto mt-5 max-w-2xl text-lg text-black">I teach women how to grow an email list and sell to it without social media. I grew mine to 7,000+ subscribers in 18 months that way. Pick the step that fits where your business is at today, no wrong step, promise.</p>

      <div class="mt-8 grid gap-3 text-left sm:gap-5 md:grid-cols-3">
        {menu.map((m) => (
          <a href={m.href} class={`group flex items-start gap-4 rounded-[2rem] border border-black ${m.tint} p-5 shadow-[0_18px_50px_rgba(0,0,0,0.08)] transition duration-300 hover:-translate-y-2 hover:bg-[#fbe6f7] hover:shadow-[0_26px_60px_rgba(224,64,251,0.28)] md:flex-col md:items-stretch md:gap-0 md:p-7`}>
            <span class="grid h-11 w-11 flex-none place-items-center rounded-full bg-pink font-serif text-lg italic text-white transition duration-300 group-hover:rotate-[-8deg] group-hover:scale-110 group-hover:bg-black md:mb-4" aria-hidden="true">{m.num}</span>
            <div class="flex min-w-0 flex-1 flex-col">
              <p class="mb-2 font-serif text-xl leading-tight text-balance md:mb-3 md:text-2xl">{m.title}</p>
              <p class="mb-3 flex-grow text-[15px] text-black md:mb-5">{m.line}</p>
              <span class="inline-flex items-center gap-3 text-[15px] font-semibold">
                {m.cta}
                <span class="grid h-10 w-10 place-items-center rounded-full bg-black text-white transition-colors duration-300 group-hover:bg-pink"><svg viewBox="0 0 16 16" class="h-4 w-4 transition-transform duration-300 group-hover:rotate-45" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={arrow} /></svg></span>
              </span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- SCROLLING BAR -->
  <section class="overflow-hidden bg-black py-5 text-white sm:py-6" aria-hidden="true">
    <div class="svc-ticker flex w-max">
      {[0, 1].map(() => (
        <div class="flex flex-none items-center">
          {[0, 1, 2].map(() => ticker.map((t) => (
            <span class="flex items-center whitespace-nowrap font-serif text-2xl uppercase tracking-wide sm:text-3xl">
              {t}
              <span class="mx-6 text-pink sm:mx-8">&#10022;</span>
            </span>
          )))}
        </div>
      ))}
    </div>
  </section>

  <!-- THE THREE STEPS -->
  {offers.map((o) => (
    <section id={o.id} class={`${o.bg} px-6 py-16 sm:py-24 scroll-mt-20`}>
      <div class="relative max-w-5xl mx-auto grid md:grid-cols-2 gap-10 md:gap-16 items-center">
        <div class={`flex justify-center ${o.flip ? 'md:order-2' : ''}`}>
          <div class="relative w-full max-w-sm">
            {o.mockup ? (
              <div class="relative">
                <div class="pointer-events-none absolute inset-x-[6%] inset-y-[8%] rounded-full bg-[#fbe6f7] blur-3xl" aria-hidden="true"></div>
                <img src={`/images/responsive/${o.image}-${o.imgSizes[1]}.webp`} srcset={o.imgSizes.map((w) => `/images/responsive/${o.image}-${w}.webp ${w}w`).join(', ')} sizes="(min-width: 768px) 384px, 90vw" width={o.imgW} height={o.imgH} alt={o.alt} class="relative block h-auto w-full" loading="lazy" decoding="async" />
              </div>
            ) : (
              <img src={`/images/responsive/${o.image}-${o.imgSizes[1]}.webp`} srcset={o.imgSizes.map((w) => `/images/responsive/${o.image}-${w}.webp ${w}w`).join(', ')} sizes="(min-width: 768px) 384px, 90vw" width={o.imgW} height={o.imgH} alt={o.alt} class="h-auto w-full rounded-[2rem] shadow-[0_20px_50px_rgba(0,0,0,0.12)]" loading="lazy" decoding="async" />
            )}
            <span class="absolute -top-5 -left-3 sm:-left-6 grid place-items-center h-16 w-16 sm:h-20 sm:w-20 rounded-full bg-pink text-white font-serif italic text-2xl sm:text-3xl shadow-lg" aria-hidden="true">{o.num}</span>
          </div>
        </div>
        <div class={o.flip ? 'md:order-1' : ''}>
          <p class="text-pink text-xs uppercase tracking-widest font-semibold mb-3">{o.eyebrow}</p>
          <h2 class="text-3xl sm:text-4xl font-bold mb-4 text-balance">{o.title}</h2>
          {o.id === 'step-02' ? (
            <p class="mb-6 flex flex-col items-start gap-3">
              <span class="inline-block rounded-full border border-black px-4 py-1.5 text-xs uppercase tracking-widest font-semibold" data-mmes-price>{earlyPrice ? '$297' : '$997'}</span>
              {earlyPrice && <span class="text-xs font-semibold uppercase tracking-widest text-pink sm:text-sm" data-mmes-note>Through November, then $997 from 1 December.</span>}
            </p>
          ) : (
            <p class="inline-block rounded-full border border-black px-4 py-1.5 text-xs uppercase tracking-widest font-semibold mb-6">{o.tag}</p>
          )}
          <p class="text-black mb-6">{o.desc}</p>
          {o.items.length > 0 && (
            <>
              <button type="button" data-pop-btn aria-expanded="false" aria-controls={`pop-${o.id}`} class="svc-pop-btn mb-8 items-center gap-3 text-lg font-semibold sm:text-xl">
                <span class="svc-lbl-open">The details</span>
                <span class="svc-lbl-close">Close details</span>
                <span class={`grid h-11 w-11 place-items-center rounded-full text-black ${o.bg === 'bg-[#e9d9ec]' ? 'bg-white' : 'bg-[#e9d9ec]'}`}><svg viewBox="0 0 16 16" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><path d="M3 8h10" /><path class="svc-plus-v" d="M8 3v10" /></svg></span>
              </button>
              <div id={`pop-${o.id}`} class={`svc-pop mb-8 rounded-[2rem] p-7 shadow-[0_24px_60px_rgba(0,0,0,0.14)] sm:p-9 ${o.pop.bg} ${o.flip ? 'svc-pop-right' : 'svc-pop-left'}`}>
                <h3 class="mb-5 font-serif text-2xl leading-tight text-balance sm:text-3xl">{o.pop.title}</h3>
                <ul class="space-y-2.5 text-base">
                  {o.items.map((item) => <li class="flex gap-3"><span class="text-pink" aria-hidden="true">&#9679;</span><span>{item}</span></li>)}
                  {o.presale && earlyPrice && <li class="flex gap-3" data-mmes-note><span class="text-pink" aria-hidden="true">&#9679;</span><span class="font-semibold">{o.presale}</span></li>}
                </ul>
                <div class="mt-6 flex justify-end"><ArrowButton href={o.href} label={o.cta} variant="dark" /></div>
              </div>
            </>
          )}
          {o.quote && (
            <blockquote class="mb-8 border-l-2 border-pink pl-5">
              <p class="font-serif text-lg italic leading-snug text-balance">&ldquo;{o.quote.text}&rdquo;</p>
              <footer class="mt-3 text-xs uppercase tracking-widest font-semibold">{o.quote.name}</footer>
            </blockquote>
          )}
          <div class="flex flex-col items-start gap-5 sm:flex-row sm:items-center">
            <ArrowButton href={o.href} label={o.cta} variant="dark" />
            {o.cta2 && <a href={o.cta2.href} target="_blank" rel="noopener" class="font-semibold underline decoration-pink decoration-2 underline-offset-4 transition-colors hover:decoration-black">{o.cta2.label}</a>}
          </div>
        </div>
      </div>
    </section>
  ))}

  <!-- THE INNER CIRCLE -->
  <section class="relative overflow-hidden bg-black px-6 py-20 text-white sm:py-28">
    <div class="pointer-events-none absolute left-[-10%] top-1/2 h-[70%] w-[60%] -translate-y-1/2 rounded-full bg-pink/25 blur-[130px]" aria-hidden="true"></div>
    <div class="pointer-events-none absolute right-[-10%] bottom-[-20%] h-[60%] w-[45%] rounded-full bg-[#e9d9ec]/10 blur-[120px]" aria-hidden="true"></div>
    <div class="relative mx-auto grid max-w-6xl items-center gap-14 md:grid-cols-[0.85fr_1.15fr] md:gap-20">
      <div class="relative mx-auto w-full max-w-sm">
        <div class="aspect-[4/5] overflow-hidden rounded-t-full border border-white/20 p-2">
          <img src="/images/responsive/kylie-podcast-800.webp" srcset="/images/responsive/kylie-podcast-480.webp 480w, /images/responsive/kylie-podcast-800.webp 800w" sizes="(min-width: 768px) 384px, 90vw" width="800" height="800" alt="Kylie Kelly smiling, resting her chin on her hand" class="h-full w-full rounded-t-full object-cover object-[50%_25%]" loading="lazy" decoding="async" />
        </div>
        <RotatingBadge text="COMING EARLY 2027 • COMING EARLY 2027 •" size={130} class="absolute -right-4 bottom-8 sm:-right-10" />
      </div>
      <div class="text-center md:text-left">
        <p class="mb-5 text-xs font-semibold uppercase tracking-[0.3em] text-pink">&#10022; Coming early 2027 &#10022;</p>
        <h2 class="font-serif text-[clamp(3rem,7.5vw,6rem)] leading-[0.95]">
          The <span class="italic text-pink">Inner</span> Circle
        </h2>
        <p class="mx-auto mt-7 max-w-lg font-serif text-2xl italic leading-snug text-balance md:mx-0 sm:text-3xl">A whole year of not building this on your own.</p>
        <p class="mx-auto mt-6 max-w-lg text-warmgray sm:text-lg md:mx-0">If you're a coach, course creator or service provider and you're ready for <strong class="text-white">more</strong> of me, with deeper support, actual implementation and a small group of women to do it with, this is it.</p>
        <p class="mx-auto mt-4 max-w-lg text-warmgray sm:text-lg md:mx-0">You also get every course in my shop while you're in, including the new ones I create along the way.</p>
        <p class="mx-auto mt-4 max-w-lg font-semibold text-white sm:text-lg md:mx-0">Doors open early 2027. Pop your name on the waitlist and I'll email you the second I can tell you more.</p>
        <InnerCircleWaitlist />
      </div>
    </div>
  </section>

  <!-- RESULTS: the same testimonial slider as the homepage -->
  <TestimonialSlider />

  <!-- THE STATEMENT, THE NUMBERS AND A BIG PHOTO -->
  <section class="bg-black px-6 pt-4 text-center text-white sm:pt-8">
    <div class="mx-auto max-w-4xl">
      <p class="mb-6 font-semibold text-pink sm:text-lg">You're in the right place, babe.</p>
      <h2 class="font-serif text-[clamp(2.25rem,6vw,4.75rem)] leading-[1.02] text-balance">
        I don't think you need another strategy. I think you need the <span class="italic text-pink">right one</span> for right now.
      </h2>
      <p class="mx-auto mt-8 max-w-2xl text-warmgray sm:text-lg">Whichever step you pick, you don't have to figure this out alone anymore. Start where you're at, and move to the next step when you're ready, not before.</p>
      <dl class="mt-16 grid grid-cols-2 gap-x-6 gap-y-10 text-center lg:grid-cols-4">
        {stats.map((st) => (
          <div>
            <dt class="font-serif text-4xl font-bold text-white sm:text-5xl">{st.num}</dt>
            <dd class="mx-auto mt-3 max-w-[16rem] text-sm leading-snug text-warmgray">{st.label}</dd>
          </div>
        ))}
      </dl>
    </div>
    <img src="/images/responsive/hero-8-800.webp" srcset="/images/responsive/hero-8-480.webp 480w, /images/responsive/hero-8-800.webp 800w" sizes="(min-width: 1152px) 1152px, 100vw" width="800" height="972" alt="Kylie Kelly relaxing in a chair holding a disco ball and a glass of rosé" class="mx-auto mt-16 h-[320px] w-full max-w-6xl rounded-t-[2.5rem] object-cover object-[50%_32%] sm:h-[460px]" loading="lazy" decoding="async" />
  </section>

  <!-- KEEP LEARNING: free places to start -->
  <section class="bg-offwhite px-6 py-16 sm:py-20">
    <div class="mx-auto max-w-4xl text-center">
      <p class="mb-3 text-xs font-semibold uppercase tracking-widest text-pink">&mdash; Not ready to buy yet? &mdash;</p>
      <h2 class="mb-8 text-3xl font-bold text-balance sm:text-4xl">Learn with me for free.</h2>
      <div class="grid gap-4 text-left sm:grid-cols-3">
        <a href="/email-marketing-for-small-business/" class="group rounded-[1.75rem] border border-black/20 bg-white p-6 transition duration-300 hover:-translate-y-1 hover:border-pink">
          <p class="mb-2 font-serif text-xl leading-tight">Email marketing for small business</p>
          <p class="text-[15px]">My beginner's guide: what to do first, in the order I'd do it.</p>
        </a>
        <a href="/grow-email-list-without-instagram-ads/" class="group rounded-[1.75rem] border border-black/20 bg-white p-6 transition duration-300 hover:-translate-y-1 hover:border-pink">
          <p class="mb-2 font-serif text-xl leading-tight">Grow your list without social media</p>
          <p class="text-[15px]">The full guide to building a list without Instagram or paid ads.</p>
        </a>
        <a href="/podcast" class="group rounded-[1.75rem] border border-black/20 bg-white p-6 transition duration-300 hover:-translate-y-1 hover:border-pink">
          <p class="mb-2 font-serif text-xl leading-tight">The Email Growth Show</p>
          <p class="text-[15px]">My weekly podcast on growing and selling to your email list.</p>
        </a>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="px-6 py-20 sm:py-28">
    <div class="max-w-3xl mx-auto">
      <p class="text-pink text-xs uppercase tracking-widest font-semibold mb-3 text-center">&mdash; Good to know &mdash;</p>
      <h2 class="text-3xl sm:text-4xl font-bold text-center mb-12">Questions you might have.</h2>
      <div class="space-y-3">
        {faqs.map((f) => (
          <details class="group rounded-[1.75rem] border border-black/20 open:border-pink transition-colors">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 px-6 py-4 font-semibold [&::-webkit-details-marker]:hidden">
              <span>{f.q}</span>
              <span class="grid place-items-center h-9 w-9 flex-none rounded-full bg-pink text-white transition-transform duration-300 group-open:rotate-90"><svg viewBox="0 0 16 16" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4" /></svg></span>
            </summary>
            <p class="px-6 pb-6 text-black">{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- FREEBIE REVEAL: sits behind the footer and is uncovered at the very end of the page -->
  <FreebieReveal slot="reveal" />

</Layout>

<script define:vars={{ PRICE_RISES }}>
  // On 1 December the email system's price changes to $997 without needing a new build.
  if (Date.now() >= Date.parse(PRICE_RISES)) {
    document.querySelectorAll('[data-mmes-price]').forEach((el) => { el.textContent = '$997'; });
    document.querySelectorAll('[data-mmes-note]').forEach((el) => el.remove());
  }

  // "The details" opens a card over the photo (and closes again). Without JavaScript the card just shows in full.
  document.documentElement.classList.add('svc-pop-js');
  const closePop = (sec) => {
    sec.removeAttribute('data-open');
    const b = sec.querySelector('[data-pop-btn]');
    if (b) b.setAttribute('aria-expanded', 'false');
  };
  document.querySelectorAll('[data-pop-btn]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const sec = btn.closest('section');
      const open = sec.toggleAttribute('data-open');
      btn.setAttribute('aria-expanded', String(open));
    });
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') document.querySelectorAll('section[data-open]').forEach(closePop);
  });
</script>

