---
import Layout from '../layouts/Layout.astro';
import Highlight from '../components/Highlight.astro';
import FreebieReveal from '../components/FreebieReveal.astro';

const arrow = 'M4 12L12 4M5.5 4H12v6.5';

// The Money Making Email System is $297 through November and $997 from 1 December (Sydney time).
// The page works this out when it is built, and a small script at the bottom keeps it right on the day.
const PRICE_RISES = '2026-12-01T00:00:00+11:00';
const earlyPrice = Date.now() < Date.parse(PRICE_RISES);

// The Inner Circle waitlist: paste the Flodesk form or signup link here and a "Join the waitlist" button appears on its card.
const INNER_CIRCLE_WAITLIST = '';

// The three steps, shown as a menu at the top of the page.
const menu = [
  { num: '01', title: 'Email Marketing Skool', price: 'Free', line: 'Your 90-day growth plan and the Email Marketing Starter Kit, free on joining.', href: '#step-01', tint: 'bg-white' },
  { num: '02', title: 'The Money Making Email System', price: 'mmes', line: 'My signature email course: start, grow, nurture and sell, all in one place.', href: '#step-02', tint: 'bg-white' },
  { num: '03', title: 'Coaching Group', price: '$297 one time', line: 'Weekly voice-note coaching for the real questions, straight to your phone.', href: '#step-03', tint: 'bg-white' },
];

// Real client words, taken from what clients sent. The big number is lifted straight from each quote.
const results = [
  {
    big: '122 new subscribers',
    quote: 'I went from stuck and overwhelmed to 122 new subscribers, in just days of working with Kylie (all without social media!!) She is great at what she does!!',
    name: 'Erin K.',
    card: 'bg-[#e9d9ec] text-black',
    from: 'left',
    rot: '-5deg',
  },
  {
    big: '45 to nearly 800',
    quote: "I've gone from 45 to currently just under 800 active subscribers in less than a month!",
    name: 'Amy G.',
    card: 'bg-pink text-white',
    from: 'bottom',
    rot: '3deg',
  },
  {
    big: '231 to 643',
    quote: 'I started with 231 people before I met you and now my email list is currently 643 with 412 new subscribers 🎉',
    name: 'Celia V.',
    card: 'bg-[#fbe6f7] text-black',
    from: 'right',
    rot: '-2deg',
  },
];

const stats = [
  { num: '7,000+', label: 'email subscribers in 18 months, without social media' },
  { num: '1,400+', label: 'women in Email Marketing Skool' },
  { num: 'Top 1.5%', label: 'podcast globally, The Email Growth Show' },
  { num: '130+', label: 'collaborations pitched, run or hosted since 2022' },
];

const offers = [
  {
    id: 'step-01',
    num: '01',
    eyebrow: 'Start for free',
    title: 'Email Marketing Skool',
    tag: 'Free',
    desc: "For online business owners who want more sales from an email list, without living on social media. Inside, you'll learn how to grow an email list of the right people, find collaborations that bring warm subscribers, turn subscribers into buyers, and build visibility without constant posting.",
    items: [
      'A simple 90-day growth plan',
      'The Email Marketing Starter Kit, free on joining',
      'A free community of 1,400+ women doing the same work',
    ],
    cta: 'Join Email Marketing Skool',
    href: 'https://www.skool.com/email-marketing-skool/about',
    image: '/images/hero-8.jpg',
    alt: 'Kylie Kelly',
    flip: false,
    bg: 'bg-white',
  },
  {
    id: 'step-02',
    num: '02',
    eyebrow: 'My signature email course',
    title: 'The Money Making Email System',
    tag: '',
    desc: 'My signature email course for women who want more sales from their list without living on social media. Start, grow, nurture and sell, all in one place.',
    items: [
      'Start, grow, nurture and sell, all in one system',
      'Built on collaborations and relationships, not the algorithm',
    ],
    cta: 'Get the Money Making Email System',
    href: 'https://system.kyliekelly.com/join',
    image: '/images/classics-kylie.jpg',
    alt: 'Kylie Kelly in a sparkly jacket holding a microphone',
    flip: true,
    bg: 'bg-offwhite',
  },
  {
    id: 'step-03',
    num: '03',
    eyebrow: 'Get my brain in your corner',
    title: 'Coaching Group',
    tag: '$297 one time',
    desc: 'Weekly voice-note coaching for the real questions, offer clarity, launch strategy, what to prioritize when everything feels urgent. Real questions, real answers, all week long, straight to your phone.',
    items: [],
    cta: 'Join the Coaching Group',
    href: 'https://coaching.kyliekelly.com/checkout',
    image: '/images/desk-scene.jpg',
    alt: '',
    flip: false,
    bg: 'bg-white',
    quote: { text: "I legitimately feel my shoulders drop every time I listen to one of your Voxer responses… I don't need to do everything, I just need to do the next right thing.", name: 'Nicole Elliott' },
  },
];

const faqs = [
  {
    q: 'Which one should I start with?',
    a: "Most people start with step one, the free Email Marketing Skool community. You get the 90-day growth plan and the starter kit before you spend a thing. If you're ready to build the whole system, go for the Money Making Email System. If you want me in your corner every week, join the coaching group. Still not sure? Take the quiz.",
  },
  {
    q: 'Do I need to be on social media?',
    a: 'No. Everything I teach is built around growing your email list and selling to it without relying on social media.',
  },
  {
    q: "What's the Money Making Email System?",
    a: "It's my signature email course. It takes you through starting, growing, nurturing and selling to your email list in one place, built on collaborations and relationships instead of the algorithm.",
  },
  {
    q: 'How does the coaching group work?',
    a: 'It is weekly voice-note coaching. You bring me the real questions, offer clarity, launch strategy, what to prioritize when everything feels urgent, and I answer them all week long, straight to your phone. It is a one-time payment of $297.',
  },
  {
    q: "What's in the shop?",
    a: 'Grab-and-go courses, templates and trainings, starting at a $17 collaboration database. The big one is 50 a Day ($27), my system for growing your list by 50 new subscribers a day.',
  },
  {
    q: 'What is the Inner Circle?',
    a: "It's my higher-touch group, opening in early 2027: 12 months with the most support I'm going to give, for $6k. It isn't open yet, so for now these steps are exactly where I'm putting my energy.",
  },
];

---
<Layout title="Work With Me | Kylie Kelly" description="Three ways to work with Kylie Kelly, whichever step fits where your business is at right now. No algorithm required.">

  <!-- TAG BAR -->
  <section class="bg-black text-white px-6 py-4 border-b border-white/15">
    <p class="max-w-4xl mx-auto flex items-center justify-center gap-4 text-xs sm:text-sm font-normal uppercase tracking-widest text-white text-center">
      <span class="hidden sm:block h-px flex-1 bg-white/30"></span>
      Three ways to work with me. No algorithm required.
      <span class="hidden sm:block h-px flex-1 bg-white/30"></span>
    </p>
  </section>

  <!-- HERO: the three steps as a menu -->
  <section class="relative overflow-hidden bg-gradient-to-b from-[#fbe6f7] via-white to-white px-6 pt-10 pb-14 sm:pt-12 sm:pb-20">
    <div class="mx-auto max-w-6xl text-center">
      <div class="mx-auto mb-6 h-20 w-20">
        <img src="/images/kylie-headshot.jpg" alt="Kylie Kelly smiling, sitting in a chair wearing a lilac top" class="h-full w-full rounded-full object-cover object-[50%_25%]" />
      </div>
      <p class="mb-4 text-xs font-semibold uppercase tracking-widest text-pink">&mdash; Ways to work with me &mdash;</p>
      <h1 class="font-serif text-[clamp(2.5rem,6.2vw,5rem)] leading-[0.98] text-balance">
        Where do you want to <span class="script-accent italic text-pink">start</span>?
      </h1>
      <p class="mx-auto mt-4 max-w-xl text-lg text-black">Three ways to work with me, whichever fits where your business is at today. No wrong step, promise.</p>

      <div class="mt-8 grid gap-5 text-left md:grid-cols-3">
        {menu.map((m) => (
          <a href={m.href} class={`group flex flex-col rounded-[2rem] ${m.tint} p-6 shadow-[0_18px_50px_rgba(0,0,0,0.08)] transition-transform duration-300 hover:-translate-y-1.5 sm:p-7`}>
            <span class="mb-4 grid h-11 w-11 place-items-center rounded-full bg-pink font-serif text-lg italic text-white" aria-hidden="true">{m.num}</span>
            <h2 class="mb-3 font-serif text-2xl leading-tight text-balance">{m.title}</h2>
            <p class="mb-5">
              <span class="inline-block rounded-full border border-black px-3.5 py-1 text-xs font-semibold uppercase tracking-widest" {...(m.price === 'mmes' ? { 'data-mmes-price': '' } : {})}>{m.price === 'mmes' ? (earlyPrice ? '$297' : '$997') : m.price}</span>
            </p>
            <p class="mb-5 flex-grow text-[15px] text-black">{m.line}</p>
            <span class="inline-flex items-center gap-3 text-[15px] font-semibold">
              See the details
              <span class="grid h-10 w-10 place-items-center rounded-full bg-black text-white transition-colors duration-300 group-hover:bg-pink"><svg viewBox="0 0 16 16" class="h-4 w-4 transition-transform duration-300 group-hover:rotate-45" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={arrow} /></svg></span>
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- NOT SURE? THE QUIZ -->
  <section class="px-6 pb-20 sm:pb-28">
    <div class="mx-auto grid max-w-5xl items-center gap-10 rounded-[2.5rem] bg-[#fbe6f7] p-8 sm:p-12 md:grid-cols-2 md:gap-14 lg:p-16">
      <div class="relative mx-auto w-full max-w-[260px] sm:max-w-sm md:max-w-none">
        <div class="pointer-events-none absolute inset-x-[6%] inset-y-[8%] rounded-full bg-white/90 blur-3xl" aria-hidden="true"></div>
        <img src="/images/freebie-mockup.png" alt="The Your Next 1000 Subscribers quiz on a desktop monitor" class="relative block h-auto w-full drop-shadow-[0_0_26px_rgba(255,255,255,0.95)]" loading="lazy" />
        <span class="absolute -top-2 right-0 inline-flex items-center gap-2 rounded-full bg-white px-4 py-2 text-xs font-semibold text-black shadow-lg sm:text-sm">
          <span class="h-2.5 w-2.5 rounded-full bg-pink"></span>
          Free &middot; 60 seconds
        </span>
      </div>
      <div class="text-center md:text-left">
        <p class="mb-3 text-xs font-semibold uppercase tracking-widest">Not sure where to start?</p>
        <h2 class="mb-4 font-serif text-4xl italic leading-tight text-balance sm:text-5xl">Take the quiz.</h2>
        <p class="mb-8 text-black sm:text-lg">
          Answer 6 quick questions and get the list-building strategy most likely to work for your business right now. Then pick the step below that fits.
        </p>
        <a href="/guide" class="group inline-flex items-center gap-4 rounded-full bg-black pl-7 pr-2 py-2 text-[15px] font-semibold text-white transition-transform duration-300 hover:-translate-y-1">
          Take the quiz
          <span class="grid h-10 w-10 place-items-center rounded-full bg-pink text-white transition-colors duration-300 group-hover:bg-white group-hover:text-black"><svg viewBox="0 0 16 16" class="h-4 w-4 transition-transform duration-300 group-hover:rotate-45" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={arrow} /></svg></span>
        </a>
      </div>
    </div>
  </section>

  <!-- THE THREE STEPS -->
  {offers.map((o) => (
    <section id={o.id} class={`${o.bg} px-6 py-16 sm:py-24 scroll-mt-20`}>
      <div class="max-w-5xl mx-auto grid md:grid-cols-2 gap-10 md:gap-16 items-center">
        <div class={`flex justify-center ${o.flip ? 'md:order-2' : ''}`}>
          <div class="relative w-full max-w-sm">
            <img src={o.image} alt={o.alt} class="w-full rounded-[2rem] shadow-[0_20px_50px_rgba(0,0,0,0.12)]" loading="lazy" />
            <span class="absolute -top-5 -left-3 sm:-left-6 grid place-items-center h-16 w-16 sm:h-20 sm:w-20 rounded-full bg-pink text-white font-serif italic text-2xl sm:text-3xl shadow-lg" aria-hidden="true">{o.num}</span>
          </div>
        </div>
        <div class={o.flip ? 'md:order-1' : ''}>
          <p class="text-pink text-xs uppercase tracking-widest font-semibold mb-3">{o.eyebrow}</p>
          <h2 class="text-3xl sm:text-4xl font-bold mb-4 text-balance">{o.title}</h2>
          {o.id === 'step-02' ? (
            <p class="mb-6 flex flex-wrap items-center gap-x-3 gap-y-2">
              <span class="inline-block rounded-full border border-black px-4 py-1.5 text-xs uppercase tracking-widest font-semibold" data-mmes-price>{earlyPrice ? '$297' : '$997'}</span>
              {earlyPrice && <span class="text-sm font-semibold text-pink" data-mmes-note>Through November, then $997 from 1 December.</span>}
            </p>
          ) : (
            <p class="inline-block rounded-full border border-black px-4 py-1.5 text-xs uppercase tracking-widest font-semibold mb-6">{o.tag}</p>
          )}
          <p class="text-black mb-6">{o.desc}</p>
          {o.items.length > 0 && (
            <details class="group mb-8">
              <summary class="inline-flex cursor-pointer list-none items-center gap-3 text-[15px] font-semibold [&::-webkit-details-marker]:hidden">
                The details
                <span class="grid place-items-center h-9 w-9 rounded-full bg-[#e9d9ec] text-black transition-transform duration-300 group-open:rotate-45"><svg viewBox="0 0 16 16" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><path d="M8 3v10M3 8h10" /></svg></span>
              </summary>
              <ul class="mt-5 text-sm text-black space-y-2">
                {o.items.map((item) => <li><span class="text-pink">+</span> {item}</li>)}
              </ul>
            </details>
          )}
          {o.quote && (
            <blockquote class="mb-8 border-l-2 border-pink pl-5">
              <p class="font-serif text-lg italic leading-snug text-balance">&ldquo;{o.quote.text}&rdquo;</p>
              <footer class="mt-3 text-xs uppercase tracking-widest font-semibold">{o.quote.name}</footer>
            </blockquote>
          )}
          <a href={o.href} class="group inline-flex items-center gap-4 rounded-full bg-black text-white pl-7 pr-2 py-2 text-[15px] font-semibold transition-transform duration-300 hover:-translate-y-1">
            {o.cta}
            <span class="grid place-items-center h-11 w-11 rounded-full bg-pink text-white transition-colors duration-300 group-hover:bg-white group-hover:text-black"><svg viewBox="0 0 16 16" class="h-4 w-4 transition-transform duration-300 group-hover:rotate-45" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={arrow} /></svg></span>
          </a>
        </div>
      </div>
    </section>
  ))}

  <!-- JUST NEED ONE THING / COMING EARLY 2027 -->
  <section class="bg-offwhite px-6 py-16 sm:py-24">
    <div class="max-w-5xl mx-auto grid gap-6 md:grid-cols-2">
      <div class="flex flex-col rounded-[2rem] bg-white p-8 sm:p-10 shadow-[0_8px_30px_rgba(0,0,0,0.05)]">
        <p class="text-xs uppercase tracking-widest font-semibold mb-4 text-pink">Just need one thing?</p>
        <h2 class="font-serif text-3xl sm:text-4xl italic mb-4 text-balance">The KK Digital Product Shop</h2>
        <p class="text-black mb-8 flex-grow">Grab-and-go courses, templates and trainings for growing your email list without social media, from a $17 collaboration database up.</p>
        <a href="https://shop.kyliekelly.com/" class="group inline-flex items-center gap-4 self-start rounded-full bg-black text-white pl-7 pr-2 py-2 text-[15px] font-semibold transition-transform duration-300 hover:-translate-y-1">
          Shop the products
          <span class="grid place-items-center h-11 w-11 rounded-full bg-pink text-white transition-colors duration-300 group-hover:bg-white group-hover:text-black"><svg viewBox="0 0 16 16" class="h-4 w-4 transition-transform duration-300 group-hover:rotate-45" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={arrow} /></svg></span>
        </a>
      </div>
      <div class="flex flex-col rounded-[2rem] bg-black p-8 sm:p-10 text-white">
        <p class="text-xs uppercase tracking-widest font-semibold mb-4 text-pink">Coming early 2027</p>
        <h2 class="font-serif text-3xl sm:text-4xl italic mb-4 text-balance">The Inner Circle</h2>
        <p class="text-warmgray mb-8 flex-grow">My higher-touch group: 12 months with the most support I'm going to give. $6k for the year. Not open yet, but it's coming.</p>
        {INNER_CIRCLE_WAITLIST ? (
          <a href={INNER_CIRCLE_WAITLIST} class="group inline-flex items-center gap-4 self-start rounded-full bg-white text-black pl-7 pr-2 py-2 text-[15px] font-semibold transition-transform duration-300 hover:-translate-y-1">
            Join the waitlist
            <span class="grid place-items-center h-11 w-11 rounded-full bg-pink text-white transition-colors duration-300 group-hover:bg-black"><svg viewBox="0 0 16 16" class="h-4 w-4 transition-transform duration-300 group-hover:rotate-45" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={arrow} /></svg></span>
          </a>
        ) : (
          <p class="inline-block self-start rounded-full border border-white/40 px-4 py-1.5 text-xs uppercase tracking-widest font-semibold">Opening early 2027</p>
        )}
      </div>
    </div>
  </section>

  <!-- RESULTS: big tilted cards that slide in from the sides, straddling a light and a dark band -->
  <section class="svc-results relative z-10 overflow-hidden">
    <div class="absolute inset-x-0 bottom-0 h-1/2 bg-black" aria-hidden="true"></div>
    <div class="relative mx-auto max-w-6xl px-6 pt-20 pb-24 sm:pt-28 sm:pb-32">
      <p class="mb-3 text-center text-xs font-semibold uppercase tracking-widest text-pink">&mdash; Happy clients &mdash;</p>
      <h2 class="mb-14 text-center text-3xl font-bold sm:text-4xl">Real students. <span class="script-accent italic text-pink">Real results.</span></h2>
      <div class="svc-cards grid items-center gap-8 md:grid-cols-3 md:gap-0">
        {results.map((r, i) => (
          <figure class={`svc-card svc-from-${r.from} relative rounded-[2.25rem] p-8 shadow-[0_24px_60px_rgba(0,0,0,0.18)] sm:p-10 md:min-h-[26rem] ${r.card} ${i === 1 ? 'z-10 md:-mx-4' : ''} ${i === 2 ? 'md:-mt-6' : ''}`} style={`--r:${r.rot}`}>
            <p class="mb-6 text-lg tracking-[0.2em]" aria-label="5 stars">★★★★★</p>
            <p class="mb-5 text-2xl font-bold uppercase leading-[1.05] tracking-tight sm:text-3xl">{r.big}</p>
            <blockquote class="text-[15px] leading-relaxed">&ldquo;{r.quote}&rdquo;</blockquote>
            <figcaption class="mt-8 font-semibold">&ndash; {r.name}</figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <!-- THE STATEMENT, THE NUMBERS AND A BIG PHOTO -->
  <section class="bg-black px-6 pt-8 text-center text-white sm:pt-12">
    <div class="mx-auto max-w-4xl">
      <p class="mb-6 font-semibold text-pink sm:text-lg">You're in the right place, babe.</p>
      <h2 class="font-serif text-[clamp(2.25rem,6vw,4.75rem)] leading-[1.02] text-balance">
        I don't think you need another strategy. I think you need the <span class="italic text-pink">right one</span> for right now.
      </h2>
      <p class="mx-auto mt-8 max-w-2xl text-warmgray sm:text-lg">Whichever step you pick, you don't have to figure this out alone anymore. Start where you're at, and move to the next step when you're ready, not before.</p>
      <dl class="mt-16 grid grid-cols-2 gap-x-6 gap-y-10 text-center lg:grid-cols-4">
        {stats.map((st) => (
          <div>
            <dt class="font-serif text-4xl font-bold text-pink sm:text-5xl">{st.num}</dt>
            <dd class="mx-auto mt-3 max-w-[16rem] text-sm leading-snug text-warmgray">{st.label}</dd>
          </div>
        ))}
      </dl>
    </div>
    <img src="/images/hero-8.jpg" alt="Kylie Kelly relaxing in a chair holding a disco ball and a glass of rosé" class="mx-auto mt-16 h-[320px] w-full max-w-6xl rounded-t-[2.5rem] object-cover object-[50%_32%] sm:h-[460px]" loading="lazy" />
  </section>

  <!-- FAQ -->
  <section class="px-6 py-20 sm:py-28">
    <div class="max-w-3xl mx-auto">
      <p class="text-pink text-xs uppercase tracking-widest font-semibold mb-3 text-center">&mdash; Good to know &mdash;</p>
      <h2 class="text-3xl sm:text-4xl font-bold text-center mb-12">Questions you might have.</h2>
      <div class="space-y-3">
        {faqs.map((f) => (
          <details class="group rounded-[1.75rem] border border-black/20 open:border-pink transition-colors">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 px-6 py-4 font-semibold [&::-webkit-details-marker]:hidden">
              <span>{f.q}</span>
              <span class="grid place-items-center h-9 w-9 flex-none rounded-full bg-pink text-white transition-transform duration-300 group-open:rotate-90"><svg viewBox="0 0 16 16" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4" /></svg></span>
            </summary>
            <p class="px-6 pb-6 text-black">{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- CLOSING CTA -->
  <section class="px-4 sm:px-6 pb-16 sm:pb-24">
    <div class="max-w-6xl mx-auto overflow-hidden rounded-[2rem] bg-[#e9d9ec] grid md:grid-cols-[0.8fr_1.2fr] items-center">
      <img src="/images/kylie-headshot.jpg" alt="Kylie Kelly smiling, sitting in a chair wearing a lilac top" class="w-full h-full max-h-[420px] md:max-h-none object-cover object-[50%_30%] aspect-square md:aspect-auto" loading="lazy" />
      <div class="px-7 sm:px-12 py-12 sm:py-16">
        <p class="text-xs uppercase tracking-widest font-semibold mb-3">This feel like your vibe?</p>
        <h2 class="text-3xl sm:text-4xl font-bold mb-5 text-balance">Whichever step you pick, you don't have to figure this out alone anymore.</h2>
        <p class="text-black mb-3">I built these ways to work together because I know business doesn't look the same for everyone, and it shouldn't have to. Start where you're at. Move to the next step when you're ready, not before.</p>
        <p class="font-serif italic text-pink text-lg mb-8">Cheering you on always, Kylie xx</p>
        <div class="flex flex-wrap gap-3">
          <a href="https://www.skool.com/email-marketing-skool/about" class="group inline-flex items-center gap-4 rounded-full bg-black text-white pl-7 pr-2 py-2 text-[15px] font-semibold transition-transform duration-300 hover:-translate-y-1">
            Start for free
            <span class="grid place-items-center h-11 w-11 rounded-full bg-pink text-white transition-colors duration-300 group-hover:bg-white group-hover:text-black"><svg viewBox="0 0 16 16" class="h-4 w-4 transition-transform duration-300 group-hover:rotate-45" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={arrow} /></svg></span>
          </a>
          <a href="https://system.kyliekelly.com/join" class="group inline-flex items-center gap-4 rounded-full bg-white text-black pl-7 pr-2 py-2 text-[15px] font-semibold transition-transform duration-300 hover:-translate-y-1">
            Get the email system
