---
import Layout from '../layouts/Layout.astro';
import Highlight from '../components/Highlight.astro';
import CrossingRibbons from '../components/CrossingRibbons.astro';

const testimonials = [
  {
    quote: "I went from stuck and overwhelmed to 122 new subscribers, in just days of working with Kylie (all without social media!!) She is great at what she does!!",
    name: 'Erin K.',
  },
  {
    quote: "I've gone from 45 to currently just under 800 active subscribers in less than a month!",
    name: 'Amy G.',
  },
  {
    quote: 'I started with 231 people before I met you and now my email list is currently 643 with 412 new subscribers 🎉',
    name: 'Celia V.',
  },
  {
    quote: "I was exhausted from showing up everywhere - social media, press, LinkedIn, email, blogs. But after joining Kylie's world, I'm so much calmer. One month, one focus.",
    name: 'Harsimrat K.',
  },
  {
    quote: 'Kylie has helped me overcome email overwhelm with her clear, totally doable framework.',
    name: 'Debra V.',
  },
  {
    quote: "I have close to 500 people on my email list AND I've just gotten two course sales! In 2 months, I have had more success with this than I did in 5 years of blogging & waiting passively for subscribers (& income) to find me!",
    name: 'Vanessa R.',
  },
];

const heroPills = [
  { label: 'Start for free', href: 'https://www.skool.com/email-marketing-skool/about', dot: 'border-2 border-transparent bg-pink text-white group-hover:border-black group-hover:bg-white group-hover:text-black' },
  { label: 'Shop the products', href: 'https://shop.kyliekelly.com/', dot: 'border-2 border-transparent bg-pink-light text-black group-hover:border-black group-hover:bg-white group-hover:text-black' },
  { label: 'Work with me', href: '/services', dot: 'border-2 border-black bg-black text-white group-hover:bg-white group-hover:text-black' },
];

const tickerItems = [
  "hater of country music {unless it's OG Tay Tay}",
  '0 to 7,000+ subscribers in 18 months',
  'top 1.5% podcast globally',
  'english breakfast tea within 5 minutes of waking',
  'never slept in makeup, not even in my 20s',
  'built without social media',
  'lover of oat milk lattes',
  'ex international wedding photographer',
  'industry speaker',
  'really uncoordinated',
  'always says thank you & please to Claude',
];
---
<Layout title="Kylie Kelly | Grow Your Email List Without Social Media">

  <!-- PILLAR BANNER -->
  <section class="bg-pink-light px-6 py-4">
    <p class="max-w-4xl mx-auto flex items-center justify-center gap-4 text-xs sm:text-sm font-normal uppercase tracking-widest text-black text-center">
      <span class="hidden sm:block h-px flex-1 bg-black/30"></span>
      Audience. Relationships. Revenue. All Built Without Social Media.
      <span class="hidden sm:block h-px flex-1 bg-black/30"></span>
    </p>
  </section>

  <!-- HERO: one centred column, three call-to-action pills, polaroid fan -->
  <section class="bg-black text-white px-6 pt-14 sm:pt-16 text-center relative overflow-hidden">
    <div class="max-w-3xl mx-auto">
      <h1 class="text-[29px] sm:text-[40px] lg:text-[44px] font-bold leading-[1.15] mb-5 text-balance">
        Helping you get <em class="italic font-bold text-pink">known, trusted, and selling,</em>
        with an email list &amp; real relationships that work
        <em class="italic font-normal">{"{even when you're not online}"}</em>.
      </h1>
      <p class="text-white text-base mb-10">For coaches, course creators and service providers.</p>

      <div class="flex flex-col sm:flex-row sm:flex-wrap justify-center gap-4 sm:gap-5 lg:gap-6 max-w-xs sm:max-w-none mx-auto">
        {heroPills.map((pill) => (
          <a
            href={pill.href}
            class="group flex items-center justify-between gap-5 bg-white text-black rounded-full pl-6 pr-2 py-2 lg:pl-7 lg:py-2.5 lg:pr-2.5 text-[15px] lg:text-base font-semibold shadow-[0_8px_22px_rgba(224,64,251,0.18)] transition-transform duration-300 hover:-translate-y-1"
          >
            <span>{pill.label}</span>
            <span class={`grid place-items-center h-10 w-10 lg:h-12 lg:w-12 rounded-full transition-colors duration-300 ${pill.dot}`}>
              <svg viewBox="0 0 16 16" class="h-4 w-4 lg:h-5 lg:w-5 transition-transform duration-300 group-hover:rotate-45" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 12L12 4M5.5 4H12v6.5" /></svg>
            </span>
          </a>
        ))}
      </div>
    </div>

    <div class="flex justify-center items-start mt-16 sm:mt-20 h-[210px] sm:h-[260px] lg:h-[330px]">
      <div class="flex-none w-[118px] sm:w-[190px] lg:w-[240px] bg-white p-[5px] pb-4 sm:p-[7px] sm:pb-[22px] lg:p-[9px] lg:pb-[28px] shadow-2xl -rotate-6 translate-y-3 -mr-[10px] sm:-mr-[14px] lg:-mr-[18px]">
        <img src="/images/hero-1.jpg" alt="Kylie Kelly" class="block w-full" />
      </div>
      <div class="flex-none w-[118px] sm:w-[190px] lg:w-[240px] bg-white p-[5px] pb-4 sm:p-[7px] sm:pb-[22px] lg:p-[9px] lg:pb-[28px] shadow-2xl rotate-2 z-10">
        <img src="/images/hero-2.jpg" alt="Kylie Kelly laughing" class="block w-full" />
      </div>
      <div class="flex-none w-[118px] sm:w-[190px] lg:w-[240px] bg-white p-[5px] pb-4 sm:p-[7px] sm:pb-[22px] lg:p-[9px] lg:pb-[28px] shadow-2xl -rotate-2 translate-y-2 -ml-[10px] sm:-ml-[14px] lg:-ml-[18px] z-20">
        <img src="/images/hero-7.jpg" alt="Kylie Kelly holding a disco ball" class="block w-full" />
      </div>
    </div>
  </section>

  <!-- AS FEATURED IN -->
  <section class="bg-white px-6 py-8 lg:py-12">
    <p class="text-center text-xs uppercase tracking-widest text-muted mb-8">As featured in:</p>
    <div class="max-w-4xl lg:max-w-6xl mx-auto flex flex-wrap items-center justify-center gap-x-14 lg:gap-x-20 gap-y-8">
      <a href="https://www.forbes.com/advisor/business/software/email-marketing-strategy/" target="_blank" rel="noopener">
        <img src="/images/press/forbes.png" alt="Forbes" class="h-10 sm:h-12 lg:h-14 xl:h-16 w-auto opacity-80 hover:opacity-100 transition-opacity" />
      </a>
      <img src="/images/press/business-insider.jpg" alt="Business Insider" class="h-10 sm:h-12 lg:h-14 xl:h-16 w-auto opacity-80" />
      <a href="https://www.londondaily.news/why-six-figure-female-entrepreneurs-are-breaking-up-with-social-media-in-2025/" target="_blank" rel="noopener">
        <img src="/images/press/london-daily-news.png" alt="London Daily News" class="h-10 sm:h-12 lg:h-14 xl:h-16 w-auto opacity-80 hover:opacity-100 transition-opacity" />
      </a>
      <a href="https://businessmondays.co.uk/independent-business-podcast-surpasses-200-episodes-40000-downloads-highlighting-the-power-of-sustainable-growth/" target="_blank" rel="noopener">
        <img src="/images/press/business-mondays.jpg" alt="Business Mondays" class="h-14 sm:h-16 lg:h-20 xl:h-24 w-auto opacity-80 hover:opacity-100 transition-opacity" />
      </a>
    </div>
  </section>

  <!-- STATEMENT -->
  <section class="bg-white px-6 pt-12 pb-14 sm:pt-14 sm:pb-16 text-center border-t border-black/10">
    <p class="text-pink text-xs uppercase tracking-widest font-semibold mb-4">The Kylie Kelly Promise</p>
    <p class="font-serif font-bold italic text-[21px] sm:text-[26px] lg:text-[30px] leading-[1.4] max-w-[36em] mx-auto text-black text-balance">
      I'm on a mission to help you get known, trusted, and selling to the right people. Built on the system that took me from 0 to 7,000 subscribers in 18 months - I want you to have <span class="whitespace-nowrap"><Highlight>consistent sales</Highlight></span> from visibility systems that keep working long after you build them.
    </p>
  </section>

  <div class="border-t border-dashed border-warmgray"></div>

  <!-- PAIN MIRROR -->
  <section class="px-6 pt-8 pb-20">
    <div class="max-w-5xl mx-auto grid md:grid-cols-2 gap-12 items-center">
      <div>
        <h2 class="text-2xl sm:text-3xl font-bold mb-6">
          You started a business to build something real. <em class="italic text-pink font-bold">{"{not to be glued to your phone forever.}"}</em>
        </h2>
        <p class="text-black uppercase tracking-wide text-sm mb-4">Sound familiar?</p>
        <ul class="text-black mb-8">
          <li class="pb-3 mb-3 border-b border-warmgray/50 w-fit"><span class="text-pink">+</span> Maybe you're posting (or not posting) and still wondering where your next client is coming from.</li>
          <li class="pb-3 mb-3 border-b border-warmgray/50 w-fit"><span class="text-pink">+</span> Maybe your email list has stalled, or it's growing but nobody's buying.</li>
          <li class="pb-3 mb-3 border-b border-warmgray/50 w-fit"><span class="text-pink">+</span> Maybe you've tried Instagram, then SEO, then Pinterest, and you still don't know what works.</li>
          <li class="pb-3 mb-3 border-b border-warmgray/50 w-fit"><span class="text-pink">+</span> Maybe you're tired of being "always on" just to stay visible.</li>
          <li><span class="text-pink">+</span> Or maybe you're thinking, "Kylie, that's literally all of it."</li>
        </ul>
        <p class="text-black font-bold text-xl sm:text-2xl leading-snug mb-8">
          One of those hit? All five?<br />
          I've got you my love.<br />
          <span class="text-pink">You're in the right place.</span>
        </p>
      </div>
      <div class="hidden md:flex items-center justify-center">
        <div class="bg-white p-3 pb-8 rounded-sm shadow-xl rotate-3 max-w-xs">
          <img src="/images/kylie-headshot.jpg" alt="Kylie Kelly" class="w-full rounded-sm" />
        </div>
      </div>
    </div>
  </section>

  <!-- FREEBIE CARD -->
  <section class="px-6 pb-20">
    <div class="max-w-5xl mx-auto grid md:grid-cols-2 rounded-[2rem] overflow-hidden bg-black text-white">
      <div class="p-8 sm:p-12 lg:p-14 flex flex-col justify-center">
        <p class="text-pink text-xs uppercase tracking-widest font-semibold mb-4">Free AI Audience Growth Tool</p>
        <h2 class="font-serif text-3xl sm:text-4xl lg:text-5xl leading-[1.1] mb-5 text-balance">
          Answer 6 questions. Leave with <em class="italic text-pink">one clear strategy.</em>
        </h2>
        <p class="mb-8 max-w-md">
          Get the list-building strategy most likely to work for your business right now. It takes about 60 seconds.
        </p>
        <a href="https://kyliekelly.myflodesk.com/audience" class="self-start inline-block rounded-full bg-white text-black px-8 py-4 text-[13px] font-bold uppercase tracking-[0.08em] transition-colors hover:bg-pink-light">Get the free tool &rarr;</a>
      </div>
      <div class="relative flex items-center justify-center bg-pink px-6 py-12 sm:px-10 md:min-h-[460px]" style="background-image: radial-gradient(circle at 50% 46%, rgba(255,255,255,0.28), rgba(255,255,255,0) 62%), radial-gradient(rgba(255,255,255,0.3) 1.5px, rgba(255,255,255,0) 1.7px); background-size: auto, 22px 22px;">
        <img src="/images/freebie-mockup.png" alt="The Your Next 1000 Subscribers quiz on a desktop monitor" class="w-full max-w-md h-auto drop-shadow-[0_24px_30px_rgba(0,0,0,0.3)]" />
        <span class="absolute top-5 right-5 inline-flex items-center gap-2 rounded-full bg-white text-black px-5 py-2.5 text-sm font-semibold shadow-lg">
          <span class="h-2.5 w-2.5 rounded-full bg-pink"></span>
          Free &middot; 60 seconds
        </span>
      </div>
    </div>
  </section>

  <!-- WAYS TO WORK TOGETHER: crossing ribbons, then three cards that stack as you scroll -->
  <section class="bg-offwhite pb-24">
    <CrossingRibbons />

    <div class="px-6 pt-12 sm:pt-16">
      <div class="max-w-5xl mx-auto">
        <p class="text-pink text-xs uppercase tracking-widest font-semibold text-center mb-3">&mdash; Ways to Work Together &mdash;</p>
        <h2 class="text-3xl sm:text-4xl font-bold text-center mb-3">Three steps, whichever one fits where you're at.</h2>
        <p class="text-black italic text-center max-w-xl mx-auto mb-12 sm:mb-16">{"{no pressure to jump to the end, most people start with step one}"}</p>

        <div class="space-y-8 md:space-y-10">

          <div class="stack-card rounded-[2rem] bg-white p-7 sm:p-10 lg:p-12 shadow-[0_-12px_40px_rgba(0,0,0,0.08)]" style="--stack-top:6rem;">
            <div class="grid md:grid-cols-[1fr_auto] gap-8 lg:gap-14 items-center">
              <div>
                <p class="font-serif italic text-pink text-6xl sm:text-7xl mb-4">01</p>
                <h3 class="text-2xl sm:text-3xl font-bold mb-1">Start for free.</h3>
                <p class="text-xs uppercase tracking-wide text-black mb-4">Email Marketing Skool</p>
                <p class="text-black mb-4">For online business owners who want more sales from an email list, without living on social media. Inside, you'll learn how to grow an email list of the right people, find collaborations that bring warm subscribers, turn subscribers into buyers, and build visibility without constant posting.</p>
                <ul class="text-black text-sm space-y-2 mb-6">
                  <li><span class="text-pink">+</span> A simple 90-day growth plan</li>
                  <li><span class="text-pink">+</span> The Email Marketing Starter Kit, free on joining</li>
                  <li><span class="text-pink">+</span> Premium: live Q&amp;A, templates, and the Audience Growth Tool Vault</li>
                </ul>
                <a href="https://www.skool.com/email-marketing-skool/about" class="btn-pink">Start My Free Growth Plan →</a>
              </div>
              <div class="flex justify-center order-first md:order-none">
                <div class="bg-white p-2 pb-6 rounded-sm shadow-xl -rotate-3 w-[190px] sm:w-[230px] max-w-full">
                  <img src="/images/hero-8.jpg" alt="Kylie Kelly" class="w-full rounded-sm" />
                </div>
              </div>
            </div>
          </div>

          <div class="stack-card rounded-[2rem] bg-[#e9d9ec] p-7 sm:p-10 lg:p-12 shadow-[0_-12px_40px_rgba(0,0,0,0.1)]" style="--stack-top:7.5rem;">
            <div class="grid md:grid-cols-[1fr_auto] gap-8 lg:gap-14 items-center">
              <div>
                <p class="font-serif italic text-pink text-6xl sm:text-7xl mb-4">02</p>
                <h3 class="text-2xl sm:text-3xl font-bold mb-1">Grab what you need, start today.</h3>
                <p class="text-xs uppercase tracking-wide text-black mb-4">The KK Digital Product Shop</p>
                <p class="text-black mb-6">Grab-and-go courses, templates and trainings for growing your email list without social media, from a $17 collaboration database to a full no-social growth system.</p>
                <a href="https://shop.kyliekelly.com/" class="btn-pink">Help me grow my email list →</a>
              </div>
              <div class="flex justify-center order-first md:order-none">
                <div class="bg-white p-2 pb-6 rounded-sm shadow-xl rotate-3 w-[240px] sm:w-[320px] max-w-full">
                  <img src="/images/shop-mockup.jpg" alt="The KK Digital Product Shop preview" class="w-full rounded-sm" />
                </div>
              </div>
            </div>
          </div>

          <div class="stack-card rounded-[2rem] bg-black text-white p-7 sm:p-10 lg:p-12 shadow-[0_-12px_40px_rgba(0,0,0,0.18)]" style="--stack-top:9rem;">
            <div class="grid md:grid-cols-[1fr_auto] gap-8 lg:gap-14 items-center">
              <div>
                <p class="font-serif italic text-pink text-6xl sm:text-7xl mb-4">03</p>
                <h3 class="text-2xl sm:text-3xl font-bold mb-1">Get my brain in your corner.</h3>
                <p class="text-xs uppercase tracking-wide text-white mb-4">Coaching Group &middot; $297</p>
                <p class="text-white mb-6">Weekly voice-note coaching for the real questions, offer clarity, launch strategy, what to prioritize when everything feels urgent. Real questions, real answers, all week long.</p>
                <blockquote class="font-typewriter border-l-2 border-pink pl-4 mb-6 text-sm not-italic text-white">
                  "I legitimately feel my shoulders drop every time I listen to one of your Voxer responses&hellip; I don't need to do everything, I just need to do the next right thing."
                  <footer class="text-xs uppercase tracking-wide text-white mt-2">&mdash; Nicole Elliott</footer>
                </blockquote>
                <a href="https://coaching.kyliekelly.com/checkout" class="inline-block rounded-full bg-white text-black px-8 py-4 text-[13px] font-bold uppercase tracking-[0.08em] transition-colors hover:bg-pink-light">Get Weekly Support &amp; Answers →</a>
              </div>
              <div class="flex justify-center order-first md:order-none">
                <div class="bg-white p-2 pb-6 rounded-sm shadow-xl -rotate-3 w-[190px] sm:w-[230px] max-w-full">
                  <img src="/images/desk-scene.jpg" alt="" class="w-full rounded-sm" />
                </div>
              </div>
            </div>
          </div>

        </div>
      </div>
    </div>
  </section>

  <!-- HAPPY CLIENTS / TESTIMONIAL SLIDER -->
  <section class="bg-black text-white px-6 py-20">
    <div class="max-w-3xl mx-auto text-center">
      <p class="text-pink text-xs uppercase tracking-widest font-normal mb-3">— Happy Clients —</p>
      <h2 class="text-3xl sm:text-4xl font-bold mb-14">Real students. <span class="script-accent italic text-pink">Real results.</span></h2>
      <div class="min-h-[220px] sm:min-h-[160px] flex flex-col items-center justify-center">
        {testimonials.map((t, i) => (
          <div class="testimonial-slide" data-index={i} style={i === 0 ? '' : 'display:none;'}>
            <p class="font-serif text-xl sm:text-2xl leading-relaxed text-white mb-6">&ldquo;{t.quote}&rdquo;</p>
            <p class="text-pink text-xs uppercase tracking-widest font-semibold">— {t.name}</p>
          </div>
        ))}
      </div>
      <div class="flex items-center justify-center gap-3 mt-12">
        {testimonials.map((t, i) => (
          <button
            type="button"
            class="testimonial-dot w-2.5 h-2.5 rounded-full border border-white/40 transition-colors"
            data-index={i}
            aria-label={`Show testimonial from ${t.name}`}
            style={i === 0 ? 'background:#e040fb;border-color:#e040fb;' : 'background:transparent;'}
          ></button>
        ))}
      </div>
    </div>
  </section>

  <script>
    const slides = document.querySelectorAll<HTMLElement>('.testimonial-slide');
    const dots = document.querySelectorAll<HTMLElement>('.testimonial-dot');
    let current = 0;
    let timer: ReturnType<typeof setInterval>;

    function show(index: number) {
      slides.forEach((s, i) => {
        s.style.display = i === index ? '' : 'none';
      });
      dots.forEach((d, i) => {
        d.style.background = i === index ? '#e040fb' : 'transparent';
        d.style.borderColor = i === index ? '#e040fb' : 'rgba(255,255,255,0.4)';
      });
      current = index;
    }

    function resetTimer() {
      clearInterval(timer);
      timer = setInterval(() => {
        show((current + 1) % slides.length);
      }, 6000);
    }

    dots.forEach((dot) => {
      dot.addEventListener('click', () => {
        show(parseInt(dot.dataset.index ?? '0', 10));
        resetTimer();
      });
    });

    if (slides.length > 0) resetTimer();
  </script>

  <!-- MEET KYLIE -->
  <section class="bg-pink-light overflow-hidden py-3">
    <div class="ticker-wrap flex">
      <div class="ticker-track flex items-center gap-10 pr-10 shrink-0">
        {tickerItems.map((item) => (
          <span class="flex items-center gap-10 text-xs sm:text-sm uppercase tracking-widest text-black font-normal whitespace-nowrap">
            {item}
            <span class="text-pink text-base">+</span>
          </span>
        ))}
      </div>
      <div class="ticker-track flex items-center gap-10 pr-10 shrink-0" aria-hidden="true">
        {tickerItems.map((item) => (
          <span class="flex items-center gap-10 text-xs sm:text-sm uppercase tracking-widest text-black font-normal whitespace-nowrap">
            {item}
            <span class="text-pink text-base">+</span>
          </span>
        ))}
      </div>
    </div>
  </section>

  <style>
    .ticker-wrap {
      width: max-content;
      animation: ticker-scroll 50s linear infinite;
    }
    @keyframes ticker-scroll {
      from { transform: translateX(0); }
      to { transform: translateX(-50%); }
    }
    @media (prefers-reduced-motion: reduce) {
      .ticker-wrap { animation: none; }
    }
  </style>

  <section class="bg-offwhite px-6 py-20">
    <div class="max-w-5xl mx-auto grid md:grid-cols-[1fr_1.2fr] gap-12 items-start">
      <div>
        <p class="text-pink text-xs uppercase tracking-widest font-semibold mb-3">— Meet Kylie —</p>
        <h2 class="text-3xl sm:text-4xl font-bold mb-4">
          Kylie <span class="script-accent italic text-pink">{'{founder}'}</span> + Nick, Spencer &amp; Sammy <span class="script-accent italic text-pink">{'{my why}'}</span>.
        </h2>
        <p class="text-xs uppercase tracking-wide text-black font-semibold mb-6">
          One builds the strategy. The others are why school pickup never moves.
        </p>
        <ul class="text-black text-sm space-y-2 mb-4">
          <li><span class="text-pink">+</span> From 0 to 7,000+ email subscribers in 18 months, no ads, no algorithm.</li>
          <li><span class="text-pink">+</span> A Skool community of 1,300+.</li>
          <li><span class="text-pink">+</span> A podcast ranked in the top 1.5% globally.</li>
        </ul>
        <p class="text-black mb-8">
          Built around nap times, school runs, and a genuine belief that business gets to be fun.
        </p>
        <a href="/meet-kylie" class="btn-pink">Get to Know Kylie →</a>
      </div>
      <div class="grid grid-cols-2 gap-6 items-start">
        <div class="bg-white p-3 rounded-sm shadow-2xl -rotate-3">
          <img src="/images/kylie-podcast.jpg" alt="Kylie Kelly" class="w-full rounded-sm" />
          <div class="h-16 flex items-center justify-center">
            <p class="text-center font-typewriter text-base uppercase tracking-wide text-black">Kylie</p>
          </div>
        </div>
        <div class="bg-white p-3 rounded-sm shadow-2xl rotate-3 mt-10">
          <img src="/images/little-fam.jpg" alt="Kylie with Nick, Spencer and Sammy" class="w-full rounded-sm" />
          <div class="h-16 flex items-center justify-center">
            <p class="text-center font-typewriter text-base uppercase tracking-wide text-black">Nick, Spencer &amp; Sammy</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- PODCAST PROMO -->
  <section class="bg-white text-black px-6 py-20 relative overflow-hidden">
    <p class="absolute inset-0 flex items-center justify-center font-serif italic text-[5rem] sm:text-[8rem] whitespace-nowrap pointer-events-none select-none" style="color:rgba(0,0,0,0.04);">
      PODCAST PODCAST
    </p>
    <div class="max-w-5xl mx-auto relative">
      <div class="grid md:grid-cols-2 gap-10 items-center mb-24">
        <div>
