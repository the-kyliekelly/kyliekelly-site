---
import Layout from '../layouts/Layout.astro';

const testimonials = [
  {
    quote: "I went from stuck and overwhelmed to 122 new subscribers, in just days of working with Kylie (all without social media!!) She is great at what she does!!",
    name: 'Erin K.',
  },
  {
    quote: "I've gone from 45 to currently just under 800 active subscribers in less than a month!",
    name: 'Amy G.',
  },
  {
    quote: 'I started with 231 people before I met you and now my email list is currently 643 with 412 new subscribers 🎉',
    name: 'Celia V.',
  },
  {
    quote: "I was exhausted from showing up everywhere - social media, press, LinkedIn, email, blogs. But after joining Kylie's world, I'm so much calmer. One month, one focus.",
    name: 'Harsimrat K.',
  },
  {
    quote: 'Kylie has helped me overcome email overwhelm with her clear, totally doable framework.',
    name: 'Debra V.',
  },
  {
    quote: "I have close to 500 people on my email list AND I've just gotten two course sales! In 2 months, I have had more success with this than I did in 5 years of blogging & waiting passively for subscribers (& income) to find me!",
    name: 'Vanessa R.',
