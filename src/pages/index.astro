<script>
  // Give the three offer cards the same height so the stack looks even.
  const cards = Array.from(document.querySelectorAll<HTMLElement>('.stack-card'));
  if (cards.length) {
    const wide = window.matchMedia('(min-width: 768px)');
    const equalise = () => {
      cards.forEach((c) => (c.style.minHeight = ''));
      if (!wide.matches) return;
      const tallest = Math.max(...cards.map((c) => c.offsetHeight));
      cards.forEach((c) => (c.style.minHeight = `${tallest}px`));
    };
    equalise();
    window.addEventListener('load', equalise);
    if (document.fonts && document.fonts.ready) document.fonts.ready.then(equalise);
    const holder = cards[0].parentElement;
    if (holder && 'ResizeObserver' in window) {
      let lastWidth = 0;
      new ResizeObserver(([entry]) => {
        const width = Math.round(entry.contentRect.width);
        if (width !== lastWidth) {
          lastWidth = width;
          equalise();
        }
      }).observe(holder);
    } else {
      window.addEventListener('resize', equalise);
    }
  }
</script>

<script>
  // Pop the thought cards in one after another the first time they scroll into view.
  const group = document.querySelector<HTMLElement>('[data-pop-group]');
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (group && !reduceMotion && 'IntersectionObserver' in window) {
    const items = Array.from(group.querySelectorAll<HTMLElement>('.pop-item'));
    items.forEach((el, i) => {
      el.dataset.pop = 'pending';
      el.style.setProperty('--pop-delay', `${i * 130}ms`);
    });
    const io = new IntersectionObserver(
      (entries) => {
        if (!entries.some((e) => e.isIntersecting)) return;
        io.disconnect();
        items.forEach((el) => (el.dataset.pop = 'in'));
      },
      { threshold: 0.2 }
    );
    io.observe(group);
  }
</script>

<script>
  // Polaroids drop in and "develop" the first time they scroll into view.
  const polaroids = Array.from(document.querySelectorAll<HTMLElement>('.dev-polaroid'));
  const calm = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (polaroids.length && !calm && 'IntersectionObserver' in window) {
    polaroids.forEach((el, i) => {
      el.dataset.dev = 'pending';
      el.style.setProperty('--dev-delay', `${i * 240}ms`);
    });
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          (entry.target as HTMLElement).dataset.dev = 'in';
          io.unobserve(entry.target);
        });
      },
      { threshold: 0.3 }
    );
    polaroids.forEach((el) => io.observe(el));
  }
</script>
