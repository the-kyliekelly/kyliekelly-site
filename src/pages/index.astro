---
import Layout from '../layouts/Layout.astro';
import Highlight from '../components/Highlight.astro';
import CrossingRibbons from '../components/CrossingRibbons.astro';
import RotatingBadge from '../components/RotatingBadge.astro';
import CountUpStats from '../components/CountUpStats.astro';
import FreebieReveal from '../components/FreebieReveal.astro';
import episodePosts from '../data/blog-posts.json';
import reviewData from '../data/listener-reviews.json';

const testimonials = [
  {
    quote: "I went from stuck and overwhelmed to 122 new subscribers, in just days of working with Kylie (all without social media!!) She is great at what she does!!",
    name: 'Erin K.',
  },
  {
    quote: "I've gone from 45 to currently just under 800 active subscribers in less than a month!",
    name: 'Amy G.',
  },
  {
    quote: 'I started with 231 people before I met you and now my email list is currently 643 with 412 new subscribers 🎉',
    name: 'Celia V.',
  },
  {
    quote: "I was exhausted from showing up everywhere - social media, press, LinkedIn, email, blogs. But after joining Kylie's world, I'm so much calmer. One month, one focus.",
    name: 'Harsimrat K.',
  },
  {
    quote: 'Kylie has helped me overcome email overwhelm with her clear, totally doable framework.',
    name: 'Debra V.',
  },
  {
    quote: "I have close to 500 people on my email list AND I've just gotten two course sales! In 2 months, I have had more success with this than I did in 5 years of blogging & waiting passively for subscribers (& income) to find me!",
    name: 'Vanessa R.',
  },
];

const heroPills = [
  { label: 'Start for free', href: 'https://www.skool.com/email-marketing-skool/about', dot: 'border-2 border-transparent bg-pink text-white group-hover:border-black group-hover:bg-white group-hover:text-black' },
  { label: 'Shop the products', href: 'https://shop.kyliekelly.com/', dot: 'border-2 border-transparent bg-pink-light text-black group-hover:border-black group-hover:bg-white group-hover:text-black' },
  { label: 'Work with me', href: '/services', dot: 'border-2 border-black bg-black text-white group-hover:bg-white group-hover:text-black' },
];

// Signature course spotlight. Fill in href with the course link when it is ready.
const signatureCourse = {
  show: true,
  eyebrow: 'My signature course',
  name: 'The Money Making Email System',
  tagline: '{A simple system for growing your list and selling to it, without social media.}',
  description: 'I grew my email list from zero to 7,000+ without social media, and my revenue still comes from that list today. This is how I do it, from your first subscriber to your first sale.',
  buttonLabel: 'See what’s inside',
  href: '', // add the course link here; until then the button does nothing when clicked
  image: '/images/hero-2.jpg',
  imageAlt: 'Kylie Kelly',
};

// Latest episodes: read from the podcast feed at build time, with the episode library as a backup.
const handBuiltEpisodes = new Set([
  'low-lift-email-list-growth',
  'claude-claude-code-chrome-extension-delegate',
  'plan-rest-of-year-without-burning-out',
]);
const knownEpisodePages = new Set(episodePosts.map((p) => p.slug));

const decodeText = (text) =>
  text
    .replace(/<!\[CDATA\[|\]\]>/g, '')
    .replace(/&#(\d+);/g, (_, n) => String.fromCharCode(Number(n)))
    .replace(/&quot;/g, '"')
    .replace(/&lt;/g, '<')
    .replace(/&gt;/g, '>')
    .replace(/&amp;/g, '&')
    .trim();
const feedTag = (item, name) => {
  const m = item.match(new RegExp(`<${name}[^>]*>([\\s\\S]*?)</${name}>`));
  return m ? decodeText(m[1]) : null;
};
const formatDate = (d) => new Date(d).toLocaleDateString('en-AU', { day: 'numeric', month: 'short', year: 'numeric' });

async function loadFeedEpisodes() {
  try {
    const res = await fetch('https://feeds.buzzsprout.com/2065148.rss', { signal: AbortSignal.timeout(8000) });
    if (!res.ok) return [];
    const xml = await res.text();
    return (xml.match(/<item>[\s\S]*?<\/item>/g) ?? [])
      .map((item) => {
        const num = feedTag(item, 'itunes:episode');
        if (!num) return null;
        const title = (feedTag(item, 'title') ?? '').replace(/\s*\[Ep\.?\s*\d+\]\s*$/i, '');
        const rawDuration = feedTag(item, 'itunes:duration') ?? '';
        const seconds = rawDuration.includes(':')
          ? rawDuration.split(':').reduce((acc, part) => acc * 60 + Number(part), 0)
          : Number(rawDuration);
        const siteSlug = (feedTag(item, 'link') ?? '').match(/kyliekelly\.com\/([^/]+)\/?$/)?.[1];
        const audio = item.match(/<enclosure[^>]*url="([^"]+)"/)?.[1] ?? '';
        const listenPage = audio.replace(/\.(mp3|m4a)(\?.*)?$/, '');
        return {
          num,
          mins: seconds ? String(Math.round(seconds / 60)) : null,
          seconds: seconds || null,
          title,
          iso: feedTag(item, 'pubDate'),
          date: formatDate(feedTag(item, 'pubDate')),
          href: siteSlug && knownEpisodePages.has(siteSlug)
            ? (handBuiltEpisodes.has(siteSlug) ? `/podcast/episodes/${siteSlug}/` : `/${siteSlug}/`)
            : listenPage,
        };
      })
      .filter((e) => e && e.href);
  } catch {
    return [];
  }
}

const libraryEpisodes = episodePosts
  .map((p) => {
    const ep = p.excerpt.match(/EP\s*(\d+)/i);
    if (!ep) return null;
    const mins = p.excerpt.match(/(\d+)\s*MIN\s*LISTEN/i);
    return {
      num: ep[1],
      mins: mins ? mins[1] : null,
      seconds: mins ? Number(mins[1]) * 60 : null,
      title: p.title,
      iso: p.date,
      date: formatDate(p.date),
      href: handBuiltEpisodes.has(p.slug) ? `/podcast/episodes/${p.slug}/` : `/${p.slug}/`,
    };
  })
  .filter(Boolean);

const feedEpisodes = await loadFeedEpisodes();
const allEpisodes = (feedEpisodes.length ? feedEpisodes : libraryEpisodes).sort((x, y) => Number(y.num) - Number(x.num));
const wave = (seed) =>
  Array.from({ length: 36 }, (_, i) => Number((0.22 + 0.78 * Math.abs(Math.sin(i * 0.6 + seed) * Math.cos(i * 0.27 + seed * 1.7))).toFixed(2)));
const latestEpisodes = allEpisodes.slice(0, 3).map((ep, i) => ({ ...ep, bars: wave(i * 2.3 + (Number(ep.num) % 7)) }));
const episodeCount = allEpisodes.length ? Number(allEpisodes[0].num) : 266;

// The phone mockup always shows the newest episode.
const phoneEpisode = latestEpisodes[0];
const phoneDate = phoneEpisode
  ? new Date(phoneEpisode.iso).toLocaleDateString('en-AU', { day: 'numeric', month: 'long', year: 'numeric' }).toUpperCase()
  : '';
const phoneRemaining = (() => {
  const left = Math.max(0, (phoneEpisode?.seconds ?? 0) - 4);
  return `-${Math.floor(left / 60)}:${String(left % 60).padStart(2, '0')}`;
})();

// Real 5-star Apple Podcasts reviews of The Email Growth Show (2024 onward), word for word.
const listenerReviews = reviewData;

const tickerItems = [
  "hater of country music {unless it's OG Tay Tay}",
  '0 to 7,000+ subscribers in 18 months',
  'top 1.5% podcast globally',
  'english breakfast tea within 5 minutes of waking',
  'never slept in makeup, not even in my 20s',
  'built without social media',
  'lover of oat milk lattes',
  'ex international wedding photographer',
  'industry speaker',
  'really uncoordinated',
  'always says thank you & please to Claude',
];
