      <div class="relative max-w-4xl mx-auto">
        <div class="absolute -inset-6 rounded-3xl blur-2xl opacity-50 bg-pink"></div>
        <div class="relative bg-offwhite rounded-sm shadow-2xl p-2 sm:p-3">
        <iframe
          title="The Email Growth Show"
          allowtransparency="true"
          height="380"
          width="100%"
          style="border: none; min-width: 100%; overflow-y: auto;"
          scrolling="yes"
