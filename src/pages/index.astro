  <script>
    const slides = document.querySelectorAll<HTMLElement>('.testimonial-slide');
    const dots = document.querySelectorAll<HTMLElement>('.testimonial-dot');
    let current = 0;
    let timer: ReturnType<typeof setInterval>;

    function show(index: number) {
      slides.forEach((s, i) => {
        s.style.display = i === index ? '' : 'none';
      });
      dots.forEach((d, i) => {
        d.style.background = i === index ? '#e040fb' : 'transparent';
        d.style.borderColor = i === index ? '#e040fb' : 'rgba(255,255,255,0.4)';
      });
      current = index;
    }

    function resetTimer() {
      clearInterval(timer);
      timer = setInterval(() => {
        show((current + 1) % slides.length);
      }, 6000);
    }

    dots.forEach((dot) => {
      dot.addEventListener('click', () => {
        show(parseInt(dot.dataset.index ?? '0', 10));
        resetTimer();
      });
    });

    if (slides.length > 0) resetTimer();
  </script>

