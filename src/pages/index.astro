          src="https://www.buzzsprout.com/2065148?client_source=small_player&iframe=true"
          loading="lazy"
        ></iframe>
        </div>
      </div>
    </div>
  </section>

  <!-- FREE AI AUDIENCE GROWTH TOOL -->
  <section class="bg-white px-6 py-20">
    <div class="max-w-xl mx-auto text-center">
      <p class="text-pink text-xs uppercase tracking-widest font-normal mb-4">Free AI Audience Growth Tool</p>
      <h2 class="text-3xl sm:text-4xl font-bold italic mb-6 leading-tight text-black">
        Not sure what to focus on to <br /><span class="text-pink">grow your email list?</span>
      </h2>
      <p class="text-black mb-10">
        Answer 6 quick questions and get the list-building strategy most likely to work for your business right now.
      </p>
      <form action="https://form.flodesk.com/forms/6a389632c69dbd7193980270/submit" method="post" class="max-w-sm mx-auto text-left">
        <p class="font-serif text-2xl mb-1 text-black text-center">Get instant access:</p>
        <p class="italic text-xs text-pink text-center mb-6">{'{Takes less than 5 minutes - instant results}'}</p>
        <input type="text" name="firstName" placeholder="First name" required class="w-full mb-4 px-4 py-3 border border-warmgray rounded-sm bg-white text-black focus:outline-none focus:border-pink focus:ring-1 focus:ring-pink" />
        <input type="text" name="email" placeholder="Email address" required class="w-full mb-4 px-4 py-3 border border-warmgray rounded-sm bg-white text-black focus:outline-none focus:border-pink focus:ring-1 focus:ring-pink" />
        <input type="text" name="confirm_email_address" tabindex="-1" autocomplete="off" style="position:absolute;left:-9999px;" aria-hidden="true" />
        <button type="submit" class="btn-pink w-full">Yes, Build My Plan →</button>
      </form>
    </div>
  </section>

</Layout>
