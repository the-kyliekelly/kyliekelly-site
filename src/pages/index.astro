];

const tickerItems = [
  "hater of country music {unless it's OG Tay Tay}",
  '0 to 7,000+ subscribers in 18 months',
  'top 1.5% podcast globally',
  'english breakfast tea within 5 minutes of waking',
  'never slept in makeup, not even in my 20s',
  'built without social media',
  'lover of oat milk lattes',
  'ex international wedding photographer',
  'industry speaker',
  'really uncoordinated',
  'always says thank you & please to Claude',
];
---
<Layout title="Kylie Kelly | Grow Your Email List Without Social Media">

  <!-- PILLAR BANNER -->
  <section class="bg-pink-light px-6 py-4">
    <p class="max-w-4xl mx-auto flex items-center justify-center gap-4 text-xs sm:text-sm font-normal uppercase tracking-widest text-black text-center">
      <span class="hidden sm:block h-px flex-1 bg-black/30"></span>
      Audience. Relationships. Revenue. All Built Without Social Media.
      <span class="hidden sm:block h-px flex-1 bg-black/30"></span>
    </p>
  </section>

  <!-- HERO, centered / Carinda-model -->
  <section class="bg-black text-white px-6 pt-20 pb-8 text-center relative">
    <div class="max-w-3xl mx-auto">
      <h1 class="text-4xl sm:text-6xl font-bold leading-tight mb-6">
        Helping you get <em class="italic text-pink">known, trusted, and selling,</em><br class="hidden sm:block" />
        with an email list &amp; real relationships that work<br class="hidden sm:block" />
        <em class="italic">{"{even when you're not online}"}</em>.
      </h1>
      <p class="text-pink text-sm sm:text-base uppercase tracking-wide mb-6 max-w-xl mx-auto">
        {"{no content treadmill, no chasing the algorithm, just visibility systems that keep working long after you build them}"}
      </p>
      <p class="text-white text-base mb-8 max-w-xl mx-auto">
        For coaches, course creators and service providers who want consistent sales without living on social media, built on the exact system that took me from 0 to 7,000+ subscribers in 18 months, no ads, no algorithm.
      </p>
      <a href="https://kyliekelly.myflodesk.com/audience" class="btn-pink">Grab Your Next 1000 Subscribers →</a>
    </div>

    <div class="mt-6 mb-4">
      <div class="relative mx-auto w-[280px] sm:w-[360px] h-56 sm:h-72">
        <div class="relative">
          <div class="absolute top-2 left-0 w-[46%] bg-white p-2 pb-6 rounded-sm shadow-2xl -rotate-6">
            <img src="/images/hero-1.jpg" alt="Kylie Kelly" class="w-full rounded-sm" />
          </div>
          <div class="absolute top-0 left-[30%] w-[48%] bg-white p-2 pb-6 rounded-sm shadow-2xl rotate-3 z-10">
            <img src="/images/hero-2.jpg" alt="Kylie Kelly laughing" class="w-full rounded-sm" />
          </div>
          <div class="absolute top-16 left-[58%] w-[46%] bg-white p-2 pb-6 rounded-sm shadow-2xl -rotate-2 z-20">
