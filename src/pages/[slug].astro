---
import BlogPostLayout from '../layouts/BlogPostLayout.astro';
import ShowNotes from '../components/ShowNotes.astro';
import posts from '../data/blog-posts.json';
import showNotes from '../data/show-notes.json';
import { getEpisodes } from '../lib/episodes';
import { parseFeedNotes } from '../lib/feedNotes';
import { autoFullPage, isStructuredWriteUp, writeUpFor } from '../lib/showNotes';

export async function getStaticPaths() {
  const writeUps = posts
    .map((post) => ({
      params: { slug: post.slug },
      props: { post, ep: null },
    }));
  // Episodes with no write-up whose old address was a root address keep that exact address.
  const episodes = await getEpisodes();
  const fromFeed = episodes
    .filter((e) => e.newPage && /^\/[^/]+\/$/.test(e.href))
    .map((ep) => ({ params: { slug: ep.href.replace(/\//g, '') }, props: { post: null, ep } }));
  return [...writeUps, ...fromFeed];
}

const { post, ep } = Astro.props;
// Episodes listed in src/data/show-notes.json use the new show notes template.
const extra = post ? (showNotes as Record<string, any>)[post.slug] : null;
// A write-up in the standard format, with no entry of its own in show-notes.json, still gets the full template.
const auto = post && !extra && isStructuredWriteUp(post.content) ? autoFullPage(post.content, post.title, post.slug) : null;
const episodes = extra || auto || ep ? await getEpisodes() : [];
// A feed episode with a write-up of its own (src/data/episode-writeups.json) gets the full template too.
const feedWriteUp = ep ? writeUpFor(ep.href) : undefined;
const feedAuto = ep && feedWriteUp ? autoFullPage(feedWriteUp, ep.title, ep.href.split('/').filter(Boolean).pop(), ep.href) : null;
const feedPage = ep && !feedAuto ? parseFeedNotes(ep) : null;
---
{feedPage ? (
  <ShowNotes post={{ slug: ep.href, title: ep.title, date: ep.iso, excerpt: '', content: '' }} path={ep.href} notes={feedPage.notes} extra={feedPage.extra} episodes={episodes} />
) : feedAuto ? (
  <ShowNotes post={{ slug: ep.href, title: ep.title, date: ep.iso, excerpt: '', content: feedWriteUp }} path={ep.href} notes={feedAuto.notes} extra={feedAuto.extra} episodes={episodes} />
) : extra ? (
  <ShowNotes post={post} extra={extra} episodes={episodes} />
) : auto ? (
  <ShowNotes post={post} notes={auto.notes} extra={auto.extra} episodes={episodes} />
) : (
  <BlogPostLayout title={post.title} description={post.excerpt} date={post.date} kind={post.categories.includes(35) ? 'blog' : 'episode'}>
    <Fragment set:html={post.content} />
  </BlogPostLayout>
)}
