---
// Button for the podcast "one sheet takeaways" freebie.
// Kylie's rule (15 Nov 2026): every freebie spot links to the standalone opt-in page, never an embedded form.
// Usage: <PodcastSignup uid="band" />   (uid kept so existing placements don't change)
import ArrowButton from './ArrowButton.astro';
interface Props {
  uid: string;
  class?: string;
}
const { class: className = '' } = Astro.props;
const PAGE_LINK = 'https://kyliekelly.myflodesk.com/podcast'; // Flodesk opt-in page "Podcast Cheat Sheet"
---
<div class:list={['podcast-signup', className]}>
  <ArrowButton href={PAGE_LINK} label="Send me the cheat sheets" variant="dark" sameTab />
</div>
