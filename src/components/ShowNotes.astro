---
// Show notes page for one episode.
//
// The page is assembled from the episode's existing write-up (parsed in src/lib/showNotes.ts) plus the
// extra content in src/data/show-notes.json: a quick answer, key moments and FAQs.
// Two levels share this template:
//   "full"   : quick answer, what you'll learn, table of contents, the full write-up, FAQs and transcript
//   "simple" : quick answer, what you'll learn, key moments, links and guest
// Sections only appear when there is content for them, so a page is never left with an empty box.
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import EpisodeArt from './EpisodeArt.astro';
import PodcastFreebieBand from './PodcastFreebieBand.astro';
import AskKylieBand from './AskKylieBand.astro';
import { parseShowNotes, tagFindCoLab, tagFindCoLabUrl, type ParsedNotes } from '../lib/showNotes';
import { guestPhotoFor } from '../lib/guestPhotos';
import { waveBars } from '../lib/wave';
import { showName } from '../lib/show';
import type { Episode } from '../lib/episodes';

interface Props {
  post: { slug: string; title: string; date: string; excerpt: string; content: string };
  /** The page's own address, when it is not simply /<slug>/. */
  path?: string;
  /** Already-parsed notes (for episodes built from the Buzzsprout feed). Otherwise the write-up is parsed. */
  notes?: ParsedNotes;
  extra: {
    level: 'full' | 'simple';
    quickAnswer: string;
    quickAnswerLabel?: string;
    metaDescription: string;
    keyMoments: Array<{ time: string; label: string }>;
    faqs: Array<{ q: string; a: string }>;
  };
  episodes: Episode[];
}
const { post, extra, episodes, path } = Astro.props;
const pagePath = path ?? `/${post.slug}/`;

const decode = (s: string) =>
  s
    .replace(/&#(\d+);/g, (_, n) => String.fromCharCode(Number(n)))
    .replace(/&nbsp;/g, ' ')
    .replace(/&amp;/g, '&');
const parsedNotes = Astro.props.notes ?? parseShowNotes(post.content, post.slug);
// Find CoLab links are tagged with the episode and the spot on the page (see tagFindCoLab)
const campaign = pagePath.replace(/^\/+|\/+$/g, '').split('/').pop() || post.slug;
const notes: ParsedNotes = {
  ...parsedNotes,
  intro: tagFindCoLab(parsedNotes.intro ?? '', campaign, 'article'),
  sections: (parsedNotes.sections ?? []).map((s) => ({ ...s, html: tagFindCoLab(s.html, campaign, 'article') })),
  links: (parsedNotes.links ?? []).map((l) => tagFindCoLab(l, campaign, 'links-mentioned')),
  cta: parsedNotes.cta ? { ...parsedNotes.cta, href: tagFindCoLabUrl(parsedNotes.cta.href, campaign, 'cta-box') } : parsedNotes.cta,
};
const numInContent = post.content.match(/EP\w*\s*(\d+)/i)?.[1] ?? '';
const episode = episodes.find((e) => e.href === pagePath) ?? (numInContent ? episodes.find((e) => e.num === numInContent) : undefined);
const num = episode?.num ?? numInContent;
const seoTitle = decode(post.title); // the title Google already knows this page by
const title = episode?.title ?? seoTitle; // what the page shows, matching the episode library, Apple and Spotify
// The guest: named in the title ("... with Name"), or failing that in the write-up's "Guest Spotlight: Name" section.
const guest = episode?.guest ?? notes.guestSection?.title.replace(/^(guest spotlight|about)\s*:?\s*/i, '').trim() ?? null;
const guestPhoto = num ? guestPhotoFor(num) : undefined;
const isFull = extra.level === 'full';

const published = new Date(post.date);
const dateLabel = published.toLocaleDateString('en-AU', { day: 'numeric', month: 'long', year: 'numeric' });
const words = [notes.intro, ...notes.sections.map((s) => s.html)].join(' ').replace(/<[^>]+>/g, ' ').split(/\s+/).filter(Boolean).length;
const readMins = Math.max(1, Math.round(words / 220));

// Related episodes: the ones sharing the most topics with this one, newest first.
const related = episode
  ? episodes
      .filter((e) => e.num !== episode.num)
      .map((e) => ({ e, overlap: e.topics.filter((t) => episode.topics.includes(t)).length }))
      .filter((r) => r.overlap > 0)
      .sort((a, b) => b.overlap - a.overlap || Number(b.e.num) - Number(a.e.num))
      .slice(0, 3)
      .map((r) => r.e)
  : [];
const idx = episode ? episodes.findIndex((e) => e.num === episode.num) : -1;
const newer = idx > 0 ? episodes[idx - 1] : null;
const older = idx >= 0 && idx < episodes.length - 1 ? episodes[idx + 1] : null;

// "Find me elsewhere" links in the sidebar. A link with no address is left out until one is added.
const elsewhere = [
  { icon: '🛍️', label: 'The Shop', href: 'https://shop.kyliekelly.com/' },
  { icon: '👯‍♀️', label: 'Free Community', href: 'https://www.skool.com/email-marketing-skool/about' },
  { icon: '✲', label: 'Find CoLab', href: tagFindCoLabUrl('https://findcolab.com/', campaign, 'sidebar') },
  { icon: '🎥', label: 'YouTube', href: 'https://www.youtube.com/@KylieKelly' },
];
const showToc = isFull && notes.sections.length >= 4;
const norm = (u: string) => u.toLowerCase().replace(/^https?:\/\/(www\.)?/, '').replace(/\/+$/, '');
const guestHrefs = new Set([...(notes.guestSection?.html ?? '').matchAll(/href="([^"]+)"/g)].map((m) => norm(m[1])));
const links = !isFull && notes.guestSection
  ? notes.links.filter((l) => {
      const h = l.match(/href="([^"]+)"/)?.[1];
      return !h || !guestHrefs.has(norm(h));
    })
  : notes.links;
const arrow = 'M4 12L12 4M5.5 4H12v6.5';
const playIcon = 'M5 3.5v9l7.5-4.5z';
const site = Astro.site ?? new URL('https://kyliekelly.com');
const pageUrl = new URL(pagePath, site).toString();
const coverUrl = new URL('/images/podcast-cover.jpg', site).toString();
const show = { '@type': 'PodcastSeries', name: showName(num), url: new URL('/podcast/', site).toString() };
const kylie = { '@type': 'Person', name: 'Kylie Kelly', url: new URL('/meet-kylie/', site).toString() };

const graph: Record<string, unknown>[] = [
  {
    '@type': 'PodcastEpisode',
    '@id': `${pageUrl}#episode`,
    url: pageUrl,
    name: title,
    description: extra.metaDescription,
    datePublished: published.toISOString(),
    ...(num ? { episodeNumber: Number(num) } : {}),
    ...(episode?.mins ? { timeRequired: `PT${episode.mins}M` } : {}),
    image: coverUrl,
    partOfSeries: show,
    author: kylie,
    ...(guest ? { actor: { '@type': 'Person', name: guest, ...(notes.guestUrl ? { url: notes.guestUrl } : {}) } } : {}),
  },
  {
    '@type': 'BlogPosting',
    '@id': `${pageUrl}#article`,
    headline: title,
    description: extra.metaDescription,
    datePublished: published.toISOString(),
    dateModified: published.toISOString(),
    mainEntityOfPage: pageUrl,
    image: coverUrl,
    author: kylie,
    publisher: kylie,
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: showName(num), item: new URL('/podcast/', site).toString() },
      { '@type': 'ListItem', position: 2, name: 'Episode library', item: new URL('/podcast/archive/', site).toString() },
      { '@type': 'ListItem', position: 3, name: title, item: pageUrl },
    ],
  },
];
if (isFull && extra.faqs.length) {
  graph.push({
    '@type': 'FAQPage',
    mainEntity: extra.faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  });
}
// Pinterest "save" address: this page, the episode's Pinterest graphic and the title.
const pinUrl = notes.pin
  ? `https://www.pinterest.com/pin/create/button/?url=${encodeURIComponent(pageUrl)}&media=${encodeURIComponent(new URL(notes.pin, site).toString())}&description=${encodeURIComponent(title)}`
  : '';
const jsonLd = JSON.stringify({ '@context': 'https://schema.org', '@graph': graph });
const playerHtml = notes.player ? `<div id="buzzsprout-player-${notes.player.id}"></div><script src="${notes.player.src}" type="text/javascript"></` + `script>` : '';
---
<Layout title={`${seoTitle} | ${showName(num)}`} description={extra.metaDescription}>
  <script type="application/ld+json" slot="head" set:html={jsonLd} />

  <section class="bg-black text-white px-6 py-4">
    <p class="max-w-4xl mx-auto flex items-center justify-center gap-4 text-xs sm:text-sm font-normal uppercase tracking-widest text-center">
      <span class="hidden sm:block h-px flex-1 bg-white/30"></span>
      {showName(num)} &middot; Show notes
      <span class="hidden sm:block h-px flex-1 bg-white/30"></span>
    </p>
  </section>

  <article>
    <!-- HERO -->
    <header class="bg-offwhite px-6 pt-10 pb-14 sm:pt-14 sm:pb-20">
      <div class="max-w-6xl mx-auto">
        <div class="mb-8 flex flex-wrap items-center gap-x-6 gap-y-4">
          <a href="/podcast/archive" class="inline-flex items-center gap-2 rounded-full border border-black/20 bg-white px-4 py-2 text-xs uppercase tracking-widest font-semibold text-black hover:border-pink hover:text-pink transition-colors">
            <span aria-hidden="true">&larr;</span> All episodes
          </a>
          <nav aria-label="Breadcrumb" class="text-xs uppercase tracking-widest font-semibold text-black/70">
            <a href="/podcast" class="hover:text-pink">{showName(num)}</a>
            <span aria-hidden="true" class="mx-2">/</span>
            <a href="/podcast/archive" class="hover:text-pink">Episode library</a>
            {num && (<><span aria-hidden="true" class="mx-2">/</span><span class="text-black">Episode {num}</span></>)}
          </nav>
        </div>

        <div class="grid items-center gap-10 md:grid-cols-[1.25fr_0.75fr] md:gap-14">
          <div>
            <p class="text-pink text-xs uppercase tracking-widest font-semibold mb-4">
              {num ? `Episode ${num}` : 'Episode'} &middot; {guest ? `With ${guest}` : 'Solo episode'}
            </p>
            <h1 class="font-serif font-bold text-3xl sm:text-5xl leading-[1.1] text-balance mb-5">{title}</h1>
            <p class="text-[11px] sm:text-xs uppercase tracking-widest font-semibold text-black/70 mb-7">
              <time datetime={published.toISOString().slice(0, 10)}>{dateLabel}</time>
              {episode?.mins && <span> &middot; {episode.mins} min listen</span>}
              {isFull && <span> &middot; {readMins} min read</span>}
            </p>

            <div class="mb-8 rounded-[1.5rem] bg-white p-6 shadow-[0_12px_30px_rgba(0,0,0,0.06)]">
              <p class="text-pink text-xs uppercase tracking-widest font-semibold mb-2">{extra.quickAnswerLabel ?? 'The quick answer'}</p>
              <p class="text-[17px] leading-relaxed text-black">{extra.quickAnswer}</p>
            </div>

            <div class="flex flex-col gap-3 sm:flex-row sm:flex-wrap sm:items-center">
              <a href="https://podcasts.apple.com/podcast/id1550211753" target="_blank" rel="noopener" class="group inline-flex items-center gap-4 rounded-full bg-black text-white pl-6 pr-2 py-2 text-[15px] font-semibold transition-transform duration-300 hover:-translate-y-1">
                Listen on Apple
                <span class="grid place-items-center h-10 w-10 rounded-full bg-pink text-white"><svg viewBox="0 0 16 16" class="h-4 w-4 transition-transform duration-300 group-hover:rotate-45" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={arrow} /></svg></span>
              </a>
              <a href="https://open.spotify.com/show/69feUlzhejQl1xIMpCLyC3" target="_blank" rel="noopener" class="group inline-flex items-center gap-4 rounded-full bg-white text-black pl-6 pr-2 py-2 text-[15px] font-semibold shadow-[0_8px_30px_rgba(0,0,0,0.06)] transition-transform duration-300 hover:-translate-y-1">
                Listen on Spotify
                <span class="grid place-items-center h-10 w-10 rounded-full bg-black text-white"><svg viewBox="0 0 16 16" class="h-4 w-4 transition-transform duration-300 group-hover:rotate-45" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={arrow} /></svg></span>
              </a>
              <div class="flex items-center gap-4">
                <a href="https://emailgrowthshow.buzzsprout.com/share" target="_blank" rel="noopener" class="inline-flex items-center gap-2 px-1 py-3 text-[15px] font-semibold underline underline-offset-4 decoration-black/30 hover:decoration-pink">
                  All platforms <span aria-hidden="true">&rarr;</span>
                </a>
  {pinUrl && (
                  <a href={pinUrl} target="_blank" rel="noopener" aria-label="Save this episode to Pinterest" title="Save to Pinterest" class="grid h-14 w-14 flex-none place-items-center rounded-full border-[1.5px] border-black text-black transition duration-300 hover:-translate-y-1 hover:bg-black hover:text-white">
                    <svg viewBox="0 0 24 24" class="h-5 w-5" fill="currentColor" aria-hidden="true"><path d="M12.017 0C5.396 0 .029 5.367.029 11.987c0 5.079 3.158 9.417 7.618 11.162-.105-.949-.199-2.403.041-3.439.219-.937 1.406-5.957 1.406-5.957s-.359-.72-.359-1.781c0-1.663.967-2.911 2.168-2.911 1.024 0 1.518.769 1.518 1.688 0 1.029-.653 2.567-.992 3.992-.285 1.193.6 2.165 1.775 2.165 2.128 0 3.768-2.245 3.768-5.487 0-2.861-2.063-4.869-5.008-4.869-3.41 0-5.409 2.562-5.409 5.199 0 1.033.394 2.143.889 2.741.099.12.112.225.085.345-.09.375-.293 1.199-.334 1.363-.053.225-.172.271-.401.165-1.495-.69-2.433-2.878-2.433-4.646 0-3.776 2.748-7.252 7.92-7.252 4.158 0 7.392 2.967 7.392 6.923 0 4.135-2.607 7.462-6.233 7.462-1.214 0-2.354-.629-2.758-1.379l-.749 2.848c-.269 1.045-1.004 2.352-1.498 3.146 1.123.345 2.306.535 3.55.535 6.607 0 11.985-5.365 11.985-11.987C23.97 5.39 18.592.026 11.985.026L12.017 0z" /></svg>
                  </a>
                )}
              </div>
            </div>
          </div>

          {num && (
            <div class="mx-auto w-[72%] max-w-[320px] md:w-full">
              <EpisodeArt num={num} title={title.replace(/\s*\[Ep\.?\s*#?\d+\]\s*$/i, '')} guest={guest} />
            </div>
          )}
        </div>
      </div>
    </header>

    <!-- BODY: one main column and a sidebar, so every block lines up -->
    <div class="bg-white px-6 pt-12 pb-16 sm:pb-20">
      <div class="max-w-6xl mx-auto grid gap-12 lg:grid-cols-[minmax(0,1fr)_300px] lg:gap-14">

        <div class="min-w-0 space-y-8">

          {playerHtml && (
            <section>
              <h2 class="sr-only">Listen to the episode</h2>
              <div class="rounded-[1.5rem] border border-black/10 bg-white p-4 sm:p-5" set:html={playerHtml} />
            </section>
          )}

          <!-- WHAT YOU'LL LEARN (beside the contents on the full version) -->
          {(notes.takeaways.length > 0 || showToc) && (
            <div class={`grid items-stretch gap-6 ${notes.takeaways.length > 0 && showToc ? 'md:grid-cols-2' : ''}`}>
              {notes.takeaways.length > 0 && (
                <section class="rounded-[1.75rem] bg-[#e9d9ec] p-7 sm:p-8">
                  <h2 class="font-serif font-bold italic text-2xl sm:text-3xl mb-5">What you'll learn</h2>
                  <ul class="space-y-3">
                    {notes.takeaways.map((t) => (
                      <li class="flex items-start gap-3">
                        <span class="mt-1 grid h-5 w-5 flex-none place-items-center rounded-full bg-pink text-white" aria-hidden="true"><svg viewBox="0 0 16 16" class="h-3 w-3" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 8h9M8.5 4l4 4-4 4" /></svg></span>
                        <span class="leading-relaxed">{t}</span>
                      </li>
                    ))}
                  </ul>
                </section>
              )}
              {showToc && (
                <nav aria-labelledby="toc-title" class="rounded-[1.75rem] border border-black/10 p-7 sm:p-8">
                  <h2 id="toc-title" class="font-serif font-bold italic text-2xl sm:text-3xl mb-5">In this episode</h2>
                  <ol class="space-y-3">
                    {notes.sections.map((s, i) => (
                      <li class="flex items-baseline gap-3">
                        <span class="font-serif text-pink text-lg w-6 flex-none">{String(i + 1).padStart(2, '0')}</span>
                        <a href={`#${s.id}`} class="leading-snug underline-offset-4 hover:text-pink hover:underline">{s.title}</a>
                      </li>
                    ))}
                  </ol>
                </nav>
              )}
            </div>
          )}

          <!-- LINKS MENTIONED -->
          {links.length > 0 && (
            <section class="rounded-[1.75rem] border-[1.5px] border-black p-7 sm:p-8">
              <h2 class="text-pink text-xs uppercase tracking-[0.18em] font-semibold mb-4">Links mentioned</h2>
              <ul class="space-y-3 links-list">
                {links.map((l) => (
                  <li class="flex gap-3"><span class="text-pink" aria-hidden="true">&rarr;</span><span class="min-w-0 break-words" set:html={l} /></li>
                ))}
              </ul>
            </section>
          )}

          <!-- INTRO + THE WRITE-UP -->
          <div class="notes-body pt-2">
            {notes.intro && <div set:html={notes.intro} />}
            {isFull && notes.sections.map((s) => (
              <section class="scroll-mt-24">
                <h2 id={s.id}>{s.title}</h2>
                <div set:html={s.html} />
              </section>
            ))}
          </div>

          <!-- GUEST -->
          {guest && notes.guestSection && (
            <section class="rounded-[1.75rem] bg-offwhite p-7 sm:p-8">
              <h2 class="font-serif font-bold italic text-2xl sm:text-3xl mb-6">About {guest}</h2>
              <div class="flex flex-col gap-6 sm:flex-row sm:items-start">
                {guestPhoto ? (
                  <Image src={guestPhoto} alt={`${guest}, guest on ${showName(num)}`} widths={[200, 360]} sizes="160px" class="h-40 w-40 flex-none rounded-2xl object-cover object-[50%_22%]" loading="lazy" />
                ) : notes.guestImage ? (
                  <img src={notes.guestImage} alt={`${guest}, guest on ${showName(num)}`} class="h-40 w-40 flex-none rounded-2xl object-cover object-[50%_22%]" width="160" height="160" loading="lazy" />
                ) : null}
                <div class="notes-body notes-body--tight min-w-0 break-words" set:html={notes.guestSection.html} />
              </div>
            </section>
          )}

          <!-- CALL TO ACTION (full version only; the simple version uses the cheat-sheet signup instead) -->
          {isFull && notes.cta && (
            <section class="rounded-[1.75rem] bg-black px-7 py-12 text-center text-white sm:px-12">
              <p class="font-serif italic text-pink text-xl mb-2">{notes.cta.eyebrow}</p>
              <h2 class="font-serif font-bold text-2xl sm:text-3xl leading-tight mb-4 text-balance">{notes.cta.headline}</h2>
              <p class="mx-auto mb-7 max-w-md text-warmgray leading-relaxed">{notes.cta.text}</p>
              <a href={notes.cta.href} class="inline-block rounded-full bg-pink px-8 py-3.5 text-[13px] font-semibold uppercase tracking-[0.08em] text-white transition-transform duration-300 hover:-translate-y-1">{notes.cta.label}</a>
            </section>
          )}

          <!-- FAQ -->
          {isFull && extra.faqs.length > 0 && (
            <section class="pt-8">
              <h2 class="font-serif font-bold italic text-3xl sm:text-4xl mb-8">Frequently asked questions</h2>
              <dl class="divide-y divide-black/10 border-y border-black/10">
                {extra.faqs.map((f) => (
                  <div class="py-6">
                    <dt class="font-serif font-bold text-xl leading-snug mb-2">{f.q}</dt>
                    <dd class="text-[17px] leading-relaxed text-black">{f.a}</dd>
                  </div>
                ))}
              </dl>
            </section>
          )}

          <!-- TRANSCRIPT -->
          {notes.transcript.length > 0 && (
            <details class="group rounded-[1.5rem] border border-black/10 p-6 sm:p-8">
              <summary class="cursor-pointer list-none flex items-center justify-between gap-4 font-serif font-bold text-lg uppercase tracking-[0.1em]">
                Read the full transcript
                <span class="grid h-9 w-9 flex-none place-items-center rounded-full bg-black text-white text-lg leading-none transition-transform duration-300 group-open:rotate-45" aria-hidden="true">+</span>
              </summary>
              <div class="mt-6 space-y-4 text-[15px] leading-relaxed text-black/85">
                {notes.transcript.map((t) => (
                  <p><span class="mr-2 font-semibold tabular-nums text-pink">{t.time.replace(/^00:/, '')}</span>{t.speaker && <strong class="mr-1">{t.speaker}:</strong>}{t.text}</p>
                ))}
              </div>
            </details>
          )}

          <!-- CHEAT SHEET SIGN-UP -->
          <PodcastFreebieBand uid="notes" />

          <!-- RELATED -->
          {related.length > 0 && (
            <section class="pt-10">
              <h2 class="font-serif font-bold italic text-3xl sm:text-4xl mb-8">More to listen to</h2>
              <div class="grid grid-cols-1 gap-x-5 gap-y-10 sm:grid-cols-3">
                {related.map((e) => (
                  <a href={e.href} class="group block" {...(e.href.startsWith('http') ? { target: '_blank', rel: 'noopener' } : {})}>
                    <EpisodeArt num={e.num} title={e.title} guest={e.guest} class="transition-transform duration-300 group-hover:-translate-y-1.5" />
                    <div class="mt-4 flex items-center gap-3 px-1">
                      <span class="grid place-items-center h-10 w-10 flex-none rounded-full bg-pink text-white transition-transform duration-300 group-hover:scale-110" aria-hidden="true"><svg viewBox="0 0 16 16" class="h-4 w-4 translate-x-[1px]" fill="currentColor"><path d={playIcon} /></svg></span>
                      <span class="wave min-w-0 flex-1" style="height:26px" aria-hidden="true">
                        {waveBars(Number(e.num) * 0.37, 20).map((h, j) => <i style={`--h:${h};--d:${((j * 7) % 11) * 0.1}s`}></i>)}
                      </span>
                    </div>
                  </a>
                ))}
              </div>
            </section>
          )}

          <!-- NEWER / OLDER -->
          {(newer || older) && (
            <nav aria-label="More episodes" class="grid gap-4 pt-4 sm:grid-cols-2">
              {older ? (
                <a href={older.href} class="rounded-[1.5rem] border border-black/10 p-6 transition-colors hover:border-pink" {...(older.href.startsWith('http') ? { target: '_blank', rel: 'noopener' } : {})}>
                  <p class="text-xs uppercase tracking-widest font-semibold text-black/60 mb-2">&larr; Previous episode</p>
                  <p class="font-serif font-bold leading-snug">{older.title}</p>
                </a>
              ) : <span></span>}
              {newer ? (
                <a href={newer.href} class="rounded-[1.5rem] border border-black/10 p-6 text-left transition-colors hover:border-pink sm:text-right" {...(newer.href.startsWith('http') ? { target: '_blank', rel: 'noopener' } : {})}>
                  <p class="text-xs uppercase tracking-widest font-semibold text-black/60 mb-2">Next episode &rarr;</p>
                  <p class="font-serif font-bold leading-snug">{newer.title}</p>
                </a>
              ) : <span></span>}
            </nav>
          )}

          <AskKylieBand />
        </div>

