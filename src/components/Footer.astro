---
const year = new Date().getFullYear();
---
<footer class="bg-black text-white pt-16 pb-8 px-6">
  <div class="max-w-6xl mx-auto grid grid-cols-1 md:grid-cols-3 gap-10">
    <div>
      <p class="font-sans tracking-widest text-sm uppercase mb-3">Kylie&nbsp;|&nbsp;Kelly</p>
      <p class="text-sm text-warmgray max-w-xs">
        Kylie Kelly is a visibility coach, helping female entrepreneurs grow their email list fast, without social media.
      </p>
    </div>
    <div>
      <p class="text-xs uppercase tracking-wide mb-3 text-pink">Connect</p>
      <ul class="text-sm space-y-2 text-warmgray">
        <li><a href="/podcast" class="hover:text-white">Podcast</a></li>
        <li><a href="/services" class="hover:text-white">Work With Me</a></li>
        <li><a href="/meet-kylie" class="hover:text-white">Meet Kylie</a></li>
        <li><a href="/resources" class="hover:text-white">Resources</a></li>
        <li><a href="/press" class="hover:text-white">Press</a></li>
        <li><a href="/contact" class="hover:text-white">Contact</a></li>
      </ul>
    </div>
    <div>
      <p class="text-xs uppercase tracking-wide mb-3 text-pink">Elsewhere</p>
      <ul class="text-sm space-y-2 text-warmgray">
        <li><a href="https://www.instagram.com/the_kyliekelly/" class="hover:text-white">Instagram</a></li>
        <li><a href="https://www.pinterest.com.au/heykyliekelly/" class="hover:text-white">Pinterest</a></li>
        <li><a href="https://www.skool.com/email-marketing-skool/about" class="hover:text-white">Free Skool Community</a></li>
        <li><a href="https://student.kyliekelly.com/" class="hover:text-white">Student Login</a></li>
      </ul>
    </div>
  </div>
  <div class="max-w-6xl mx-auto mt-12 pt-6 border-t border-white/10 flex flex-col sm:flex-row justify-between gap-3 text-xs text-warmgray">
    <p>&copy; {year} Kylie Kelly</p>
    <div class="flex gap-4">
      <a href="/privacy-policy" class="hover:text-white">Privacy Policy</a>
      <a href="/privacy-policy" class="hover:text-white">Terms &amp; Conditions</a>
    </div>
  </div>
</footer>
