---
const year = new Date().getFullYear();
---
<footer class="bg-black text-white pt-20 pb-10 px-6">
  <div class="max-w-6xl mx-auto grid grid-cols-1 md:grid-cols-3 gap-12">
    <div>
      <p class="font-serif italic text-2xl mb-4">Kylie Kelly.</p>
      <p class="text-sm text-warmgray max-w-xs mb-6">
        Helping women get known, trusted, and selling to the right people, through email and real relationships. Never an algorithm.
      </p>
      <p class="text-sm text-warmgray mb-4">hello@kyliekelly.com</p>
      <div class="flex gap-4 text-xs uppercase tracking-wide font-semibold">
        <a href="https://www.skool.com/email-marketing-skool/about" class="text-pink hover:text-white">Community</a>
        <span class="text-warmgray">&middot;</span>
        <a href="https://shop.kyliekelly.com/" class="text-pink hover:text-white">Shop</a>
      </div>
    </div>
    <div>
      <p class="text-xs uppercase tracking-widest font-semibold mb-4 text-pink">Explore</p>
      <ul class="text-sm space-y-3 text-warmgray">
        <li><a href="/services" class="hover:text-white">Work With Me</a></li>
        <li><a href="/podcast" class="hover:text-white">Podcast</a></li>
        <li><a href="/meet-kylie" class="hover:text-white">Meet Kylie</a></li>
        <li><a href="https://shop.kyliekelly.com/" class="hover:text-white">Shop</a></li>
        <li><a href="https://www.skool.com/email-marketing-skool/about" class="hover:text-white">Community</a></li>
        <li><a href="https://student.kyliekelly.com/" class="hover:text-white">Student Login</a></li>
      </ul>
    </div>
    <div>
      <p class="text-xs uppercase tracking-widest font-semibold mb-4 text-pink">The Fine Print</p>
      <ul class="text-sm space-y-3 text-warmgray">
        <li><a href="/privacy-policy" class="hover:text-white">Privacy Policy</a></li>
        <li><a href="/terms" class="hover:text-white">Terms &amp; Conditions</a></li>
        <li><a href="/disclaimer" class="hover:text-white">Disclaimer</a></li>
      </ul>
    </div>
  </div>
  <div class="max-w-6xl mx-auto mt-14 pt-6 border-t border-white/10 text-center">
    <p class="text-xs text-warmgray">Copyright &copy; {year} &middot; Kylie Kelly</p>
  </div>
</footer>
