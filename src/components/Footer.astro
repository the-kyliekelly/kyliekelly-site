---
const year = new Date().getFullYear();

const chips = [
  { label: 'Listen to the podcast', href: '/podcast' },
  { label: 'Join the free community', href: 'https://www.skool.com/email-marketing-skool/about' },
  { label: 'Shop the digital shop', href: 'https://shop.kyliekelly.com/' },
  { label: 'Find your next collab', href: 'https://findcolab.com/?utm_source=website&utm_medium=footer&utm_campaign=site-footer' },
];

const arrow = 'M4 12L12 4M5.5 4H12v6.5';
---
<footer class="bg-black text-white pt-20 pb-10 px-6">
  <div class="relative max-w-6xl mx-auto">
    <a href="#top" data-back-to-top class="absolute right-0 top-0 hidden flex-col items-center gap-3 text-[11px] font-semibold uppercase tracking-[0.2em] text-[#d5b9db] transition-colors hover:text-white lg:flex" aria-label="Back to top">
      <svg viewBox="0 0 16 40" class="h-10 w-4" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M8 38V3M3 8l5-5 5 5" /></svg>
      <span style="writing-mode: vertical-rl;">Back to top</span>
    </a>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-12 lg:pr-14">
      <div>
        <p class="font-serif italic text-2xl mb-4">Kylie Kelly.</p>
        <p class="text-sm text-warmgray max-w-xs mb-6">
          Helping women get known, trusted, and selling to the right people, through email and real relationships. Never an algorithm.
        </p>
        <p class="text-sm text-warmgray mb-6">hello@kyliekelly.com</p>
        <ul class="grid max-w-sm grid-cols-2 gap-3">
          {chips.map((c) => (
            <li>
              <a href={c.href} class="group flex h-full items-center gap-3 border border-white/20 bg-white/5 px-3 py-3 text-[11px] font-semibold uppercase leading-snug tracking-[0.12em] transition-colors hover:border-pink hover:bg-pink">
                <span class="grid h-6 w-6 flex-none place-items-center rounded-full bg-pink text-white transition-colors group-hover:bg-white group-hover:text-pink"><svg viewBox="0 0 16 16" class="h-3 w-3" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={arrow} /></svg></span>
                {c.label}
              </a>
            </li>
          ))}
        </ul>
      </div>
      <div>
        <p class="text-xs uppercase tracking-widest font-semibold mb-4 text-pink">Explore</p>
        <ul class="text-sm space-y-3 text-warmgray">
          <li><a href="/services" class="hover:text-white">Work With Me</a></li>
          <li><a href="/podcast" class="hover:text-white">Podcast</a></li>
          <li><a href="/ask-kylie" class="hover:text-white">Ask Kylie</a></li>
          <li><a href="/blog" class="hover:text-white">Blog</a></li>
          <li><a href="/meet-kylie" class="hover:text-white">Meet Kylie</a></li>
          <li><a href="https://shop.kyliekelly.com/" class="hover:text-white">Shop</a></li>
          <li><a href="/resources" class="hover:text-white">Favorites</a></li>
          <li><a href="https://www.skool.com/email-marketing-skool/about" class="hover:text-white">Community</a></li>
          <li><a href="https://system.kyliekelly.com/my-learning" class="hover:text-white">Student Login</a></li>
          <li><a href="/contact" class="hover:text-white">Contact</a></li>
        </ul>
      </div>
      <div>
        <p class="text-xs uppercase tracking-widest font-semibold mb-4 text-pink">The Fine Print</p>
        <ul class="text-sm space-y-3 text-warmgray">
          <li><a href="/privacy-policy" class="hover:text-white">Privacy Policy</a></li>
          <li><a href="/terms" class="hover:text-white">Terms &amp; Conditions</a></li>
          <li><a href="/disclaimer" class="hover:text-white">Disclaimer</a></li>
          <li><button type="button" data-cookie-settings class="hover:text-white cursor-pointer">Cookie settings</button></li>
        </ul>
      </div>
    </div>
  </div>
  <div class="max-w-6xl mx-auto mt-14 pt-6 border-t border-white/10 text-center">
    <p class="text-xs text-warmgray">Copyright &copy; {year} &middot; Kylie Kelly</p>
  </div>
</footer>

<script>
  document.querySelectorAll<HTMLAnchorElement>('[data-back-to-top]').forEach((a) => {
    a.addEventListener('click', (e) => {
      e.preventDefault();
      window.scrollTo({ top: 0, behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth' });
    });
  });
</script>
