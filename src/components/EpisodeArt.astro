---
// Cover art for an episode: a coloured backdrop, the show title, a cut-out portrait of Kylie,
// and a colour band with the episode number and title.
// Every image in src/assets/episode-art is used (filename order). They are cut-outs with a
// transparent background, so the backdrop colour shows behind them. Add more cut-outs there and
// they appear on the next build, so new episodes always get their own cover.
// Usage: <EpisodeArt num="272" title="Why Some People Get Invited to Everything" />
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  num: string;
  title: string;
  class?: string;
}
const { num, title, class: className = '' } = Astro.props;

const found = import.meta.glob<{ default: ImageMetadata }>('../assets/episode-art/*.{jpg,jpeg,png,webp,JPG,JPEG,PNG,WEBP}', { eager: true });
// File names look like 03-magenta-smile.webp. The middle word says what she is wearing, so the
// backdrop can be chosen to suit it (a magenta top never lands on a magenta backdrop).
const entries = Object.entries(found)
  .sort(([a], [b]) => a.localeCompare(b))
  .map(([path, mod]) => ({ img: mod.default, tone: path.split('/').pop()?.match(/^\d+-([a-z]+)-/)?.[1] ?? '' }));

// Backdrop, title colours and band for each look. Mixed with the portraits so every cover differs.
const looks = [
  { back: 'bg-[#e9d9ec]', show: 'text-pink', sub: 'text-black', band: 'bg-black text-white' }, // 0 lilac
  { back: 'bg-pink', show: 'text-white', sub: 'text-white', band: 'bg-white text-black' }, // 1 pink
  { back: 'bg-[#fbe6f7]', show: 'text-pink', sub: 'text-black', band: 'bg-pink text-white' }, // 2 blush
  { back: 'bg-black', show: 'text-pink', sub: 'text-white', band: 'bg-[#e9d9ec] text-black' }, // 3 black
  { back: 'bg-pink-light', show: 'text-black', sub: 'text-black', band: 'bg-pink text-white' }, // 4 mauve
];
// Which backdrops work with which outfit.
const suits: Record<string, number[]> = {
  lilac: [1, 3, 2],
  sequin: [0, 3, 4],
  magenta: [0, 2, 3],
  blazer: [1, 2, 4, 0],
};
const n = Number(num) || 0;
const pick = entries.length ? entries[n % entries.length] : null;
const photo = pick?.img ?? null;
const allowed = (pick && suits[pick.tone]) || looks.map((_, i) => i);
// Shift the backdrop each time the portraits cycle round, so a repeat photo gets a new colour.
const look = looks[allowed[(n + Math.floor(n / Math.max(entries.length, 1))) % allowed.length]];
---
<div class:list={['bg-white p-2 sm:p-2.5 shadow-[0_18px_40px_rgba(0,0,0,0.12)]', className]}>
  <div class:list={['relative flex aspect-[3/4.7] flex-col overflow-hidden', look.back]}>
    <div class="relative z-10 px-3 pt-4 text-center">
      <p class:list={['font-serif italic font-bold leading-none text-[16px] md:text-[23px]', look.show]}>The Email Growth Show</p>
      <p class:list={['mt-1.5 text-[8px] sm:text-[9px] uppercase tracking-[0.16em] font-semibold', look.sub]}>Grow your list without social media</p>
    </div>
    <div class="relative flex-1 min-h-0">
      {photo && (
        <Image src={photo} alt="" widths={[320, 480, 640]} sizes="(min-width: 768px) 300px, 70vw" class="absolute inset-0 h-full w-full object-contain object-bottom" loading="lazy" />
      )}
    </div>
    <div class:list={['px-3 py-3 text-center', look.band]}>
      <p class="font-serif leading-tight text-[13px] sm:text-[15px] line-clamp-4 text-balance">EP {num}: {title}</p>
      <p class="mt-2 text-[8px] sm:text-[9px] uppercase tracking-[0.16em] font-semibold opacity-90">With Kylie Kelly</p>
    </div>
  </div>
</div>
