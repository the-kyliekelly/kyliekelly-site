---
// Cover art for an episode: a white banner with the show title, a photo of Kylie, and a colour band
// with the episode number and title.
// Photos live in src/assets/episode-photos. Each one is cropped so her face is the same size and
// in the same spot, which keeps every cover consistent. Add more photos there and they appear on
// the next build, so new episodes always get their own cover.
// Usage: <EpisodeArt num="272" title="Why Some People Get Invited to Everything" />
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  num: string;
  title: string;
  class?: string;
}
const { num, title, class: className = '' } = Astro.props;

const found = import.meta.glob<{ default: ImageMetadata }>('../assets/episode-photos/*.{jpg,jpeg,png,webp,JPG,JPEG,PNG,WEBP}', { eager: true });
const photos = Object.entries(found)
  .sort(([a], [b]) => a.localeCompare(b))
  .map(([, mod]) => mod.default);

const bands = [
  'bg-black text-white',
  'bg-pink text-white',
  'bg-[#e9d9ec] text-black',
  'bg-[#fbe6f7] text-black',
];
const n = Number(num) || 0;
const photo = photos.length ? photos[n % photos.length] : null;
// Shift the band colour each time the photos cycle round, so a repeated photo gets a new colour.
const band = bands[(n + Math.floor(n / Math.max(photos.length, 1))) % bands.length];
---
<div class:list={['bg-white p-2 sm:p-2.5 shadow-[0_18px_40px_rgba(0,0,0,0.12)]', className]}>
  <div class="flex flex-col overflow-hidden bg-white">
    <div class="flex h-[58px] flex-col items-center justify-center px-3 text-center">
      <p class="font-serif italic font-bold leading-none text-pink text-[16px] md:text-[21px]">The Email Growth Show</p>
      <p class="mt-1.5 text-[7.5px] sm:text-[8.5px] uppercase tracking-[0.16em] font-semibold text-black">Grow your list without social media</p>
    </div>
    <div class="relative aspect-[0.88] bg-[#dcd7dc]">
      {photo && (
        <Image src={photo} alt="" widths={[320, 480, 640]} sizes="(min-width: 768px) 300px, 70vw" class="absolute inset-0 h-full w-full object-cover object-top" loading="lazy" />
      )}
    </div>
    <div class:list={['flex h-[104px] flex-col items-center justify-center px-3 text-center', band]}>
      <p class="font-serif leading-tight text-[13px] sm:text-[14px] line-clamp-3 text-balance">EP {num}: {title}</p>
      <p class="mt-2 text-[8px] sm:text-[9px] uppercase tracking-[0.16em] font-semibold opacity-90">With Kylie Kelly</p>
    </div>
  </div>
</div>
