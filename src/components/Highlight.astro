---
// Marker-style highlight that draws left to right behind a phrase the first time it scrolls into view.
// Usage: <Highlight>without social media</Highlight>
// Without JavaScript, or with reduced motion on, the highlight is simply there.
---
<span class="hl"><slot /></span><style>
  .hl {
    background-image: linear-gradient(rgba(224, 64, 251, 0.26), rgba(224, 64, 251, 0.26));
    background-repeat: no-repeat;
    background-position: 0 82%;
    background-size: 100% 62%;
    -webkit-box-decoration-break: clone;
    box-decoration-break: clone;
    padding: 0 0.1em;
    margin: 0 -0.1em;
  }
  .hl[data-hl="pending"] {
    background-size: 0% 62%;
  }
  .hl[data-hl="in"] {
    transition: background-size 0.8s cubic-bezier(0.22, 0.61, 0.36, 1);
  }
</style><script>
  const items = document.querySelectorAll<HTMLElement>('.hl');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (!reduce && 'IntersectionObserver' in window) {
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          const el = entry.target as HTMLElement;
          requestAnimationFrame(() => (el.dataset.hl = 'in'));
          io.unobserve(el);
        });
      },
      { threshold: 0.6 }
    );
    items.forEach((el) => {
      el.dataset.hl = 'pending';
      io.observe(el);
    });
  }
</script>