---
// The black "Got a question for the show?" bar that links to the Ask Kylie page.
const arrow = 'M4 12L12 4M5.5 4H12v6.5';
---
<div class="max-w-5xl mx-auto flex flex-col items-center gap-6 rounded-[2rem] bg-black px-8 py-12 text-center text-white sm:flex-row sm:justify-between sm:gap-10 sm:px-14 sm:py-14 sm:text-left">
  <div class="max-w-xl">
    <p class="text-pink text-xs uppercase tracking-widest font-semibold mb-3">Listener questions</p>
    <h2 class="font-serif font-bold italic text-3xl sm:text-4xl leading-tight mb-3 text-balance">Got a question for the show?</h2>
    <p class="text-warmgray leading-relaxed">Record it in your own voice. I may answer it on a future episode.</p>
  </div>
  <a href="/ask-kylie" class="group inline-flex flex-none items-center gap-4 rounded-full bg-white text-black pl-7 pr-2 py-2 text-[15px] font-semibold transition-transform duration-300 hover:-translate-y-1">
    Ask Kylie
    <span class="grid place-items-center h-11 w-11 rounded-full bg-pink text-white transition-colors duration-300 group-hover:bg-black"><svg viewBox="0 0 16 16" class="h-4 w-4 transition-transform duration-300 group-hover:rotate-45" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={arrow} /></svg></span>
  </a>
</div>
