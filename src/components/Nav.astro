---
const links = [
  { href: '/meet-kylie', label: 'About' },
  { href: '/podcast', label: 'Podcast' },
  { href: 'https://shop.kyliekelly.com/', label: 'Shop' },
  { href: 'https://www.skool.com/email-marketing-skool/about', label: 'Free Community' },
];
---
<header class="bg-white text-black">
  <nav class="max-w-7xl mx-auto flex items-center justify-between gap-4 px-6 py-5 lg:py-7">
    <a href="/" class="font-sans tracking-[0.16em] sm:tracking-[0.2em] text-sm sm:text-base lg:text-xl uppercase whitespace-nowrap">Kylie&nbsp;|&nbsp;Kelly</a>
    <ul class="hidden md:flex items-center gap-8 lg:gap-12 text-[13px] lg:text-base uppercase tracking-wide font-medium">
      {links.map((link) => (
        <li><a href={link.href} class="hover:text-pink transition-colors">{link.label}</a></li>
      ))}
    </ul>
    <a href="/services" class="btn-outline text-xs sm:text-[13px] lg:text-[15px] !py-2 !px-4 sm:!py-2.5 sm:!px-6 lg:!py-3.5 lg:!px-8 !border-pink whitespace-nowrap hidden sm:inline-block">Work With Me →</a>
  </nav>
</header>
