---
const links = [
  { href: '/meet-kylie', label: 'About' },
  { href: '/podcast', label: 'Podcast' },
  { href: '/blog', label: 'Blog' },
  { href: 'https://shop.kyliekelly.com/', label: 'Shop' },
  { href: 'https://www.skool.com/email-marketing-skool/about', label: 'Free Community' },
  { href: '/contact', label: 'Contact' },
];
---
<header class="relative bg-white text-black">
  <nav class="max-w-7xl mx-auto flex items-center justify-between gap-4 px-6 py-5 lg:py-7">
    <a href="/" class="font-sans tracking-[0.16em] sm:tracking-[0.2em] text-sm sm:text-base lg:text-xl uppercase whitespace-nowrap">Kylie&nbsp;|&nbsp;Kelly</a>
    <ul class="hidden xl:flex items-center gap-8 2xl:gap-12 text-base uppercase tracking-wide font-medium">
      {links.map((link) => (
        <li><a href={link.href} class="hover:text-pink transition-colors">{link.label}</a></li>
      ))}
    </ul>
    <div class="flex items-center gap-3">
      <a href="/services" class="btn-outline text-xs sm:text-[13px] lg:text-[15px] !py-2 !px-4 sm:!py-2.5 sm:!px-6 lg:!py-3.5 lg:!px-8 !border-pink whitespace-nowrap max-sm:!hidden">Work With Me →</a>
      <button id="nav-toggle" type="button" class="xl:hidden grid h-11 w-11 place-items-center rounded-full border border-black/20 transition-colors hover:border-pink" aria-expanded="false" aria-controls="nav-menu" aria-label="Open menu">
        <svg viewBox="0 0 20 20" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true">
          <path class="nav-open" d="M3 6h14M3 10h14M3 14h14" />
          <path class="nav-close hidden" d="M5 5l10 10M15 5L5 15" />
        </svg>
      </button>
    </div>
  </nav>

  <div id="nav-menu" class="hidden xl:hidden absolute inset-x-0 top-full z-50 border-t border-black/10 bg-white px-6 pb-6 shadow-[0_20px_40px_rgba(0,0,0,0.08)]">
    <ul class="flex flex-col divide-y divide-black/10 py-2 text-sm uppercase tracking-widest font-medium">
      {links.map((link) => (
        <li><a href={link.href} class="block py-4 hover:text-pink transition-colors">{link.label}</a></li>
      ))}
    </ul>
    <a href="/services" class="btn-outline mt-3 block w-full text-center text-xs !border-pink sm:hidden">Work With Me →</a>
  </div>
</header>

<script>
  const toggle = document.getElementById('nav-toggle');
  const menu = document.getElementById('nav-menu');
  if (toggle && menu) {
    const setOpen = (open: boolean) => {
      menu.classList.toggle('hidden', !open);
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
      toggle.querySelector('.nav-open')?.classList.toggle('hidden', open);
      toggle.querySelector('.nav-close')?.classList.toggle('hidden', !open);
    };
    toggle.addEventListener('click', () => setOpen(menu.classList.contains('hidden')));
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') setOpen(false);
    });
    menu.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setOpen(false)));
  }
</script>
