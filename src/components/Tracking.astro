---
// Google Analytics and the Meta Pixel. Both are held back (type="text/plain") until a visitor clicks
// Accept on the cookie banner, then CookieBanner.astro switches them on. Declined or undecided
// visitors are never tracked.
// They only run on kyliekelly.com, so previews and test sites do not pollute the numbers.
const GA_ID = 'G-VE404B70GZ'; // Google Analytics 4: "Kylie Kelly Website - GA4"
const PIXEL_ID = '1122349031672137'; // Meta Pixel

const onlyOnLiveSite = `/(^|\\.)kyliekelly\\.com$/.test(location.hostname)`;

const analytics = `(function(){
  if(!${onlyOnLiveSite}) return;
  var s=document.createElement('script'); s.async=true;
  s.src='https://www.googletagmanager.com/gtag/js?id=${GA_ID}';
  document.head.appendChild(s);
  window.dataLayer=window.dataLayer||[];
  window.gtag=function(){window.dataLayer.push(arguments);};
  window.gtag('js',new Date());
  window.gtag('config','${GA_ID}');
})();`;

const pixel = `(function(){
  if(!${onlyOnLiveSite}) return;
  !function(f,b,e,v,n,t,s){if(f.fbq)return;n=f.fbq=function(){n.callMethod?n.callMethod.apply(n,arguments):n.queue.push(arguments)};if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';n.queue=[];t=b.createElement(e);t.async=!0;t.src=v;s=b.getElementsByTagName(e)[0];s.parentNode.insertBefore(t,s)}(window,document,'script','https://connect.facebook.net/en_US/fbevents.js');
  window.fbq('init','${PIXEL_ID}');
  window.fbq('track','PageView');
})();`;
---
<script is:inline type="text/plain" data-consent="analytics" set:html={analytics}></script>
<script is:inline type="text/plain" data-consent="marketing" set:html={pixel}></script>
