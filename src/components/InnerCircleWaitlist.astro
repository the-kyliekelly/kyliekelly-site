---
// The Inner Circle waitlist sign-up: first name and email. It posts to our own /api/subscribe endpoint (see
// api/subscribe.mjs), which checks the visitor with Cloudflare Turnstile and then adds them to the Flodesk
// segment "Inner Circle Waitlist". Nothing is sent straight from the page to Flodesk any more, so spam bots
// that skip the page get nowhere.
// TURNSTILE_SITE_KEY is the public key of the Cloudflare Turnstile widget for kyliekelly.com (safe to show in the page).
// The matching secret key lives in Vercel as TURNSTILE_SECRET_KEY.
const TURNSTILE_SITE_KEY = '0x4AAAAAAF6sbZzxdQlcet6q';
const LIST = 'inner-circle';
---
<div class="kk-wl" data-wl data-list={LIST} data-sitekey={TURNSTILE_SITE_KEY}>
  <form novalidate action="/api/subscribe" method="post" data-wl-form aria-label="Join the Inner Circle waitlist">
    <div class="fd-form-content">
      <div>
        <div class="fd-form-group">
          <input id="wl-firstName" class="fd-form-control" type="text" maxlength="120" name="firstName" placeholder="First name" autocomplete="given-name" required />
          <label for="wl-firstName" class="fd-form-label"><div><div>First name</div></div></label>
        </div>
        <div class="fd-form-group">
          <input id="wl-email" class="fd-form-control" type="email" maxlength="200" name="email" placeholder="Email address" autocomplete="email" inputmode="email" required />
          <label for="wl-email" class="fd-form-label"><div><div>Email address</div></div></label>
        </div>
        <input type="text" maxlength="200" name="website" style="display: none" tabindex="-1" autocomplete="off" aria-hidden="true" />
      </div>
      <div data-wl-ts style="margin-bottom: 12px"></div>
      <div>
        <button type="submit" class="fd-btn" data-wl-submit><span>Join the waitlist →</span></button>
      </div>
    </div>
    <div class="fd-form-success" role="status">
      <p class="kk-wl-thanks">You're on the list! ✨ I'll email you the second I can tell you more.</p>
    </div>
    <div class="fd-form-error" role="alert" data-wl-error></div>
  </form>
</div>

<style is:global>
  .kk-wl { margin-top: 2.25rem; max-width: 28rem; text-align: left; }
  .kk-wl *, .kk-wl *::before, .kk-wl *::after { box-sizing: border-box; }
  .kk-wl [hidden] { display: none !important; }
  .kk-wl .fd-form-content { position: relative; }
  .kk-wl .fd-form-group { position: relative; margin: 0 0 12px; }
  .kk-wl .fd-form-control {
    display: block; width: 100%; height: 3.25rem; padding: 0 1.5rem; margin: 0;
    border: 1px solid rgba(255, 255, 255, 0.3); border-radius: 9999px;
    background: #fff; color: #000; font: inherit; font-size: 15px; outline: none;
    -webkit-appearance: none; appearance: none; transition: box-shadow 0.2s, border-color 0.2s;
  }
  .kk-wl .fd-form-control::placeholder { color: transparent; opacity: 0; }
  .kk-wl .fd-form-control:focus { border-color: #e040fb; box-shadow: 0 0 0 3px rgba(224, 64, 251, 0.4); }
  /* The label sits over the empty box like a placeholder and fades once there is text */
  .kk-wl .fd-form-label {
    position: absolute; top: 0; left: 0; right: 0; height: 3.25rem; line-height: 3.25rem; margin: 0;
    padding: 0 1.5rem; color: #6b6b6b; font-size: 15px; font-weight: 400;
    overflow: hidden; white-space: nowrap; text-overflow: ellipsis; pointer-events: none;
  }
  .kk-wl .fd-form-label div { display: inline; }
  .kk-wl .fd-form-control:not(:placeholder-shown) + .fd-form-label { opacity: 0; }
  .kk-wl .fd-form-group.fd-has-error .fd-form-control { border-color: #ff8a80; }
  .kk-wl .fd-form-feedback { display: none; margin: 6px 0 0 1.5rem; font-size: 0.8rem; color: #ff8a80; }
  .kk-wl .fd-form-group.fd-has-error .fd-form-feedback { display: block; }
  .kk-wl .fd-btn {
    display: inline-flex; align-items: center; justify-content: center; width: 100%; height: 3.25rem;
    border: 0; border-radius: 9999px; background: #e040fb; color: #fff; cursor: pointer;
    font: inherit; font-size: 13px; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase;
    transition: background-color 0.3s, color 0.3s, transform 0.3s;
  }
  .kk-wl .fd-btn:hover { background: #fff; color: #000; transform: translateY(-2px); }
  .kk-wl .fd-btn:focus-visible { outline: 2px solid #fff; outline-offset: 3px; }
  .kk-wl .fd-btn:disabled { opacity: 0.7; cursor: default; transform: none; }
  .kk-wl .fd-form-success { display: none; }
  .kk-wl .fd-has-success .fd-form-success, .kk-wl[data-ff-stage="success"] .fd-form-success, .kk-wl.fd-has-success .fd-form-success { display: block; }
  .kk-wl .fd-has-success .fd-form-content, .kk-wl[data-ff-stage="success"] .fd-form-content, .kk-wl.fd-has-success .fd-form-content { display: none; }
  .kk-wl-thanks { margin: 0; font-size: 1.125rem; font-weight: 600; line-height: 1.5; color: #fff; }
  .kk-wl .fd-form-error { display: none; margin-top: 12px; font-size: 0.9rem; color: #ff8a80; }
  .kk-wl .fd-has-error .fd-form-error { display: block; }
  .kk-wl .fd-has-captcha .fd-form-content > *:not(.fd-form-captcha) { opacity: 0; visibility: hidden; }
  .kk-wl .fd-form-captcha { position: absolute; top: 0; left: 0; width: 100%; height: 100%; display: flex; align-items: center; }
  .kk-wl .fd-form-suggestion { margin: 6px 0 0; font-size: 0.85rem; text-align: center; color: #fff; }
  .kk-wl .fd-form-suggestion__link { font: inherit; color: inherit; background: none; border: 0; padding: 0; cursor: pointer; text-decoration: underline; }
  @media (max-width: 767px) { .kk-wl { margin-left: auto; margin-right: auto; } }
</style>

<script>
  import { turnstileFor } from '../scripts/turnstile';

  const root = document.querySelector<HTMLElement>('[data-wl]');
  if (root) {
    const form = root.querySelector<HTMLFormElement>('[data-wl-form]')!;
    const button = root.querySelector<HTMLButtonElement>('[data-wl-submit]')!;
    const errorBox = root.querySelector<HTMLElement>('[data-wl-error]')!;
    const check = turnstileFor(root.querySelector<HTMLElement>('[data-wl-ts]')!, root.dataset.sitekey ?? '', 'dark');
    const shownAt = Date.now();
    let sending = false;

    // Start the human check as soon as someone touches the form.
    form.addEventListener('focusin', () => check.prepare(), { once: true });

    const showError = (message: string) => {
      errorBox.textContent = message;
      form.classList.add('fd-has-error');
    };

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (sending) return;
      form.classList.remove('fd-has-error');

      const data = new FormData(form);
      const firstName = String(data.get('firstName') ?? '').trim();
      const email = String(data.get('email') ?? '').trim();
      if (!firstName || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
        showError('Please add your first name and a valid email address.');
        return;
      }

      sending = true;
      button.disabled = true;
      try {
        const token = await check.getToken();
        if (!token) {
          showError("I couldn't confirm you're human just now. Please try again.");
          check.reset();
          return;
        }
        const response = await fetch('/api/subscribe', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            list: root.dataset.list,
            firstName,
            email,
            token,
            website: String(data.get('website') ?? ''),
            loadedAt: shownAt,
          }),
        });
        const result = await response.json().catch(() => ({ ok: false }));
        if (result && result.ok) {
          root.classList.add('fd-has-success');
          return;
        }
        if (result && result.error === 'captcha') showError("That check didn't go through. Please try again.");
        else if (result && result.error === 'missing-fields') showError('Please add your first name and a valid email address.');
        else showError('Something went wrong. Please try again in a moment.');
        check.reset();
      } catch {
        showError('Something went wrong. Please try again in a moment.');
        check.reset();
      } finally {
        sending = false;
        button.disabled = false;
      }
    });
  }
</script>
