---
import Layout from './Layout.astro';

interface Props {
  title: string;
  description?: string;
  date: string;
}

const { title, description, date } = Astro.props;
const formattedDate = new Date(date).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
---
<Layout title={`${title} | Kylie Kelly`} description={description}>

  <section class="bg-pink-light px-6 py-4">
    <p class="max-w-4xl mx-auto flex items-center justify-center gap-4 text-xs sm:text-sm font-normal uppercase tracking-widest text-black text-center">
      <span class="hidden sm:block h-px flex-1 bg-black/30"></span>
      Wife. Mom of two boys. Founder of Kylie Kelly. Host of The Email Growth Show.
      <span class="hidden sm:block h-px flex-1 bg-black/30"></span>
    </p>
  </section>

  <article class="px-6 py-16">
    <div class="max-w-2xl mx-auto">

      <header class="text-center mb-12">
        <a href="/podcast/archive" class="inline-block mb-6 text-sm font-semibold underline underline-offset-2 hover:text-pink">← Back to the episode library</a>
        <p class="text-pink text-xs uppercase tracking-widest font-semibold mb-4">{formattedDate}</p>
        <h1 class="text-3xl sm:text-4xl font-bold leading-tight">{title}</h1>
      </header>

      <div class="episode-body">
        <slot />
      </div>

      <div class="flex justify-center mt-16 pt-8 border-t border-warmgray/40 text-sm font-semibold">
        <a href="/podcast/archive" class="underline underline-offset-2 hover:text-pink">Browse all episodes →</a>
      </div>

    </div>
  </article>

</Layout>

<style>
  .episode-body :global(p),
  .episode-body :global(li) {
    font-size: 1.05rem;
    color: #222;
    margin: 0 0 20px;
  }
  .episode-body :global(h2) {
    font-family: 'Playfair Display', Georgia, serif;
    font-style: italic;
    font-weight: 700;
    font-size: 1.5rem;
    margin: 44px 0 16px;
  }
  .episode-body :global(h3) {
    font-family: 'Playfair Display', Georgia, serif;
    font-weight: 700;
    font-size: 1.1rem;
    color: #e579df;
    margin: 28px 0 12px;
  }
  .episode-body :global(blockquote) {
    font-family: 'Playfair Display', Georgia, serif;
    font-style: italic;
    font-size: 1.2rem;
    border-left: 3px solid #e579df;
    padding-left: 22px;
    margin: 28px 0;
  }
  .episode-body :global(a) {
    color: #e579df;
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .episode-body :global(img) {
    border-radius: 12px;
    margin: 24px 0;
  }
  .episode-body :global(ul),
  .episode-body :global(ol) {
    margin: 0 0 20px;
    padding-left: 24px;
  }
</style>
