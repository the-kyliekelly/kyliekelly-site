---
import EventBanner from '../components/EventBanner.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import CookieBanner from '../components/CookieBanner.astro';
import ScrollToTop from '../components/ScrollToTop.astro';
import Tracking from '../components/Tracking.astro';
import vercel from '../../vercel.json';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
  /** A full address or a path to the share image (1200x630 works best). Defaults to the site's share image. */
  image?: string;
  /** 'website' for most pages, 'article' for a blog post. */
  ogType?: 'website' | 'article';
}

const hasReveal = Astro.slots.has('reveal');

// Short addresses on this site that redirect to another site (for example /guide), so links to them open in a new tab too.
const SITE_HOSTS = ['kyliekelly.com', 'www.kyliekelly.com'];
const externalRedirects = ((vercel as { redirects?: Array<{ source: string; destination: string }> }).redirects ?? [])
  .filter((r) => !r.source.includes(':') && /^https?:\/\//.test(r.destination) && !SITE_HOSTS.includes(new URL(r.destination).hostname))
  .map((r) => r.source.replace(/\/$/, ''));
const { title, description = 'Email marketing strategies for women in business who want to grow their list, without relying on social media.', noindex = false, image = '/images/og-default.jpg', ogType = 'website' } = Astro.props;
const pageUrl = new URL(Astro.url.pathname, Astro.site);
const shareImage = new URL(image, Astro.site).toString();
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:site_name" content="Kylie Kelly" />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={shareImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={shareImage} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <!-- The ?v=2 stops browsers showing a cached old icon. Bump it whenever the icon changes. SVG for most browsers, PNG and ICO for Safari and older ones. -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=2" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png?v=2" />
    <link rel="icon" type="image/png" sizes="192x192" href="/favicon-192.png?v=2" />
    <link rel="shortcut icon" href="/favicon.ico?v=2" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png?v=2" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <!-- The fonts load without holding up the page (text shows straight away, then switches to the web fonts). -->
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,700;1,400;1,700&family=Work+Sans:wght@300;400;600&display=swap" media="print" onload="this.media='all'" />
    <noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,700;1,400;1,700&family=Work+Sans:wght@300;400;600&display=swap" /></noscript>
    <slot name="head" />
  </head>
  <body>
    <div class="reveal-page" data-reveal-page>
      <EventBanner />
      <Nav />
      <main>
        <slot />
      </main>
      <Footer />
    </div>
    {hasReveal && (
      <div class="reveal-panel" data-reveal-panel>
        <slot name="reveal" />
      </div>
    )}
    <noscript><style>.reveal-panel { visibility: visible; }</style></noscript>
    <ScrollToTop />
    <CookieBanner />
    <Tracking />
    <!-- Every link that leaves this site (including short addresses that redirect elsewhere) opens in a new tab. -->
    <script is:inline define:vars={{ externalRedirects }}>
      (function () {
        var own = ['kyliekelly.com', 'www.kyliekelly.com', location.hostname];
        document.querySelectorAll('a[href]').forEach(function (a) {
          var h = a.getAttribute('href');
          if (!h || a.target || a.hasAttribute('download') || /^(#|mailto:|tel:|sms:|javascript:)/i.test(h)) return;
          var external = false;
          try {
            var u = new URL(h, location.href);
            if (u.protocol === 'http:' || u.protocol === 'https:') {
              external = own.indexOf(u.hostname) < 0 || externalRedirects.indexOf(u.pathname.replace(/\/$/, '')) > -1;
            }
          } catch (e) {}
          if (!external) return;
          a.target = '_blank';
          var rel = (a.getAttribute('rel') || '').split(/\s+/).filter(Boolean);
          if (rel.indexOf('noopener') < 0) rel.push('noopener');
          a.setAttribute('rel', rel.join(' '));
        });
      })();
    </script>
  </body>
</html>

<style is:global>
  /* Footer reveal: the page scrolls up like a curtain to uncover a panel fixed behind it.
     Without JavaScript, with reduced motion, or if the panel is taller than the screen,
     the panel simply sits below the footer. */
  html.reveal-on .reveal-page { position: relative; z-index: 10; background: #fff; }
  html.reveal-on .reveal-panel { position: fixed; left: 0; right: 0; bottom: 0; z-index: 0; }
  .reveal-panel { visibility: hidden; }
  .reveal-panel.is-ready { visibility: visible; }
</style>

<script>
  const page = document.querySelector<HTMLElement>('[data-reveal-page]');
  const panel = document.querySelector<HTMLElement>('[data-reveal-panel]');

  if (page && panel) {
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
    const update = () => {
      const h = panel.offsetHeight;
      const on = !reduce.matches && h > 0 && h <= window.innerHeight;
      document.documentElement.classList.toggle('reveal-on', on);
      page.style.marginBottom = on ? `${h}px` : '';
    };
    update();
    // Show the panel only once the visitor is within a screen or so of the bottom (it sits behind the page until then).
    const ready = () => {
      const left = document.documentElement.scrollHeight - window.scrollY - window.innerHeight;
      panel.classList.toggle('is-ready', left < window.innerHeight * 1.5 + panel.offsetHeight);
    };
    window.addEventListener('scroll', ready, { passive: true });
    window.addEventListener('resize', ready);
    ready();
    window.addEventListener('resize', update);
    if ('ResizeObserver' in window) new ResizeObserver(update).observe(panel);
    reduce.addEventListener('change', update);
  }
</script>
