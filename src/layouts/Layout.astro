---
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import CookieBanner from '../components/CookieBanner.astro';
import Tracking from '../components/Tracking.astro';
import vercel from '../../vercel.json';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
}

const hasReveal = Astro.slots.has('reveal');

// Short addresses on this site that redirect to another site (for example /guide), so links to them open in a new tab too.
const SITE_HOSTS = ['kyliekelly.com', 'www.kyliekelly.com'];
const externalRedirects = ((vercel as { redirects?: Array<{ source: string; destination: string }> }).redirects ?? [])
  .filter((r) => !r.source.includes(':') && /^https?:\/\//.test(r.destination) && !SITE_HOSTS.includes(new URL(r.destination).hostname))
  .map((r) => r.source.replace(/\/$/, ''));
const { title, description = 'Email marketing strategies for women in business who want to grow their list, without relying on social media.', noindex = false } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <slot name="head" />
  </head>
  <body>
    <div class="reveal-page" data-reveal-page>
      <Nav />
      <main>
        <slot />
      </main>
      <Footer />
    </div>
    {hasReveal && (
      <div class="reveal-panel" data-reveal-panel>
        <slot name="reveal" />
      </div>
    )}
    <CookieBanner />
    <Tracking />
    <!-- Every link that leaves this site (including short addresses that redirect elsewhere) opens in a new tab. -->
    <script is:inline define:vars={{ externalRedirects }}>
      (function () {
        var own = ['kyliekelly.com', 'www.kyliekelly.com', location.hostname];
        document.querySelectorAll('a[href]').forEach(function (a) {
          var h = a.getAttribute('href');
          if (!h || a.target || a.hasAttribute('download') || /^(#|mailto:|tel:|sms:|javascript:)/i.test(h)) return;
          var external = false;
          try {
            var u = new URL(h, location.href);
            if (u.protocol === 'http:' || u.protocol === 'https:') {
              external = own.indexOf(u.hostname) < 0 || externalRedirects.indexOf(u.pathname.replace(/\/$/, '')) > -1;
            }
          } catch (e) {}
          if (!external) return;
          a.target = '_blank';
          var rel = (a.getAttribute('rel') || '').split(/\s+/).filter(Boolean);
          if (rel.indexOf('noopener') < 0) rel.push('noopener');
          a.setAttribute('rel', rel.join(' '));
        });
      })();
    </script>
  </body>
</html>

<style is:global>
  /* Footer reveal: the page scrolls up like a curtain to uncover a panel fixed behind it.
     Without JavaScript, with reduced motion, or if the panel is taller than the screen,
     the panel simply sits below the footer. */
  html.reveal-on .reveal-page { position: relative; z-index: 10; background: #fff; }
  html.reveal-on .reveal-panel { position: fixed; left: 0; right: 0; bottom: 0; z-index: 0; }
</style>

<script>
  const page = document.querySelector<HTMLElement>('[data-reveal-page]');
  const panel = document.querySelector<HTMLElement>('[data-reveal-panel]');

  if (page && panel) {
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
    const update = () => {
      const h = panel.offsetHeight;
      const on = !reduce.matches && h > 0 && h <= window.innerHeight;
      document.documentElement.classList.toggle('reveal-on', on);
      page.style.marginBottom = on ? `${h}px` : '';
    };
    update();
    window.addEventListener('resize', update);
    if ('ResizeObserver' in window) new ResizeObserver(update).observe(panel);
    reduce.addEventListener('change', update);
  }
</script>
