---
// A blog post: a hero with the post's cover image, then the article beside a sidebar (about Kylie, the quiz,
// recent posts). The "In this post" list sits after the intro and links to every h2 (plain links, no script).
import { Image } from 'astro:assets';
import Layout from './Layout.astro';
import allPosts from '../data/blog-posts.json';
import AboutBlogger from '../components/AboutBlogger.astro';
import { bannerFor, blogCovers, prepareBlogHtml } from '../lib/blog';
import { highlightPhrases } from '../lib/showNotes';
import { formatAuDate } from '../lib/dates';

interface Cta {
  eyebrow?: string;
  headline: string;
  text: string;
  label: string;
  href: string;
}
interface Props {
  slug: string;
  title: string;
  /** The title tag, when it should be shorter than the post's own title. */
  seoTitle?: string;
  description?: string;
  date: string;
  html: string;
  /** Phrases copied word for word from the post that get the yellow marker highlight. */
  highlights?: string[];
  /** A YouTube video id, only when it is Kylie's own video that fits the post. Shown at the very top. */
  video?: string;
  /** When the post was last refreshed (shown as "Updated ..." and used as dateModified). */
  updated?: string;
}

const { slug, title, seoTitle, description, date, html: rawHtml, highlights = [], video, updated } = Astro.props;
const html = highlights.length ? highlightPhrases(rawHtml, highlights, slug) : rawHtml;
const cover = blogCovers[slug];

// The banner photo (see bannerFor in src/lib/blog.ts). The sidebar uses a photo of Kylie.
const banner = bannerFor(slug);
const { intro, rest, cta, toc, words } = prepareBlogHtml(html);
const updatedLabel = updated ? formatAuDate(updated, { day: 'numeric', month: 'long', year: 'numeric' }) : '';
const readMins = Math.max(1, Math.round(words / 220));
const dateLabel = formatAuDate(date, { day: 'numeric', month: 'long', year: 'numeric' });
const url = new URL(`/${slug}/`, Astro.site ?? 'https://kyliekelly.com').toString();
const imageUrl = cover?.image ? new URL(cover.image, Astro.site ?? 'https://kyliekelly.com').toString() : undefined;

// The Website Planet post is left out of suggestions: its title still uses the old "visibility coaching" wording.
const notSuggested = ['website-planet-feature'];
const others = allPosts
  .filter((p) => p.categories.includes(35) && p.slug !== slug && blogCovers[p.slug] && !notSuggested.includes(p.slug))
  .sort((a, b) => +new Date(b.date) - +new Date(a.date));
// Same topic first, then the newest.
const related = [...others.filter((p) => blogCovers[p.slug].topic === cover?.topic), ...others.filter((p) => blogCovers[p.slug].topic !== cover?.topic)].slice(0, 3);
const recent = others.slice(0, 4);

// A few tools from the Favorites page (src/pages/resources.astro), with the same affiliate links and perks.
const favorites = [
  { name: 'Flodesk', text: 'This is where my email list lives. I use it to send my emails, deliver my freebies and run my automations.', perk: '25% off your first year', url: 'https://flodesk.com/c/KYLIEKELLY' },
  { name: 'Teachery', text: 'This is where I host my courses and programs. Super simple to set up and it just works.', perk: '$950 lifetime deal', url: 'https://www.teachery.co/limited-time?a=c4AganJG' },
  { name: 'Buzzsprout', text: 'This is where all my podcast episodes live. Super easy to use, and it helps me track downloads.', perk: '$20 credit', url: 'https://www.buzzsprout.com/?referrer_id=2046932' },
  { name: 'Wispr Flow', text: 'Talk instead of type. It turns your voice into clean, ready-to-send text in any app.', perk: 'A free month of Flow Pro', url: 'https://wisprflow.ai/r?KYLIE344' },
];
const numberColours = ['text-pink', 'text-[#b58fc0]', 'text-black', 'text-pink'];

// Save-to-Pinterest link, using the post's pin image (the cover) and its address.
const pinUrl = cover?.image
  ? `https://www.pinterest.com/pin/create/button/?url=${encodeURIComponent(url)}&media=${encodeURIComponent(imageUrl ?? '')}&description=${encodeURIComponent(title)}`
  : undefined;
const pinGlyph = 'M12.017 0C5.396 0 .029 5.367.029 11.987c0 5.079 3.158 9.417 7.618 11.162-.105-.949-.199-2.403.041-3.439.219-.937 1.406-5.957 1.406-5.957s-.359-.72-.359-1.781c0-1.663.967-2.911 2.168-2.911 1.024 0 1.518.769 1.518 1.688 0 1.029-.653 2.567-.992 3.992-.285 1.193.6 2.165 1.775 2.165 2.128 0 3.768-2.245 3.768-5.487 0-2.861-2.063-4.869-5.008-4.869-3.41 0-5.409 2.562-5.409 5.199 0 1.033.394 2.143.889 2.741.099.12.112.225.085.345-.09.375-.293 1.199-.334 1.363-.053.225-.172.271-.401.165-1.495-.69-2.433-2.878-2.433-4.646 0-3.776 2.748-7.252 7.92-7.252 4.158 0 7.392 2.967 7.392 6.923 0 4.135-2.607 7.462-6.233 7.462-1.214 0-2.354-.629-2.758-1.379l-.749 2.848c-.269 1.045-1.004 2.352-1.498 3.146 1.123.345 2.306.535 3.55.535 6.607 0 11.985-5.365 11.985-11.987C23.97 5.39 18.592.026 11.985.026L12.017 0z';

const graph = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description,
  datePublished: new Date(date).toISOString(),
  dateModified: new Date(updated ?? date).toISOString(),
  mainEntityOfPage: url,
  ...(imageUrl ? { image: imageUrl } : {}),
  author: { '@type': 'Person', name: 'Kylie Kelly', url: new URL('/meet-kylie/', url).toString() },
  publisher: { '@type': 'Person', name: 'Kylie Kelly' },
};
---
<Layout title={seoTitle ?? `${title} | Kylie Kelly`} description={description}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(graph)} />
    <link rel="alternate" type="application/rss+xml" title="The Kylie Kelly Blog" href="/blog/rss.xml" />
    <meta property="og:type" content="article" />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    {imageUrl && <meta property="og:image" content={imageUrl} />}
  </Fragment>

  <section class="relative overflow-hidden bg-black text-white">
    {banner && (
      <Image src={banner} alt="" widths={[640, 960, 1280]} sizes="(min-width: 768px) 48vw, 100vw" loading="eager" class="absolute inset-y-0 right-0 h-full w-full object-cover object-[50%_10%] md:w-[48%]" />
    )}
    <div class="absolute inset-0 bg-black/60 md:bg-transparent md:bg-[linear-gradient(90deg,#000_0%,#000_52%,rgba(0,0,0,0)_66%)]" aria-hidden="true"></div>
    <div class="relative mx-auto flex min-h-[480px] max-w-6xl flex-col justify-end px-6 py-14 sm:min-h-[560px] sm:py-20">
      <div class="max-w-2xl">
        <a href="/blog" class="mb-6 inline-block text-sm font-semibold underline underline-offset-4 hover:text-[#f1b3ff]">← The blog</a>
        <p class="mb-4 text-xs font-semibold uppercase tracking-widest text-[#f1b3ff]">{cover?.topic && <>{cover.topic} · </>}{updatedLabel ? `Updated ${updatedLabel}` : dateLabel} · {readMins} min read</p>
        <h1 class="font-serif text-4xl font-bold leading-[1.08] text-balance sm:text-5xl lg:text-6xl">{title}</h1>
        <p class="mt-6 flex items-center gap-3 text-sm font-semibold">
          <img src="/images/kylie-headshot.jpg" alt="" width="44" height="44" class="h-11 w-11 rounded-full object-cover object-top" />
          <span>By Kylie Kelly</span>
          {pinUrl && (
            <a href={pinUrl} target="_blank" rel="noopener" aria-label="Save this post to Pinterest" title="Save to Pinterest" class="ml-2 grid h-10 w-10 place-items-center rounded-full border border-white/60 text-white transition duration-300 hover:-translate-y-0.5 hover:border-pink hover:bg-pink">
              <svg viewBox="0 0 24 24" class="h-4 w-4" fill="currentColor" aria-hidden="true"><path d={pinGlyph} /></svg>
            </a>
          )}
        </p>
      </div>
    </div>
  </section>

  <div class="px-6 pt-14 pb-14 sm:pt-20 sm:pb-20">
    <div class="mx-auto grid max-w-6xl gap-14 lg:grid-cols-[minmax(0,1fr)_320px]">

      <article class="min-w-0">
        <div class="blog-body max-w-[42rem]">
          {video && (
            <div class="mb-10 aspect-video overflow-hidden rounded-2xl bg-black">
              <iframe src={`https://www.youtube-nocookie.com/embed/${video}`} title={title} class="h-full w-full" loading="lazy" allow="accelerometer; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>
            </div>
          )}

          <div set:html={intro} />

          {toc.length > 0 && (
            <nav aria-label="In this post" class="blog-toc my-10 rounded-2xl bg-offwhite p-6 sm:p-8">
              <p class="text-pink text-xs uppercase tracking-widest font-semibold mb-4">In this post</p>
              <ol>
                {toc.map((t) => (
                  <li class={t.level === 3 ? 'is-sub' : ''}><a href={`#${t.id}`}>{t.title}</a></li>
                ))}
              </ol>
            </nav>
          )}

          <div set:html={rest} />
        </div>

        {pinUrl && cover?.image && (
          <div class="mt-14 max-w-[42rem] text-center">
            <p class="mb-5 font-serif text-2xl font-bold italic">Love this post? Save it for later...</p>
            <a href={pinUrl} target="_blank" rel="noopener" class="group inline-block">
              <img src={cover.image} alt={`Pin: ${title}`} loading="lazy" class="mx-auto w-44 rounded-xl shadow-[0_14px_36px_rgba(0,0,0,0.14)] transition-transform duration-300 group-hover:-translate-y-1" />
              <span class="mt-5 inline-flex items-center gap-2 rounded-full bg-pink px-6 py-3 text-xs font-semibold uppercase tracking-widest text-white transition-colors group-hover:bg-black">
                <svg viewBox="0 0 24 24" class="h-4 w-4" fill="currentColor" aria-hidden="true"><path d={pinGlyph} /></svg>
                Save to Pinterest
              </span>
            </a>
          </div>
        )}
      </article>

      <aside class="space-y-10">
        <div class="text-center">
          <div class="mx-auto mb-7 aspect-[4/5] w-full max-w-[17rem] overflow-hidden rounded-t-full bg-[#d5b9db]">
            <img src="/images/hero-8.jpg" alt="Kylie Kelly" width="1200" height="1458" loading="lazy" class="h-full w-full object-cover object-[55%_18%]" />
          </div>
          <p class="font-serif text-[2.2rem] font-bold italic leading-tight mb-4">Hey there...<br />I'm Kylie Kelly</p>
          <p class="mx-auto mb-6 max-w-[19rem] text-[15px] leading-relaxed">I'm an email marketing educator who grew my list from 0 to 7,000+ subscribers in 18 months without social media. My obsession is teaching you how to get known, trusted and selling, without the algorithm running your life.</p>
          <a href="/meet-kylie" class="inline-block bg-black px-6 py-3.5 text-xs font-semibold uppercase tracking-widest text-white transition-colors hover:bg-pink">Meet Kylie →</a>
        </div>

        <div>
          <p class="text-xs uppercase tracking-[0.2em] font-semibold mb-5">As seen in:</p>
          <div class="grid grid-cols-2 items-center gap-x-6 gap-y-5">
            <img src="/images/press/forbes.png" alt="Forbes" loading="lazy" class="h-8 w-auto" />
            <img src="/images/press/business-insider.jpg" alt="Business Insider" loading="lazy" class="h-10 w-auto mix-blend-multiply" />
            <img src="/images/press/london-daily-news.png" alt="London Daily News" loading="lazy" class="h-8 w-auto" />
            <img src="/images/press/business-mondays.jpg" alt="Business Mondays" loading="lazy" class="h-12 w-auto mix-blend-multiply" />
          </div>
        </div>

        <div class="rounded-[2rem] border border-black bg-offwhite/50 p-7 text-center">
          <img src="/images/freebie-mockup.png" alt="Your Next 1,000 Subscribers quiz" loading="lazy" class="mx-auto mb-5 w-full max-w-[220px]" />
          <p class="font-serif italic text-2xl font-bold leading-tight mb-3">Your next 1,000 subscribers</p>
          <p class="text-sm mb-5">Take the free quiz to find the fastest way for you to grow your email list without social media.</p>
          <a href="/guide" class="inline-block rounded-full bg-black px-8 py-3.5 text-xs font-semibold uppercase tracking-widest text-white transition duration-300 hover:-translate-y-1 hover:bg-pink">Take the quiz →</a>
        </div>

        <div class="rounded-[2rem] bg-white p-7 shadow-[0_14px_44px_rgba(0,0,0,0.09)]">
          <p class="font-serif text-3xl font-bold italic leading-tight mb-5">A few of my favorite things</p>
          <ul class="border-t border-black/20">
            {favorites.map((f, i) => (
              <li class="border-b border-black/20 py-5 last:border-b-0 last:pb-0">
                <a href={f.url} target="_blank" rel="sponsored noopener" class="group block" aria-label={`${f.name} (affiliate link)`}>
                  <span class="mb-2 flex items-baseline gap-3">
                    <span class={`font-serif text-3xl ${numberColours[i % numberColours.length]}`}>{String(i + 1).padStart(2, '0')}</span>
                    <span class="font-serif text-2xl font-bold leading-tight group-hover:text-pink">{f.name}</span>
                  </span>
                  <span class="block text-sm leading-relaxed">{f.text}</span>
                  <span class="mt-2 block text-xs font-semibold uppercase tracking-widest text-pink">{f.perk} →</span>
                </a>
              </li>
            ))}
          </ul>
          <p class="mt-5 text-xs leading-relaxed text-black/70">Some of these are affiliate links, so I may earn a small commission at no extra cost to you. I only recommend what I actually use.</p>
          <a href="/resources" class="mt-3 inline-block text-sm font-semibold underline underline-offset-4 hover:text-pink">See all my favorites →</a>
        </div>

        {recent.length > 0 && (
          <div>
            <p class="font-serif text-[1.65rem] font-bold italic leading-tight whitespace-nowrap mb-3">Binge the latest posts</p>
            <span class="mb-3 block h-1 w-14 bg-pink"></span>
            <ul>
              {recent.map((p) => (
                <li class="border-b border-black/15 last:border-b-0">
                  <a href={`/${p.slug}/`} class="group flex items-center gap-5 py-6">
                    {bannerFor(p.slug) ? (
                      <Image src={bannerFor(p.slug)!} alt="" widths={[224, 336]} sizes="112px" loading="lazy" class="h-28 w-28 flex-none rounded-full object-cover transition-transform duration-300 group-hover:scale-105" />
                    ) : (
                      <span class="h-28 w-28 flex-none rounded-full bg-offwhite"></span>
                    )}
                    <span class="min-w-0">
                      <span class="block text-xs uppercase tracking-[0.18em] font-semibold text-pink mb-1.5">{blogCovers[p.slug].topic}</span>
                      <span class="block font-serif text-xl leading-snug group-hover:text-pink">{p.title}</span>
                    </span>
                  </a>
                </li>
              ))}
            </ul>
            <a href="/blog" class="mt-3 inline-block text-sm font-semibold uppercase tracking-widest text-pink underline underline-offset-4 transition-colors hover:text-black">All posts →</a>
          </div>
        )}
      </aside>

    </div>
  </div>

  <section class="px-6 pb-20 sm:pb-28">
    <div class="mx-auto max-w-6xl space-y-16">
      {cta && <div class="blog-body"><div set:html={cta} /></div>}

      <AboutBlogger />

      {related.length > 0 && (
        <section class="border-t border-black/10 pt-12">
          <h2 class="mb-8 font-serif text-3xl font-bold italic">Keep reading</h2>
          <ul class="grid gap-6 sm:grid-cols-3">
            {related.map((p) => (
              <li>
                <a href={`/${p.slug}/`} class="group block">
                  {bannerFor(p.slug) ? (
                    <Image src={bannerFor(p.slug)!} alt="" widths={[480, 720]} sizes="(min-width: 640px) 330px, 90vw" loading="lazy" class="aspect-square w-full rounded-2xl object-cover transition-transform duration-300 group-hover:-translate-y-1" />
                  ) : (
                    <span class="block aspect-square w-full rounded-2xl bg-offwhite"></span>
                  )}
                  <span class="mt-4 block font-serif text-xl font-bold leading-snug group-hover:text-pink">{p.title}</span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )}
    </div>
  </section>
</Layout>

<style>
  .blog-body :global(p),
  .blog-body :global(li) {
    font-size: 1.08rem;
    line-height: 1.75;
    color: #222;
    margin: 0 0 22px;
  }
  .blog-body :global(h2) {
    font-family: 'Playfair Display', Georgia, serif;
    font-style: italic;
    font-weight: 700;
    font-size: clamp(1.6rem, 3vw, 2rem);
    line-height: 1.2;
    margin: 56px 0 18px;
    scroll-margin-top: 90px;
  }
  .blog-body :global(h3) {
    font-family: 'Work Sans', 'Helvetica Neue', sans-serif;
    font-weight: 600;
    font-size: 1rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    line-height: 1.5;
    margin: 32px 0 10px;
    scroll-margin-top: 90px;
  }
  .blog-body :global(mark) {
    background: linear-gradient(180deg, transparent 40%, #fff06a 40%);
    color: inherit;
    font-weight: 600;
    padding: 0 0.1em;
    margin: 0 -0.1em;
    -webkit-box-decoration-break: clone;
    box-decoration-break: clone;
  }
  .blog-body :global(blockquote) {
    font-family: 'Playfair Display', Georgia, serif;
    font-style: italic;
    font-size: 1.3rem;
    line-height: 1.5;
    border-left: 3px solid #e040fb;
    padding-left: 24px;
    margin: 32px 0;
  }
  .blog-body :global(a) {
    color: #e040fb;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .blog-body :global(img) {
    max-width: 100%;
    height: auto;
    border-radius: 14px;
    margin: 28px auto;
  }
  .blog-body :global(ul),
  .blog-body :global(ol) {
    margin: 0 0 22px;
    padding-left: 26px;
  }
  .blog-body :global(ul) { list-style: disc; }
  .blog-body :global(ol) { list-style: decimal; }
  .blog-body :global(.post-learn ul) { list-style: none; padding: 0; }
  .blog-body :global(p.lead) {
    font-size: 1.3rem;
    line-height: 1.6;
  }
  .blog-body :global(.post-learn) {
    margin: 36px 0;
  }
  .blog-body :global(.post-learn-title) {
    font-family: 'Playfair Display', Georgia, serif;
    font-style: italic;
    font-weight: 700;
    font-size: clamp(1.9rem, 4vw, 2.4rem);
    line-height: 1.15;
    color: #000;
    margin: 0 0 16px;
  }
  .blog-body :global(.post-learn ul) {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .blog-body :global(.post-learn li) {
    position: relative;
    padding-left: 24px;
    margin: 0 0 10px;
    font-size: 1rem;
  }
  .blog-body :global(.post-learn li::before) {
    content: '+';
    position: absolute;
    left: 0;
    color: #e040fb;
    font-weight: 700;
  }
  .blog-body :global(.post-cta) {
    background: #111;
    color: #fff;
    border-radius: 18px;
    padding: 56px 34px;
    text-align: center;
    margin: 0;
  }
  .blog-body :global(.post-cta p) {
    color: #d9d9d9;
    margin: 0 auto 24px;
    max-width: 30rem;
  }
  .blog-body :global(.post-cta .post-cta-eyebrow) {
    font-family: 'Playfair Display', Georgia, serif;
    font-style: italic;
    color: #e040fb;
    font-size: 1.4rem;
    margin: 0 auto 8px;
  }
  .blog-body :global(.post-cta .post-cta-headline) {
    font-family: 'Playfair Display', Georgia, serif;
    color: #fff;
    font-size: 1.7rem;
    font-weight: 700;
    line-height: 1.2;
    margin: 0 auto 12px;
  }
  .blog-body :global(.post-cta a) {
    display: inline-block;
    background: #e040fb;
    color: #fff;
    text-decoration: none;
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 14px 32px;
    border-radius: 50px;
    transition: transform 0.3s;
  }
  .blog-body :global(.post-cta a:hover) {
    transform: translateY(-3px);
  }
  .blog-toc ol {
    list-style: none;
    padding: 0;
    margin: 0;
    counter-reset: toc;
  }
  .blog-toc li {
    counter-increment: toc;
    margin: 0;
    padding: 6px 0;
    font-size: 1rem;
    line-height: 1.4;
    display: flex;
    gap: 12px;
  }
  .blog-toc li::before {
    content: counter(toc, decimal-leading-zero);
    font-family: 'Playfair Display', Georgia, serif;
    color: #e040fb;
    flex: none;
    width: 1.6rem;
  }
  .blog-toc li.is-sub {
    padding-left: 2.2rem;
    font-size: 0.95rem;
  }
  .blog-toc li.is-sub::before {
    content: '–';
    width: 1rem;
  }
  .blog-toc a {
    color: #111;
    text-decoration: none;
    font-weight: 600;
  }
  .blog-toc a:hover {
    color: #e040fb;
  }
</style>
